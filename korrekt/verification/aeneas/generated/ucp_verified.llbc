{"charon_version":"0.1.304","translated":{"crate_name":"ucp_verified","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::rules::expression_is_unique","crate::rules::infer_assigned_cell_from_zero_equation_with_modulus","crate::recovery_loop::run_recovery","crate::mark_unique","crate::mark_initial_unique","crate::domain_entrypoints","crate::recovery_core::merge_established_evidence","crate::recovery_core::finish_merge"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":"/home/koncz/halo2-analyzer-fork/korrekt/verification/aeneas/.tools/verify.Z1kEm4/ucp_verified.llbc","no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"arch":"X86_64","vendor":"unknown","os":"Linux","env":"Gnu","cfg_abi":"Unspecified","target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"lib.rs"},"crate_name":"ucp_verified","contents":"#![allow(dead_code, unused_imports)]\n\n// A kinyeres az eles forrasfajlokat hasznalja, nem azok masolatat.\n#[path = \"../../../src/circuit_analyzer/ucp/cell.rs\"]\npub mod cells;\npub use cells as cell;\n#[path = \"../../../src/circuit_analyzer/ucp/expr.rs\"]\npub mod expressions;\npub use expressions as expr;\n#[path = \"../../../src/circuit_analyzer/ucp/facts.rs\"]\npub mod knowledge;\npub use knowledge as facts;\n#[path = \"../../../src/circuit_analyzer/ucp/rules.rs\"]\npub mod rules;\n#[path = \"../../../src/circuit_analyzer/ucp/recovery_loop.rs\"]\npub mod recovery_loop;\n#[path = \"../../../src/circuit_analyzer/ucp/profiling.rs\"]\npub mod profiling;\n\n// A domainmodul tesztjei a teljes analyzer engine-jet igenylik; azok az eles crate-ben futnak.\n// A kinyeres valtozatlanul az eles modult hasznalja, helyettesito fuggvenytorzs nelkul.\n#[cfg(not(test))]\n#[path = \"../../../src/circuit_analyzer/ucp/value.rs\"]\npub mod domains;\n#[cfg(not(test))]\npub use domains as value;\n#[cfg(not(test))]\n#[path = \"../../../src/circuit_analyzer/ucp/recovery_core.rs\"]\npub mod recovery_core;\n\n// A Charon belepopontjai a valodi metodusokat hivjak; nem helyettesitik azok torzset.\npub fn mark_unique(facts: &mut knowledge::UcpFacts, cell: cells::CellId) -> bool {\n    facts.mark_unique(cell)\n}\n\npub fn mark_initial_unique(facts: &mut knowledge::UcpFacts, cell: cells::CellId) -> bool {\n    facts.mark_initial_unique(cell)\n}\n\n#[cfg(not(test))]\npub mod domain_entrypoints {\n    use super::{cells::CellId, domains::UcpValueFacts};\n    use num_bigint::BigInt;\n\n    pub fn complete(values: &UcpValueFacts, cell: &CellId) -> bool {\n        values.domain_is_complete(cell)\n    }\n\n    pub fn known<'a>(values: &'a UcpValueFacts, cell: &CellId) -> Option<&'a BigInt> {\n        values.known_value(cell)\n    }\n\n    pub fn hypothetical(values: &UcpValueFacts) -> UcpValueFacts {\n        values.for_hypothetical_reasoning()\n    }\n\n    pub fn bounded(value: BigInt) -> Option<BigInt> {\n        super::domains::bounded_value(value)\n    }\n\n    pub fn normalize(value: BigInt, modulus: &BigInt) -> Option<BigInt> {\n        super::domains::normalize_field_value(value, modulus)\n    }\n\n    pub(crate) fn certify(\n        values: &mut UcpValueFacts,\n        cell: &CellId,\n        samples: &std::collections::BTreeSet<BigInt>,\n        modulus: &BigInt,\n    ) -> Result<bool, super::domains::CompleteDomainError> {\n        values.try_mark_complete_from_samples(cell, samples, modulus)\n    }\n\n    pub fn merge(\n        values: &mut UcpValueFacts,\n        cell: CellId,\n        domain: super::domains::UcpValueDomain,\n    ) -> bool {\n        values.mark_domain(cell, domain)\n    }\n}\n\npub mod circuit_analyzer {\n    pub mod ucp {\n        pub use crate::{cell, profiling};\n    }\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"../../../src/circuit_analyzer/ucp/rules.rs"},"crate_name":"ucp_verified","contents":"// A K alapján ellenőrzi az egyértelműséget; konkrét értéket nem számít, és K-t nem módosítja.\n\nuse super::{\n    cell::CellId,\n    expr::{UcpExpr, UcpScalar},\n    facts::UcpFacts,\n};\nuse num_bigint::BigInt;\n\n// A QED² kifejezésszintű egyértelműségi szabályait alkalmazza.\n//A true igazolt egyértelműséget jelent; a false csak azt, hogy ezek a szabályok nem igazolták.\npub fn expression_is_unique(expr: &UcpExpr, facts: &UcpFacts) -> bool {\n    match expr {\n        // A változót akkor tekinti egyértelműnek, ha szerepel K-ban.\n        UcpExpr::Var(cell) => facts.is_unique(cell),\n        //A konstans értéke rögzített, akkor is, ha az elemző a konkrét számát nem ismeri.\n        UcpExpr::Const(_) => true,\n        // Negálásnál megőrzi a belső kifejezés egyértelműségét.\n        UcpExpr::Neg(inner) => expression_is_unique(inner, facts),\n        // Nullával skálázásnál egyértelműséget jelez; máskor a belső kifejezést vizsgálja.\n        UcpExpr::Scale(inner, scalar) => match scalar {\n            UcpScalar::Zero => true,\n            UcpScalar::Known(value) if value == &BigInt::from(0) => true,\n            UcpScalar::NonZero | UcpScalar::Unknown | UcpScalar::Known(_) => {\n                expression_is_unique(inner, facts)\n            }\n        },\n        // Összegnél mindkét oldal egyértelműségét megköveteli.\n        UcpExpr::Add(left, right) => {\n            expression_is_unique(left, facts) && expression_is_unique(right, facts)\n        }\n        // Szorzatnál nullatényező vagy két egyértelmű tényező esetén jelez egyértelműséget.\n        UcpExpr::Mul(left, right) => {\n            is_zero_constant(left)\n                || is_zero_constant(right)\n                || (expression_is_unique(left, facts) && expression_is_unique(right, facts))\n        }\n    }\n}\n\n// Az Assign szabállyal egy nullával egyenlő kifejezés egyetlen ismeretlen celláját keresi.\n//A hívó adja a premisszát, hogy expr = 0 kényszer. A visszaadott cellát az engine teheti K-ba.\npub fn infer_assigned_cell_from_zero_equation(expr: &UcpExpr, facts: &UcpFacts) -> Option<CellId> {\n    infer_assigned_cell_with_optional_modulus(expr, facts, None)\n}\n\npub fn infer_assigned_cell_from_zero_equation_with_modulus(\n    expr: &UcpExpr,\n    facts: &UcpFacts,\n    modulus: &BigInt,\n) -> Option<CellId> {\n    if modulus <= &BigInt::from(1) {\n        return None;\n    }\n    infer_assigned_cell_with_optional_modulus(expr, facts, Some(modulus))\n}\n\nfn infer_assigned_cell_with_optional_modulus(\n    expr: &UcpExpr,\n    facts: &UcpFacts,\n    modulus: Option<&BigInt>,\n) -> Option<CellId> {\n    let analysis = analyze_assign_candidate(expr, facts, modulus);\n\n    if analysis.valid {\n        analysis.candidate\n    } else {\n        None\n    }\n}\n\n// Az Assign-elemzés érvényességét és esetleges jelöltcelláját tárolja.\n//candidate=None, valid=true: nincs új cella; valid=false: a minta nem kezelhető biztonságosan.\n#[derive(Clone, Debug, Eq, PartialEq)]\nstruct AssignAnalysis {\n    candidate: Option<CellId>,\n    valid: bool,\n}\n\nimpl AssignAnalysis {\n    // Új jelölt nélküli, érvényes elemzési eredményt készít.\n    fn none() -> Self {\n        Self {\n            candidate: None,\n            valid: true,\n        }\n    }\n\n    // Pontosan egy jelöltcellát rögzítő eredményt készít.\n    fn candidate(cell: CellId) -> Self {\n        Self {\n            candidate: Some(cell),\n            valid: true,\n        }\n    }\n\n    // Érvénytelen mintát jelez, amelyből nem következtet.\n    fn invalid() -> Self {\n        Self {\n            candidate: None,\n            valid: false,\n        }\n    }\n\n    // Összeadásnál egyesíti a két oldal Assign-elemzését.\n    fn merge_add(self, other: Self) -> Self {\n        if !self.valid || !other.valid {\n            return Self::invalid();\n        }\n\n        match (self.candidate, other.candidate) {\n            // Új jelölt nélküli eredményt ad, ha egyik oldal sem tartalmaz ismeretlent.\n            (None, None) => Self::none(),\n            // Megtartja az egyetlen jelöltet, ha csak az egyik oldalon talál ilyet.\n            (Some(cell), None) | (None, Some(cell)) => Self::candidate(cell),\n            // Két jelöltelőfordulást nem von össze, akkor sem, ha ugyanaz a cella szerepel kétszer.\n            (Some(_), Some(_)) => Self::invalid(),\n        }\n    }\n}\n\n// A kifejezésben egyetlen lineáris ismeretlen cellát keres.\nfn analyze_assign_candidate(\n    expr: &UcpExpr,\n    facts: &UcpFacts,\n    modulus: Option<&BigInt>,\n) -> AssignAnalysis {\n    // Az egészében egyértelmű kifejezésből nem keres új jelöltet.\n    //Például a*x + e = 0 alakban e lehet egyértelmű konkrétan ismert érték nélkül is.\n    if expression_is_unique(expr, facts) {\n        return AssignAnalysis::none();\n    }\n\n    match expr {\n        // A nem igazoltan egyértelmű változót jelöltként kezeli.\n        UcpExpr::Var(cell) => AssignAnalysis::candidate(cell.clone()),\n        // Konstansból nem képez jelöltet.\n        UcpExpr::Const(_) => AssignAnalysis::none(),\n        // Negálásnál a belső jelöltet tartja meg.\n        UcpExpr::Neg(inner) => analyze_assign_candidate(inner, facts, modulus),\n        //Skálázásnál csak biztosan nem nulla skála mellett lehet továbbmenni\n        UcpExpr::Scale(inner, scalar) => {\n            if scalar.is_non_zero_with_modulus(modulus) {\n                analyze_assign_candidate(inner, facts, modulus)\n            } else if matches!(scalar, UcpScalar::Unknown) {\n                AssignAnalysis::invalid()\n            } else {\n                AssignAnalysis::none()\n            }\n        }\n        // Összeadásnál egyesíti a két oldal jelöltjeit.\n        UcpExpr::Add(left, right) => analyze_assign_candidate(left, facts, modulus)\n            .merge_add(analyze_assign_candidate(right, facts, modulus)),\n        // Szorzásnál csak a biztonságosan visszafordítható esetekből következtet.\n        UcpExpr::Mul(left, right) => analyze_product_assign_candidate(left, right, facts, modulus),\n    }\n}\n\n// Szorzatból próbál Assign-jelöltet kinyerni.\nfn analyze_product_assign_candidate(\n    left: &UcpExpr,\n    right: &UcpExpr,\n    facts: &UcpFacts,\n    modulus: Option<&BigInt>,\n) -> AssignAnalysis {\n    //Ha valamelyik oldal nulla, a szorzatból nincs új információ\n    if is_zero_constant(left) || is_zero_constant(right) {\n        return AssignAnalysis::none();\n    }\n\n    // Két egyértelmű tényezőből nem keres új jelöltet.\n    if expression_is_unique(left, facts) && expression_is_unique(right, facts) {\n        return AssignAnalysis::none();\n    }\n\n    //Biztosan nem nulla konstanssal a szorzás visszafordítható; a modulusos vizsgálat is szükséges.\n    if is_non_zero_constant(left, modulus) {\n        return analyze_assign_candidate(right, facts, modulus);\n    }\n\n    // Nemnulla konstans tényező mellett a másik oldal jelöltjét vizsgálja.\n    if is_non_zero_constant(right, modulus) {\n        return analyze_assign_candidate(left, facts, modulus);\n    }\n\n    //A K-tagság önmagában nem garantál nemnullaságot: egy egyértelmű szorzó értéke lehet nulla.\n    AssignAnalysis::invalid()\n}\n\n// Ellenőrzi, hogy a kifejezés biztosan nulla konstans-e.\nfn is_zero_constant(expr: &UcpExpr) -> bool {\n    matches!(expr, UcpExpr::Const(scalar) if scalar.is_zero())\n}\n\n// Ellenőrzi, hogy a kifejezés biztosan nemnulla konstans-e.\nfn is_non_zero_constant(expr: &UcpExpr, modulus: Option<&BigInt>) -> bool {\n    matches!(expr, UcpExpr::Const(scalar) if scalar.is_non_zero_with_modulus(modulus))\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use crate::circuit_analyzer::ucp::cell::CellId;\n\n    // A teszt ellenőrzi, hogy a konstanskifejezést egyértelműnek tekinti.\n    #[test]\n    fn const_rule_marks_constants_unique() {\n        let facts = UcpFacts::new();\n\n        assert!(expression_is_unique(&UcpExpr::constant(), &facts));\n    }\n\n    // A teszt ellenőrzi, hogy a változót csak K-tagság mellett tekinti egyértelműnek.\n    #[test]\n    fn var_rule_uses_known_unique_cells() {\n        let known = CellId::advice(0, 3);\n        let unknown = CellId::advice(1, 3);\n        let facts = UcpFacts::from_iter([known.clone()]);\n\n        assert!(expression_is_unique(&UcpExpr::var(known), &facts));\n        assert!(!expression_is_unique(&UcpExpr::var(unknown), &facts));\n    }\n\n    // A teszt ellenőrzi az egyértelmű operandusokból történő következtetést.\n    #[test]\n    fn op_rule_requires_all_operands_to_be_unique() {\n        let x = CellId::advice(0, 0);\n        let y = CellId::advice(1, 0);\n        let facts = UcpFacts::from_iter([x.clone()]);\n\n        let unique_expr = UcpExpr::add(UcpExpr::var(x), UcpExpr::constant());\n        let non_unique_expr = UcpExpr::mul(unique_expr.clone(), UcpExpr::var(y));\n\n        assert!(expression_is_unique(&unique_expr, &facts));\n        assert!(!expression_is_unique(&non_unique_expr, &facts));\n    }\n\n    // A teszt ellenőrzi, hogy nullatényező mellett a szorzatot egyértelműnek tekinti.\n    #[test]\n    fn zero_product_is_unique() {\n        let x = CellId::advice(0, 0);\n        let facts = UcpFacts::new();\n        let expr = UcpExpr::mul(UcpExpr::zero(), UcpExpr::var(x));\n\n        assert!(expression_is_unique(&expr, &facts));\n    }\n\n    // A teszt ellenőrzi, hogy a negálás és a nemnulla skálázás megőrzi az egyértelműséget.\n    #[test]\n    fn unary_ops_preserve_uniqueness() {\n        let x = CellId::instance(0, 0);\n        let facts = UcpFacts::from_iter([x.clone()]);\n        let expr = UcpExpr::neg(UcpExpr::scale(UcpExpr::var(x)));\n\n        assert!(expression_is_unique(&expr, &facts));\n    }\n\n    // A teszt ellenőrzi az egyetlen lineáris ismeretlen kikövetkeztetését az Assign szabállyal.\n    #[test]\n    fn assign_rule_infers_single_linear_unknown() {\n        let public = CellId::instance(0, 0);\n        let advice = CellId::advice(0, 0);\n        let facts = UcpFacts::from_iter([public.clone()]);\n        let expr = UcpExpr::add(\n            UcpExpr::scale_by(UcpExpr::var(advice.clone()), UcpScalar::NonZero),\n            UcpExpr::var(public),\n        );\n\n        assert_eq!(\n            infer_assigned_cell_from_zero_equation(&expr, &facts),\n            Some(advice)\n        );\n    }\n\n    // A teszt ellenőrzi, hogy ismeretlen skálánál az Assign szabály nem következtet.\n    #[test]\n    fn assign_rule_rejects_unknown_scalar() {\n        let advice = CellId::advice(0, 0);\n        let facts = UcpFacts::new();\n        let expr = UcpExpr::scale_by(UcpExpr::var(advice), UcpScalar::Unknown);\n\n        assert_eq!(infer_assigned_cell_from_zero_equation(&expr, &facts), None);\n    }\n\n    // A teszt ellenőrzi, hogy több ismeretlen esetén az Assign szabály nem ad jelöltet.\n    #[test]\n    fn assign_rule_rejects_multiple_unknowns() {\n        let x = CellId::advice(0, 0);\n        let y = CellId::advice(1, 0);\n        let facts = UcpFacts::new();\n        let expr = UcpExpr::add(UcpExpr::var(x), UcpExpr::var(y));\n\n        assert_eq!(infer_assigned_cell_from_zero_equation(&expr, &facts), None);\n    }\n}\n"},{"id":6,"name":{"Local":"../../../src/circuit_analyzer/ucp/recovery_loop.rs"},"crate_name":"ucp_verified","contents":"//! A tenyleges recovery fociklus fuggosegmentes vezerlese.\n//! A muveleteket az eles adapter hajtja vegre; a sorrendet es az ujrainditast ez a modul donti el.\n\npub(crate) enum Selection<Action, Stop> {\n    Run(Action),\n    Stop(Stop),\n}\n\n// A tulajdonjog atadasa mozgatja az allapotot; nem masolja a domaineket vagy a solvert.\npub(crate) trait RecoveryMachine: Sized {\n    type Action;\n    type Pending;\n    type Stop;\n    type Error;\n\n    fn propagate(self) -> Result<(Self, bool), Self::Error>;\n    fn refresh(self) -> Result<Self, Self::Error>;\n    fn select(self) -> Result<(Self, Selection<Self::Action, Self::Stop>), Self::Error>;\n    fn query(self, action: Self::Action) -> Result<(Self, Self::Pending), Self::Error>;\n    fn merge(self, pending: Self::Pending) -> Result<(Self, bool), Self::Error>;\n}\n\n// A kanonizalas uj domainte csak valodi valtozasnal ker meg egy propagacios kort.\nfn propagate_until_stable<M: RecoveryMachine>(mut machine: M) -> Result<M, M::Error> {\n    loop {\n        let (next, repeat) = machine.propagate()?;\n        machine = next;\n        if !repeat {\n            return machine.refresh();\n        }\n    }\n}\n\n// Nem jelol sikeresnek hibas muveletet, es minden keresesi eredmenyt beolvaszt a kovetkezo valasztas elott.\npub(crate) fn run_recovery<M: RecoveryMachine>(mut machine: M) -> Result<(M::Stop, M), M::Error> {\n    let mut propagation_needed = true;\n    loop {\n        if propagation_needed {\n            machine = propagate_until_stable(machine)?;\n        }\n        let (next, selection) = machine.select()?;\n        machine = next;\n        match selection {\n            Selection::Stop(status) => return Ok((status, machine)),\n            Selection::Run(action) => {\n                let (next, pending) = machine.query(action)?;\n                let (next, changed) = next.merge(pending)?;\n                machine = next;\n                propagation_needed = changed;\n            }\n        }\n    }\n}\n\n#[cfg(test)]\n#[path = \"tests/recovery_loop_tests.rs\"]\nmod tests;\n"},{"id":7,"name":{"Local":"../../../src/circuit_analyzer/ucp/recovery_core.rs"},"crate_name":"ucp_verified","contents":"//! A recovery bizonyitekainak szemantikai allapotatmenetei, solver- es riportfuggoseg nelkul.\n//! Az eles adapter ezeket hivja; a Charon/Aeneas ugyanezt a kodot nyeri ki.\n\nuse super::{\n    cell::CellId,\n    facts::UcpFacts,\n    value::{normalize_field_value, CompleteDomainError, UcpValueDomain, UcpValueFacts},\n};\nuse num_bigint::BigInt;\nuse std::collections::{BTreeMap, BTreeSet, HashSet};\n\n// A W halmaz: az eredeti kontextus kielegito ertekadasaibol szarmazo normalizalt mintak.\n#[derive(Default)]\npub(crate) struct RecoveryEvidence {\n    pub(super) feasible: BTreeMap<CellId, BTreeSet<BigInt>>,\n}\n\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\npub(crate) struct UnsupportedSample;\n\n#[derive(Clone, Debug, Eq, PartialEq)]\npub(crate) enum CertificationError {\n    UniqueWithSamples(CellId),\n    Domain(CellId, CompleteDomainError),\n}\n\nimpl RecoveryEvidence {\n    pub(crate) fn try_remember_sample(\n        &mut self,\n        cell: &CellId,\n        sample: BigInt,\n        modulus: &BigInt,\n    ) -> Result<(), UnsupportedSample> {\n        let value = normalize_field_value(sample, modulus).ok_or(UnsupportedSample)?;\n        self.feasible.entry(cell.clone()).or_default().insert(value);\n        Ok(())\n    }\n\n    fn try_remember_list(\n        &mut self,\n        cell: &CellId,\n        samples: Vec<BigInt>,\n        modulus: &BigInt,\n    ) -> Result<(), UnsupportedSample> {\n        for sample in samples {\n            self.try_remember_sample(cell, sample, modulus)?;\n        }\n        Ok(())\n    }\n\n    fn try_remember_model(\n        &mut self,\n        models: &BTreeMap<CellId, BTreeSet<BigInt>>,\n        modulus: &BigInt,\n    ) -> Result<(), UnsupportedSample> {\n        for (cell, values) in models {\n            let samples: Vec<BigInt> = values.iter().map(|value| value.clone()).collect();\n            self.try_remember_list(cell, samples, modulus)?;\n        }\n        Ok(())\n    }\n\n    /// Csak a teljessegi jelolest frissitve nem ker uj UCP-kort.\n    /// Ha a testbeli azonositas tobb jeloltet egyetlen ertekre von ossze, uj propagaciot ker.\n    pub(crate) fn try_certify_complete_domains(\n        &self,\n        facts: &UcpFacts,\n        values: &mut UcpValueFacts,\n        modulus: &BigInt,\n    ) -> Result<bool, CertificationError> {\n        let mut exact_added = false;\n        for (cell, samples) in &self.feasible {\n            if samples.len() >= 2 && facts.is_unique(cell) {\n                return Err(CertificationError::UniqueWithSamples(cell.clone()));\n            }\n            let was_exact = values.known_value(cell).is_some();\n            if let Err(error) = values.try_mark_complete_from_samples(cell, samples, modulus) {\n                return Err(CertificationError::Domain(cell.clone(), error));\n            }\n            if !was_exact && values.known_value(cell).is_some() {\n                exact_added = true;\n            }\n        }\n        Ok(exact_added)\n    }\n\n    // Ket kulonbozo teljes modellertek domainlefedes nelkul is bizonyitja a nemegyertelmuseget.\n    pub(crate) fn record_non_unique_cells(&self, non_unique: &mut HashSet<CellId>) {\n        for (cell, samples) in &self.feasible {\n            if samples.len() >= 2 {\n                non_unique.insert(cell.clone());\n            }\n        }\n    }\n}\n\n// Egy keresesi lepes igazolt eredmenye, nyomkoveto adatok nelkul.\npub(crate) struct EstablishedEvidence {\n    pub(crate) cell: CellId,\n    pub(crate) samples: Vec<BigInt>,\n    pub(crate) model_samples: BTreeMap<CellId, BTreeSet<BigInt>>,\n    pub(crate) domain: Option<UcpValueDomain>,\n    pub(crate) unique: bool,\n    pub(crate) non_unique: bool,\n}\n\n// Csak igazolt kovetkeztetest olvaszt be. A megvalosithato mintakat kulon W-ben orzi meg;\n// onmagaban egy modellertek nem jogosit lefedo domain vagy egyertelmuseg bejegyzesere.\npub(crate) fn merge_established_evidence(\n    evidence: &mut RecoveryEvidence,\n    facts: &mut UcpFacts,\n    values: &mut UcpValueFacts,\n    non_unique: &mut HashSet<CellId>,\n    established: EstablishedEvidence,\n    modulus: &BigInt,\n) -> Result<bool, UnsupportedSample> {\n    let EstablishedEvidence {\n        cell,\n        samples,\n        model_samples,\n        domain,\n        unique,\n        non_unique: is_non_unique,\n    } = established;\n    evidence.try_remember_list(&cell, samples, modulus)?;\n    evidence.try_remember_model(&model_samples, modulus)?;\n    let mut changed = false;\n    if unique {\n        changed = facts.mark_unique(cell.clone());\n    }\n    if let Some(domain) = domain {\n        if values.mark_domain(cell.clone(), domain) {\n            changed = true;\n        }\n    }\n    if is_non_unique {\n        non_unique.insert(cell);\n    }\n    Ok(changed)\n}\n\n// A beolvasztas zaro lepese: teljesseget igazol, majd a mintakbol non-unique cimket kepez.\npub(crate) fn finish_merge(\n    evidence: &RecoveryEvidence,\n    facts: &UcpFacts,\n    values: &mut UcpValueFacts,\n    non_unique: &mut HashSet<CellId>,\n    modulus: &BigInt,\n) -> Result<bool, CertificationError> {\n    let exact_added = evidence.try_certify_complete_domains(facts, values, modulus)?;\n    evidence.record_non_unique_cells(non_unique);\n    Ok(exact_added)\n}\n"},{"id":8,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"../../../src/circuit_analyzer/ucp/expr.rs"},"crate_name":"ucp_verified","contents":"//Kifejezésfák és skalártulajdonságok; a kiértékelés és a következtetés más modulok feladata.\n\nuse super::cell::CellId;\nuse num_bigint::BigInt;\n\n//Skalár/konstans érték absztrakt reprezentációja UCP-hez\n//A NonZero csak tulajdonságot közöl, a Known konkrét számot is. Ez nem celladomain.\n#[derive(Clone, Debug, Eq, PartialEq)]\npub enum UcpScalar {\n    //Biztosan nulla érték\n    Zero,\n    //Biztosan nem nulla, de a konkrét érték nem ismert\n    NonZero,\n    // A rendszer nem ismeri a skalár nulla vagy nemnulla voltát.\n    Unknown,\n    //Konkrétan ismert BigInt érték\n    Known(BigInt),\n}\n\nimpl UcpScalar {\n    //Konkrét értékből UcpScalar-t készít, a nullát külön Zero-ként tárolva\n    //Itt még nincs testmodulus\n    pub fn known(value: BigInt) -> Self {\n        if value == BigInt::from(0) {\n            Self::Zero\n        } else {\n            Self::Known(value)\n        }\n    }\n\n    //Kényelmi függvény i64 értékből ismert skalár létrehozására\n    pub fn known_i64(value: i64) -> Self {\n        Self::known(BigInt::from(value))\n    }\n\n    //Visszaadja a konkrét értéket, ha ténylegesen ismert\n    //A None nem nullát jelent, hanem azt, hogy nincs kiolvasható konkrét szám.\n    pub fn as_known(&self) -> Option<BigInt> {\n        match self {\n            Self::Zero => Some(BigInt::from(0)),\n            Self::Known(value) => Some(value.clone()),\n            Self::NonZero | Self::Unknown => None,\n        }\n    }\n\n    //Azt jelzi, hogy a skalár statikusan biztosan nem nulla-e\n    //A Known értékét egész számként vizsgálja; testbeli egyszerűsítéshez a modulusos változat kell.\n    pub fn is_statically_non_zero(&self) -> bool {\n        match self {\n            Self::NonZero => true,\n            Self::Known(value) => value != &BigInt::from(0),\n            Self::Zero | Self::Unknown => false,\n        }\n    }\n\n    pub(crate) fn is_zero(&self) -> bool {\n        matches!(self, Self::Zero)\n            || matches!(self, Self::Known(value) if value == &BigInt::from(0))\n    }\n\n    //Known(p)-vel nem szabad osztani a p modulusú testben, mert ott az értéke nulla.\n    pub(crate) fn is_non_zero_with_modulus(&self, modulus: Option<&BigInt>) -> bool {\n        match (self, modulus) {\n            (Self::Known(value), Some(modulus)) => {\n                modulus > &BigInt::from(1) && value % modulus != BigInt::from(0)\n            }\n            _ => self.is_statically_non_zero(),\n        }\n    }\n}\n\n// A Halo2-kifejezéseket egyszerű UCP-kifejezésfával reprezentálja.\n//A Box miatt a csomópont tárolhat újabb UcpExpr-t anélkül, hogy a típus mérete végtelen lenne.\n//Például 2*x + y egy Add csomópont, benne egy skálázott Var(x) és egy Var(y).\n#[derive(Clone, Debug, Eq, PartialEq)]\npub enum UcpExpr {\n    //Cella/változó hivatkozás\n    Var(CellId),\n    //Konstans vagy absztrakt skalár érték\n    Const(UcpScalar),\n    // A belső kifejezés negáltját jelöli.\n    Neg(Box<UcpExpr>),\n    //Összeadás\n    Add(Box<UcpExpr>, Box<UcpExpr>),\n    //Szorzás\n    Mul(Box<UcpExpr>, Box<UcpExpr>),\n    //A Mul két részfát szoroz; a Scale külön kezeli a skalár együtthatót.\n    Scale(Box<UcpExpr>, UcpScalar),\n}\n\nimpl UcpExpr {\n    //Az építőfüggvények csak helyi azonosságokat egyszerűsítenek, nem oldanak meg egyenleteket.\n    // Cellahivatkozásból változókifejezést készít.\n    pub fn var(cell: CellId) -> Self {\n        Self::Var(cell)\n    }\n\n    //Ismeretlen értékű konstans, nem új advice változó.\n    pub fn constant() -> Self {\n        Self::Const(UcpScalar::Unknown)\n    }\n\n    // Nulla értékű konstanscsomópontot készít.\n    pub fn zero() -> Self {\n        Self::Const(UcpScalar::Zero)\n    }\n\n    // Nemnulla, de konkrétan ismeretlen konstanscsomópontot készít.\n    pub fn non_zero_constant() -> Self {\n        Self::Const(UcpScalar::NonZero)\n    }\n\n    // Konkrét ismert értékből konstanscsomópontot készít.\n    pub fn known_constant(value: BigInt) -> Self {\n        Self::Const(UcpScalar::known(value))\n    }\n\n    // i64 értékből konstanscsomópontot készít.\n    pub fn known_constant_i64(value: i64) -> Self {\n        Self::known_constant(BigInt::from(value))\n    }\n\n    // Tetszőleges UcpScalar értékből konstanskifejezést készít.\n    pub fn scalar_constant(scalar: UcpScalar) -> Self {\n        if scalar.is_zero() {\n            Self::zero()\n        } else {\n            Self::Const(scalar)\n        }\n    }\n\n    // A megadott kifejezés negáltját készíti el.\n    pub fn neg(expr: UcpExpr) -> Self {\n        match expr {\n            Self::Const(UcpScalar::Zero) => Self::zero(),\n            expr => Self::Neg(Box::new(expr)),\n        }\n    }\n\n    // Két kifejezés összegét készíti el.\n    pub fn add(left: UcpExpr, right: UcpExpr) -> Self {\n        match (left, right) {\n            (Self::Const(UcpScalar::Zero), right) => right,\n            (left, Self::Const(UcpScalar::Zero)) => left,\n            (left, right) => Self::Add(Box::new(left), Box::new(right)),\n        }\n    }\n\n    // Két kifejezés szorzatát készíti el.\n    //A 0*e, 1*e és (-1)*e alakokat rögtön rövidebb fára cseréli; más szorzatot megtart.\n    pub fn mul(left: UcpExpr, right: UcpExpr) -> Self {\n        match (left, right) {\n            (Self::Const(UcpScalar::Zero), _) | (_, Self::Const(UcpScalar::Zero)) => Self::zero(),\n            (Self::Const(UcpScalar::Known(value)), expr) if value == BigInt::from(1) => expr,\n            (expr, Self::Const(UcpScalar::Known(value))) if value == BigInt::from(1) => expr,\n            (Self::Const(UcpScalar::Known(value)), expr) if value == BigInt::from(-1) => {\n                Self::neg(expr)\n            }\n            (expr, Self::Const(UcpScalar::Known(value))) if value == BigInt::from(-1) => {\n                Self::neg(expr)\n            }\n            (left, right) => Self::Mul(Box::new(left), Box::new(right)),\n        }\n    }\n\n    //Nem nulla, de konkrétan nem ismert skálával szoroz\n    //Ez nem egységgel szorzás: a tényleges együttható ismeretlen marad.\n    pub fn scale(expr: UcpExpr) -> Self {\n        Self::scale_by(expr, UcpScalar::NonZero)\n    }\n\n    // Skálázott kifejezést készít; nulla együtthatónál azonnal nullára egyszerűsít.\n    pub fn scale_by(expr: UcpExpr, scalar: UcpScalar) -> Self {\n        if scalar.is_zero() {\n            return Self::zero();\n        }\n        match scalar {\n            UcpScalar::Zero => Self::zero(),\n            UcpScalar::Known(value) if value == BigInt::from(1) => expr,\n            UcpScalar::Known(value) if value == BigInt::from(-1) => Self::neg(expr),\n            UcpScalar::NonZero | UcpScalar::Unknown | UcpScalar::Known(_) => {\n                Self::Scale(Box::new(expr), scalar)\n            }\n        }\n    }\n}\n"},{"id":13,"name":{"Local":"../../../src/circuit_analyzer/ucp/facts.rs"},"crate_name":"ucp_verified","contents":"use super::{\n    cell::{CellId, CellKind},\n    expr::UcpExpr,\n};\nuse std::collections::HashSet;\n\n// A dolgozatbeli K halmazban az igazoltan egyértelmű cellákat tárolja.\n#[derive(Clone, Debug, Default, Eq, PartialEq)]\npub struct UcpFacts {\n    unique_cells: HashSet<CellId>,\n}\n\nimpl UcpFacts {\n    // Üres K halmazt hoz létre.\n    pub fn new() -> Self {\n        Self::default()\n    }\n\n    // A cellát egyértelműként jelöli; új elem bejegyzésekor igazat ad vissza.\n    pub fn mark_unique(&mut self, cell: CellId) -> bool {\n        self.unique_cells.insert(cell)\n    }\n\n    //Kezdeti K-ba csak instance és fixed cella kerülhet, advice-ot bizonyítani kell\n    pub fn mark_initial_unique(&mut self, cell: CellId) -> bool {\n        match cell.kind {\n            CellKind::Instance | CellKind::Fixed => self.mark_unique(cell),\n            CellKind::Advice => false,\n        }\n    }\n\n    //Ellenőrzi, hogy egy cella szerepel-e a K halmazban\n    pub fn is_unique(&self, cell: &CellId) -> bool {\n        self.unique_cells.contains(cell)\n    }\n\n    // Visszaadja az összes igazoltan egyértelmű cellát.\n    pub fn unique_cells(&self) -> &HashSet<CellId> {\n        &self.unique_cells\n    }\n}\n\n//Instance és fixed cellákból létrehozza a kezdeti K halmazt\npub fn initial_facts<I, F>(instance_cells: I, fixed_cells: F) -> UcpFacts\nwhere\n    I: IntoIterator<Item = CellId>,\n    F: IntoIterator<Item = CellId>,\n{\n    let mut facts = UcpFacts::new();\n\n    for cell in instance_cells {\n        facts.mark_initial_unique(cell);\n    }\n\n    for cell in fixed_cells {\n        facts.mark_initial_unique(cell);\n    }\n\n    facts\n}\n\n// A kifejezésekből kigyűjti a kezdeti K-ba felvehető instance és fixed cellákat.\npub fn initial_facts_from_expressions<'a, I>(expressions: I) -> UcpFacts\nwhere\n    I: IntoIterator<Item = &'a UcpExpr>,\n{\n    let mut facts = UcpFacts::new();\n\n    for expr in expressions {\n        collect_initial_facts(expr, &mut facts);\n    }\n\n    facts\n}\n\n// Rekurzívan bejárja a kifejezést, és csak a kezdetben egyértelmű cellákat gyűjti ki.\nfn collect_initial_facts(expr: &UcpExpr, facts: &mut UcpFacts) {\n    match expr {\n        UcpExpr::Var(cell) => {\n            facts.mark_initial_unique(cell.clone());\n        }\n        UcpExpr::Const(_) => {}\n        UcpExpr::Neg(inner) | UcpExpr::Scale(inner, _) => collect_initial_facts(inner, facts),\n        UcpExpr::Add(left, right) | UcpExpr::Mul(left, right) => {\n            collect_initial_facts(left, facts);\n            collect_initial_facts(right, facts);\n        }\n    }\n}\n\n//Lehetővé teszi, hogy cellalistából közvetlenül UcpFacts készüljön\nimpl FromIterator<CellId> for UcpFacts {\n    fn from_iter<T: IntoIterator<Item = CellId>>(iter: T) -> Self {\n        Self {\n            unique_cells: HashSet::from_iter(iter),\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    //Azt ellenőrzi, hogy az instance és fixed cellák bekerülnek a kezdeti K halmazba\n    #[test]\n    fn initial_facts_include_instance_and_fixed_cells() {\n        let instance = CellId::instance(0, 0);\n        let fixed = CellId::fixed(1, 2);\n\n        let facts = initial_facts([instance.clone()], [fixed.clone()]);\n\n        assert!(facts.is_unique(&instance));\n        assert!(facts.is_unique(&fixed));\n        assert_eq!(facts.unique_cells().len(), 2);\n    }\n\n    //Azt ellenőrzi, hogy advice cella nem kerül be automatikusan a kezdeti K-ba\n    #[test]\n    fn initial_facts_ignore_advice_cells() {\n        let advice = CellId::advice(0, 0);\n        let fixed = CellId::fixed(0, 0);\n\n        let facts = initial_facts([advice.clone()], [fixed.clone()]);\n\n        assert!(!facts.is_unique(&advice));\n        assert!(facts.is_unique(&fixed));\n        assert_eq!(facts.unique_cells().len(), 1);\n    }\n\n    // A teszt ellenőrzi, hogy a kifejezésekből csak instance és fixed cellát vesz fel kezdeti tényként.\n    #[test]\n    fn initial_facts_from_expressions_collect_instance_and_fixed_only() {\n        let instance = CellId::instance(0, 0);\n        let fixed = CellId::fixed(1, 0);\n        let advice = CellId::advice(2, 0);\n        let expressions = vec![UcpExpr::add(\n            UcpExpr::var(instance.clone()),\n            UcpExpr::mul(UcpExpr::var(fixed.clone()), UcpExpr::var(advice.clone())),\n        )];\n\n        let facts = initial_facts_from_expressions(&expressions);\n\n        assert!(facts.is_unique(&instance));\n        assert!(facts.is_unique(&fixed));\n        assert!(!facts.is_unique(&advice));\n        assert_eq!(facts.unique_cells().len(), 2);\n    }\n}\n"},{"id":14,"name":{"Local":"../../../src/circuit_analyzer/ucp/cell.rs"},"crate_name":"ucp_verified","contents":"// A cellákat az értéküktől függetlenül azonosítja.\n\nuse std::fmt;\n\n//A Halo2 cella típusát jelöli\n#[derive(Clone, Debug, Eq, Hash, Ord, PartialEq, PartialOrd)]\npub enum CellKind {\n    // Az advice cellát jelöli; a szintézisben hozzárendelt privát értéket nem tekinti elemzési ténynek.\n    Advice,\n    //Publikus megfigyelés helye: bemenet, kimenet vagy publikált köztes eredmény is lehet.\n    Instance,\n    // A kapcsolás rögzített oszlopát jelöli; a ténylegesen hozzárendelt értéket nyilvános konstansként kezeli.\n    Fixed,\n}\n\n//Egy konkrét cella azonosítója: típus, oszlop és sor\n//Az Eq/Hash a teljes hármast használja, az Ord determinisztikus rendezést ad a tárolókban.\n#[derive(Clone, Debug, Eq, Hash, Ord, PartialEq, PartialOrd)]\npub struct CellId {\n    pub kind: CellKind,\n    pub column: usize,\n    //A rotáció feloldását és a sortartományra normalizálást nem ez a típus végzi.\n    pub row: i32,\n}\n\nimpl CellId {\n    //Csak azonosítót készít: nem foglal Halo2-oszlopot és nem rendel cellaértéket.\n    pub fn advice(column: usize, row: i32) -> Self {\n        Self {\n            kind: CellKind::Advice,\n            column,\n            row,\n        }\n    }\n\n    //Instance cella azonosítója\n    pub fn instance(column: usize, row: i32) -> Self {\n        Self {\n            kind: CellKind::Instance,\n            column,\n            row,\n        }\n    }\n\n    //Fixed cella azonosítója\n    pub fn fixed(column: usize, row: i32) -> Self {\n        Self {\n            kind: CellKind::Fixed,\n            column,\n            row,\n        }\n    }\n}\n\nimpl fmt::Display for CellId {\n    //Olvasható pozíciójelölés: A-0-0, I-0-0 vagy F-0-0; nem a tárolt érték.\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        let prefix = match self.kind {\n            CellKind::Advice => \"A\",\n            CellKind::Instance => \"I\",\n            CellKind::Fixed => \"F\",\n        };\n        write!(f, \"{}-{}-{}\", prefix, self.column, self.row)\n    }\n}\n"},{"id":15,"name":{"Local":"/rustc/library/alloc/src/boxed.rs"},"crate_name":"alloc","contents":null},{"id":16,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":17,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":18,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/num-bigint-0.4.6/src/bigint.rs"},"crate_name":"num_bigint","contents":null},{"id":19,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/num-bigint-0.4.6/src/lib.rs"},"crate_name":"num_bigint","contents":null},{"id":20,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/num-bigint-0.4.6/src/bigint/convert.rs"},"crate_name":"num_bigint","contents":null},{"id":21,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":22,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":23,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":24,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":25,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null},{"id":26,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":27,"name":{"Local":"../../../src/circuit_analyzer/ucp/value.rs"},"crate_name":"ucp_verified","contents":"//Delta: lefedő domainek tárolása és kifejezések kiértékelése.\n//Az új tényeket levezető algoritmusok a value_inference.rs fájlban találhatók.\n//Az alábbi ábrahivatkozások a QED²-cikkre utalnak; az ábraszámok még ellenőrizendők.\n\nuse super::{\n    cell::CellId,\n    expr::{UcpExpr, UcpScalar},\n};\nuse anyhow::Result;\nuse num_bigint::BigInt;\nuse std::collections::{BTreeMap, BTreeSet, HashMap, HashSet};\n\n// A következtető függvényeket a value modul elérési útján exportálja.\n#[path = \"value_inference.rs\"]\nmod inference;\npub(crate) use inference::LinearDomains;\n#[cfg(test)]\nuse inference::{\n    infer_base_conv_value_domains, infer_root_expression_domain, mod_field,\n    MAX_LINEAR_SYSTEM_CELLS, MAX_LINEAR_SYSTEM_EQUATIONS,\n};\npub use inference::{\n    infer_domains_from_expression_domain, infer_domains_from_expression_domain_with_modulus,\n    infer_linear_system_values_with_modulus, infer_value_assignments_from_zero_equation,\n    infer_value_domains_from_zero_equation, infer_value_domains_from_zero_equation_with_modulus,\n};\n\n// Reprezentációs korlátnál nem tanul új domaint; a valódi lehetőségeket nem csonkítja.\npub(crate) const MAX_FINITE_DOMAIN_SIZE: usize = 256;\n/// A támogatott Halo2-testek értékei elférnek benne, de a tárolt egészek mérete korlátos marad.\npub const MAX_VALUE_BITS: u64 = 4096;\n\n//Minden valóban lehetséges értéket lefed, de tartalmazhat még kizáratlan jelölteket is.\n#[derive(Clone, Debug, Eq, PartialEq)]\npub enum UcpValueDomain {\n    Exact(BigInt),\n    //Explicit halmaz, nem intervallum: például {1,3} nem tartalmazza a 2-t.\n    FiniteSet(BTreeSet<BigInt>),\n}\n\n//A cellákhoz rendelt domain-t tárolja\n//Hiányzó bejegyzés: nincs tárolt domain. Ez nem bizonyít sem egyértelműséget, sem titkosságot.\n#[derive(Clone, Debug, Default, Eq, PartialEq)]\npub struct UcpValueFacts {\n    domains: HashMap<CellId, UcpValueDomain>,\n    complete_domains: HashSet<CellId>,\n}\n\n//Enum az értékekhez\n//NonZero nem jelent egyetlen értéket: például a {3,7} domain is biztosan nem nulla.\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\npub enum ValueKind {\n    Zero,\n    NonZero,\n    Unknown,\n}\n\n// A logikai hibaokot külön tárolja; a felhasználói üzenetet a külső függvény készíti el.\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\npub(crate) enum CompleteDomainError {\n    DomainValue,\n    SampleValue,\n    ExcludedFeasibleValue,\n    RepresentationLimit,\n}\n\nimpl UcpValueDomain {\n    // Konkrét értékből egyelemű domaint készít.\n    pub fn exact(value: BigInt) -> Self {\n        Self::Exact(value)\n    }\n\n    // A megadott értékekből véges domaint készít.\n    //Duplikátumokat töröl, az egyelemű halmazt Exact-tá alakítja; hibánál vagy üres halmaznál None.\n    pub fn finite_set<I>(values: I) -> Option<Self>\n    where\n        I: IntoIterator<Item = BigInt>,\n    {\n        let mut set = BTreeSet::new();\n\n        // A teljes halmaz felépítése közben ellenőrzi az érték- és elemszámkorlátot.\n        for value in values {\n            set.insert(bounded_value(value)?);\n            if set.len() > MAX_FINITE_DOMAIN_SIZE {\n                return None;\n            }\n        }\n\n        match set.len() {\n            0 => None,\n            1 => Some(Self::Exact(set.into_iter().next().unwrap())),\n            _ => Some(Self::FiniteSet(set)),\n        }\n    }\n\n    //Konkrét értéket visszaadja ha van\n    pub fn exact_value(&self) -> Option<&BigInt> {\n        match self {\n            Self::Exact(value) => Some(value),\n            Self::FiniteSet(_) => None,\n        }\n    }\n\n    //Az egyeleműséget az Exact változat jelzi; a finite_set konstruktor biztosítja ezt az alakot.\n    pub fn is_singleton(&self) -> bool {\n        matches!(self, Self::Exact(_))\n    }\n\n    //Ellenőrzi, hogy ha konkrét akkor az az érték, ha pedig tartomány, akkor meg az összes érték a min és max közé esik-e\n    pub fn is_subset_of_range(&self, min: &BigInt, max: &BigInt) -> bool {\n        match self {\n            Self::Exact(value) => value >= min && value <= max,\n            Self::FiniteSet(values) => values.iter().all(|value| value >= min && value <= max),\n        }\n    }\n\n    // Visszaadja a domain legnagyobb értékét az intervallumos feltételek ellenőrzéséhez.\n    pub fn max_value(&self) -> &BigInt {\n        match self {\n            Self::Exact(value) => value,\n            Self::FiniteSet(values) => values\n                .iter()\n                .next_back()\n                .expect(\"finite_set never creates an empty set\"),\n        }\n    }\n\n    // Visszaadja a két domain metszetét.\n    fn intersect(&self, other: &Self) -> Option<Self> {\n        match (self, other) {\n            (Self::Exact(left), Self::Exact(right)) if left == right => {\n                Some(Self::Exact(left.clone()))\n            }\n            (Self::Exact(value), Self::FiniteSet(set))\n            | (Self::FiniteSet(set), Self::Exact(value))\n                if set.contains(value) =>\n            {\n                Some(Self::Exact(value.clone()))\n            }\n            (Self::FiniteSet(left), Self::FiniteSet(right)) => {\n                Self::finite_set(left.intersection(right).map(|value| value.clone()))\n            }\n            _ => None,\n        }\n    }\n\n    //Visszaadja, hogy milyen típusú a domain értéke\n    fn value_kind(&self) -> ValueKind {\n        match self {\n            Self::Exact(value) if value == &BigInt::from(0) => ValueKind::Zero,\n            Self::Exact(_) => ValueKind::NonZero,\n            //Biztonsági okból, ha már domain szerint lehetséges a 0 akkor Unknown lesz\n            Self::FiniteSet(values) if values.iter().all(|value| value != &BigInt::from(0)) => {\n                ValueKind::NonZero\n            }\n            _ => ValueKind::Unknown,\n        }\n    }\n}\n\n// A strukturalt hibaokbol kesziti a felhasznaloi uzenetet.\npub(crate) fn complete_domain_error_message(\n    cell: &CellId,\n    error: CompleteDomainError,\n) -> anyhow::Error {\n    match error {\n        CompleteDomainError::DomainValue => {\n            anyhow::anyhow!(\"Unsupported complete-domain field value\")\n        }\n        CompleteDomainError::SampleValue => {\n            anyhow::anyhow!(\"Unsupported complete-domain sample\")\n        }\n        CompleteDomainError::ExcludedFeasibleValue => anyhow::anyhow!(\n            \"Recorded domain for {} excludes a proven feasible value\",\n            cell\n        ),\n        CompleteDomainError::RepresentationLimit => {\n            anyhow::anyhow!(\"Complete domain exceeds representation limits\")\n        }\n    }\n}\n\nimpl UcpValueFacts {\n    pub fn new() -> Self {\n        Self::default()\n    }\n\n    // A konkrét értéket egyelemű domainként jegyzi be.\n    // Új tény bejegyzésekor igazat ad vissza a következő UCP-kör jelzéséhez.\n    pub fn mark_known(&mut self, cell: CellId, value: BigInt) -> bool {\n        self.mark_domain(cell, UcpValueDomain::exact(value))\n    }\n\n    // A megadott lefedő domaint az állapotba olvasztja.\n    // Új vagy szűkebb domain bejegyzésekor igazat ad vissza.\n    //Csak már igazolt lefedő domaint szabad átadni: ez a tároló nem ellenőriz kényszereket vagy SMT-t.\n    pub fn mark_domain(&mut self, cell: CellId, domain: UcpValueDomain) -> bool {\n        if self.domain_is_complete(&cell) {\n            return false;\n        }\n        // A bemeneti domain reprezentálhatóságát ellenőrzi.\n        let domain = match domain {\n            // A konkrét érték bitméretét ellenőrzi.\n            UcpValueDomain::Exact(value) => UcpValueDomain::Exact(match bounded_value(value) {\n                Some(value) => value,\n                None => return false,\n            }),\n            //Ellenőrzi, hogy tud-e érvényes domaint létrehozni\n            UcpValueDomain::FiniteSet(values) => {\n                let Some(domain) = UcpValueDomain::finite_set(values) else {\n                    return false;\n                };\n                domain\n            }\n        };\n\n        //Megnézi, hogy a korábbi cellának volt-e már domain-je\n        match self.domains.get(&cell) {\n            Some(existing) => {\n                // Meglévő domainnél a két halmaz metszetét képezi.\n                // Üres metszetet nem tárol; az engine külön vizsgálja az ellentmondást.\n                let Some(intersection) = existing.intersect(&domain) else {\n                    return false;\n                };\n                //Ha meg lehet és megegyezik a kettő\n                if &intersection == existing {\n                    false\n                } else {\n                    //Felülírja a korábbit az új metszetre\n                    self.domains.insert(cell, intersection);\n                    true\n                }\n            }\n            // Meglévő bejegyzés hiányában felveszi az új domaint.\n            None => {\n                self.domains.insert(cell, domain);\n                true\n            }\n        }\n    }\n\n    //Visszaadja a konkrét értéket\n    pub fn known_value(&self, cell: &CellId) -> Option<&BigInt> {\n        self.domains.get(cell)?.exact_value()\n    }\n\n    //Visszaadja a tartományt\n    pub fn domain(&self, cell: &CellId) -> Option<&UcpValueDomain> {\n        self.domains.get(cell)\n    }\n\n    /// Kielégíthető premisszák mellett az egyelemű lefedő domain már teljes.\n    /// Az egyértelműség visszaállított érték nélkül nem igazolja a domain teljességét.\n    /// A false azt jelenti, hogy a teljesség nincs bizonyítva. Új premisszákhoz új elemzési állapot kell.\n    pub fn domain_is_complete(&self, cell: &CellId) -> bool {\n        self.domains\n            .get(cell)\n            .is_some_and(|domain| domain.is_singleton() || self.complete_domains.contains(cell))\n    }\n\n    /// A mintáknak ugyanazon eredeti kontextus kielégítő értékadásaiból kell származniuk.\n    //A W mintái belső, Delta jelöltjei külső közelítést adnak; egyezésük igazolja a teljességet.\n    pub(crate) fn mark_complete_from_samples(\n        &mut self,\n        cell: &CellId,\n        samples: &BTreeSet<BigInt>,\n        modulus: &BigInt,\n    ) -> Result<bool> {\n        self.try_mark_complete_from_samples(cell, samples, modulus)\n            .map_err(|error| complete_domain_error_message(cell, error))\n    }\n\n    // A teljességet normalizált mintákból igazolja, diagnosztikai formázás nélkül.\n    pub(crate) fn try_mark_complete_from_samples(\n        &mut self,\n        cell: &CellId,\n        samples: &BTreeSet<BigInt>,\n        modulus: &BigInt,\n    ) -> std::result::Result<bool, CompleteDomainError> {\n        let Some(domain) = self.domains.get(cell) else {\n            return Ok(false);\n        };\n        let entries: Vec<_> = match domain {\n            UcpValueDomain::Exact(value) => {\n                let mut entries = Vec::new();\n                entries.push(value);\n                entries\n            }\n            UcpValueDomain::FiniteSet(values) => values.iter().collect(),\n        };\n        let mut candidates = BTreeMap::new();\n        // Közös testbeli reprezentánsra normalizálja az értékeket; -1 és p-1 ugyanazt az elemet jelöli.\n        for value in entries {\n            let normalized = normalize_field_value(value.clone(), modulus)\n                .ok_or(CompleteDomainError::DomainValue)?;\n            candidates\n                .entry(normalized)\n                .or_insert_with(|| value.clone());\n        }\n        let feasible: BTreeSet<_> = samples\n            .iter()\n            .map(|value| {\n                normalize_field_value(value.clone(), modulus)\n                    .ok_or(CompleteDomainError::SampleValue)\n            })\n            .collect::<std::result::Result<_, _>>()?;\n        if !feasible.iter().all(|value| candidates.contains_key(value)) {\n            return Err(CompleteDomainError::ExcludedFeasibleValue);\n        }\n        if feasible.len() != candidates.len() || feasible.is_empty() {\n            return Ok(false);\n        }\n        let canonical = UcpValueDomain::finite_set(candidates.into_values())\n            .ok_or(CompleteDomainError::RepresentationLimit)?;\n        let changed = self.domains.get(cell) != Some(&canonical);\n        self.domains.insert(cell.clone(), canonical);\n        Ok(self.complete_domains.insert(cell.clone()) || changed)\n    }\n\n    /// Önálló másolatot készít a domainekről hipotetikus következtetéshez.\n    /// A másolatban törli a többértékű domainek teljességi jelöléseit, hogy azok\n    /// a vizsgált feltevés mellett szűkíthetők legyenek. Az eredeti állapotot nem módosítja.\n    /// Az egyelemű domaineket a domain_is_complete továbbra is teljesnek tekinti.\n    pub(crate) fn for_hypothetical_reasoning(&self) -> Self {\n        Self {\n            domains: self.domains.clone(),\n            // A másolatban engedi a többértékű teljes domain hipotetikus szűkítését; az eredeti állapotot nem módosítja.\n            complete_domains: HashSet::new(),\n        }\n    }\n\n    //Ellenőrzi, hogy a cellához tartozó domain teljesen a megadott intervallumba esik-e\n    pub fn domain_is_subset_of_range(&self, cell: &CellId, min: &BigInt, max: &BigInt) -> bool {\n        self.domain(cell)\n            .map(|domain| domain.is_subset_of_range(min, max))\n            .unwrap_or(false)\n    }\n\n    //Visszaadja az összes eddig ismert domain-t\n    pub fn domains(&self) -> &HashMap<CellId, UcpValueDomain> {\n        &self.domains\n    }\n\n    //Kiszedi azokat a cellákat, amelyeknek már konkrét értékük van\n    pub fn known_values(&self) -> HashMap<CellId, BigInt> {\n        self.domains\n            .iter()\n            .filter_map(|(cell, domain)| {\n                domain\n                    .exact_value()\n                    .map(|value| (cell.clone(), value.clone()))\n            })\n            .collect()\n    }\n}\n\n//Az elemző bemenetében megadott instance cellákból létrehozza a kezdeti konkrét Delta-értékeket.\npub fn initial_values_from_instance_cells<'a, I, V>(instance_cells: I) -> UcpValueFacts\nwhere\n    I: IntoIterator<Item = (&'a String, &'a V)>,\n    V: Clone + Into<BigInt> + 'a,\n{\n    let mut values = UcpValueFacts::new();\n\n    for (name, value) in instance_cells {\n        if let Some(cell) = parse_cell_id(name) {\n            values.mark_known(cell, value.clone().into());\n        }\n    }\n\n    values\n}\n\n//Megpróbál egy UCP-kifejezést konkrét értékre kiértékelni a már ismert Delta alapján.\n//Ez BigInt-aritmetika; a testmodulus szerinti normalizálást a modulusos domainfüggvények végzik.\npub fn evaluate_expr(expr: &UcpExpr, values: &UcpValueFacts) -> Option<BigInt> {\n    match expr {\n        //Ha az adott cellához van konkrét érték, akkor megadja\n        UcpExpr::Var(cell) => bounded_value(values.known_value(cell)?.clone()),\n        //Ha a konstans konkrétan ismert, akkor visszaadja az értékét\n        UcpExpr::Const(scalar) => bounded_value(scalar.as_known()?),\n        //Ha a belső kifejezés kiértékelhető, akkor az ellentettjét adja\n        UcpExpr::Neg(inner) => bounded_value(-evaluate_expr(inner, values)?),\n        //Akkor értékelhető ki, ha mindkét oldal konkrétan kiértékelhető\n        UcpExpr::Add(left, right) => {\n            bounded_value(evaluate_expr(left, values)? + evaluate_expr(right, values)?)\n        }\n        //Akkor értékelhető ki, ha mindkét szorzótényező konkrétan kiértékelhető\n        UcpExpr::Mul(left, right) => {\n            bounded_value(evaluate_expr(left, values)? * evaluate_expr(right, values)?)\n        }\n        // Skálázásnál konkrét együtthatóval számol, vagy a biztos nulla eredményt ismeri fel.\n        UcpExpr::Scale(inner, scalar) => match scalar {\n            //Nullával szorzás mindig nulla\n            UcpScalar::Zero => Some(BigInt::from(0)),\n            //Konkrét skálánál kiszámolja a belső érték és a skála szorzatát\n            UcpScalar::Known(scale) => bounded_value(evaluate_expr(inner, values)? * scale),\n            // Ismeretlen skálánál csak a nulla belső értékből ad konkrét eredményt.\n            UcpScalar::NonZero | UcpScalar::Unknown => {\n                let inner_value = evaluate_expr(inner, values)?;\n                if inner_value == BigInt::from(0) {\n                    Some(BigInt::from(0))\n                } else {\n                    None\n                }\n            }\n        },\n    }\n}\n\n//QED²-cikk 9. ábrája, Var/Const/Op: a kifejezés véges Delta-domainjét számolja modulus nélkül.\npub fn expression_domain(expr: &UcpExpr, values: &UcpValueFacts) -> Option<UcpValueDomain> {\n    expression_domain_with_optional_modulus(expr, values, None)\n}\n\n//QED²-cikk 9. ábrája, Var/Const/Op: a kifejezés véges Delta-domainjét számolja a test modulusa szerint.\npub fn expression_domain_with_modulus(\n    expr: &UcpExpr,\n    values: &UcpValueFacts,\n    field_modulus: &BigInt,\n) -> Option<UcpValueDomain> {\n    expression_domain_with_optional_modulus(expr, values, Some(field_modulus))\n}\n\n// QED²-cikk 9. ábrája: a Var, Const és Op lépéseket közös végeshalmaz-kiértékelővel kezeli.\n//A műveleti eredmény is lefedő domain: a részfák közötti korrelációkat nem követi pontosan.\nfn expression_domain_with_optional_modulus(\n    expr: &UcpExpr,\n    values: &UcpValueFacts,\n    field_modulus: Option<&BigInt>,\n) -> Option<UcpValueDomain> {\n    match expr {\n        UcpExpr::Var(cell) => {\n            let domain = values.domain(cell)?;\n            match field_modulus {\n                Some(_) => finite_domain_from_values(domain_values(domain), field_modulus),\n                None => Some(domain.clone()),\n            }\n        }\n        UcpExpr::Const(scalar) => finite_domain_from_values([scalar.as_known()?], field_modulus),\n        UcpExpr::Neg(inner) => {\n            let inner = expression_domain_with_optional_modulus(inner, values, field_modulus)?;\n            map_domain_values(&inner, field_modulus, |value| -value)\n        }\n        UcpExpr::Add(left, right) => {\n            let left = expression_domain_with_optional_modulus(left, values, field_modulus)?;\n            let right = expression_domain_with_optional_modulus(right, values, field_modulus)?;\n            combine_domain_values(&left, &right, field_modulus, |left, right| left + right)\n        }\n        UcpExpr::Mul(left, right) => {\n            if value_kind(left, values) == ValueKind::Zero\n                || value_kind(right, values) == ValueKind::Zero\n            {\n                return Some(UcpValueDomain::exact(BigInt::from(0)));\n            }\n\n            let left = expression_domain_with_optional_modulus(left, values, field_modulus)?;\n            let right = expression_domain_with_optional_modulus(right, values, field_modulus)?;\n            combine_domain_values(&left, &right, field_modulus, |left, right| left * right)\n        }\n        UcpExpr::Scale(inner, scalar) => match scalar {\n            UcpScalar::Zero => Some(UcpValueDomain::exact(BigInt::from(0))),\n            UcpScalar::Known(scale) => {\n                let inner = expression_domain_with_optional_modulus(inner, values, field_modulus)?;\n                map_domain_values(&inner, field_modulus, |value| value * scale)\n            }\n            UcpScalar::NonZero | UcpScalar::Unknown => {\n                if value_kind(inner, values) == ValueKind::Zero {\n                    Some(UcpValueDomain::exact(BigInt::from(0)))\n                } else {\n                    None\n                }\n            }\n        },\n    }\n}\n\n//A tárolt egészek méretét korlátozza, nem gépi szavakat: a testelemek túlléphetik az i64 tartományát.\npub(crate) fn bounded_value(value: BigInt) -> Option<BigInt> {\n    if value.bits() <= MAX_VALUE_BITS {\n        Some(value)\n    } else {\n        None\n    }\n}\n\nfn normalize_value(value: BigInt, field_modulus: Option<&BigInt>) -> Option<BigInt> {\n    match field_modulus {\n        Some(modulus) => normalize_field_value(value, modulus),\n        None => bounded_value(value),\n    }\n}\n\npub(crate) fn normalize_field_value(value: BigInt, modulus: &BigInt) -> Option<BigInt> {\n    if modulus <= &BigInt::from(1) || modulus.bits() > MAX_VALUE_BITS {\n        return None;\n    }\n\n    let mut normalized = value % modulus;\n    if normalized < BigInt::from(0) {\n        normalized += modulus;\n    }\n\n    // Előjeles reprezentánst használ: p-1 például -1-ként tárolható,\n    //az elemző SMT-illesztője később ezt újra testelemre normalizálja.\n    if normalized > modulus / BigInt::from(2) {\n        normalized -= modulus;\n    }\n\n    bounded_value(normalized)\n}\n\nfn finite_domain_from_values<I>(values: I, field_modulus: Option<&BigInt>) -> Option<UcpValueDomain>\nwhere\n    I: IntoIterator<Item = BigInt>,\n{\n    // Normalizálás után szűri az ismétléseket; túl nagy eredménynél nem ad új domaint.\n    let mut set = BTreeSet::new();\n\n    for value in values {\n        let value = normalize_value(value, field_modulus)?;\n        if !set.contains(&value) && set.len() >= MAX_FINITE_DOMAIN_SIZE {\n            return None;\n        }\n        set.insert(value);\n    }\n\n    UcpValueDomain::finite_set(set)\n}\n\n//A domainből BigInt vektort csinál\nfn domain_values(domain: &UcpValueDomain) -> Vec<BigInt> {\n    match domain {\n        UcpValueDomain::Exact(value) => vec![value.clone()],\n        UcpValueDomain::FiniteSet(values) => values.iter().cloned().collect(),\n    }\n}\n\nfn map_domain_values<F>(\n    domain: &UcpValueDomain,\n    field_modulus: Option<&BigInt>,\n    mut op: F,\n) -> Option<UcpValueDomain>\nwhere\n    F: FnMut(BigInt) -> BigInt,\n{\n    finite_domain_from_values(\n        domain_values(domain).into_iter().map(|value| op(value)),\n        field_modulus,\n    )\n}\n\nfn combine_domain_values<F>(\n    left: &UcpValueDomain,\n    right: &UcpValueDomain,\n    field_modulus: Option<&BigInt>,\n    mut op: F,\n) -> Option<UcpValueDomain>\nwhere\n    F: FnMut(BigInt, BigInt) -> BigInt,\n{\n    let left_values = domain_values(left);\n    let right_values = domain_values(right);\n\n    // A Descartes-szorzat munkáját is korlátozza; None esetén nem állapít meg üres megoldáshalmazt.\n    if left_values.len().saturating_mul(right_values.len()) > MAX_FINITE_DOMAIN_SIZE {\n        return None;\n    }\n\n    let mut values = Vec::with_capacity(left_values.len() * right_values.len());\n    for left in &left_values {\n        for right in &right_values {\n            values.push(op(left.clone(), right.clone()));\n        }\n    }\n\n    finite_domain_from_values(values, field_modulus)\n}\n\n//Megmondja, hogy egy kifejezés biztosan nulla, biztosan nem nulla, vagy ismeretlen.\npub fn value_kind(expr: &UcpExpr, values: &UcpValueFacts) -> ValueKind {\n    value_kind_with_optional_modulus(expr, values, None)\n}\n\nfn value_kind_with_optional_modulus(\n    expr: &UcpExpr,\n    values: &UcpValueFacts,\n    modulus: Option<&BigInt>,\n) -> ValueKind {\n    if modulus.is_some_and(|modulus| modulus <= &BigInt::from(1)) {\n        return ValueKind::Unknown;\n    }\n    //Ha a teljes domain nem számolható ki, az algebrai nulla/nemnulla tulajdonság még felismerhető.\n    if let Some(domain) = expression_domain_with_optional_modulus(expr, values, modulus) {\n        domain.value_kind()\n    } else {\n        match expr {\n            UcpExpr::Const(UcpScalar::Zero) => ValueKind::Zero,\n            UcpExpr::Const(UcpScalar::NonZero) => ValueKind::NonZero,\n            UcpExpr::Const(UcpScalar::Known(value)) => match modulus {\n                Some(modulus) if value % modulus == BigInt::from(0) => ValueKind::Zero,\n                Some(_) => ValueKind::NonZero,\n                None => ValueKind::Unknown,\n            },\n            UcpExpr::Scale(inner, scalar) => {\n                let inner_kind = value_kind_with_optional_modulus(inner, values, modulus);\n                if scalar.is_zero()\n                    || matches!(scalar, UcpScalar::Known(value)\n                        if modulus.is_some_and(|modulus| value % modulus == BigInt::from(0)))\n                    || inner_kind == ValueKind::Zero\n                {\n                    ValueKind::Zero\n                } else if scalar.is_non_zero_with_modulus(modulus) {\n                    inner_kind\n                } else {\n                    ValueKind::Unknown\n                }\n            }\n            UcpExpr::Neg(inner) => value_kind_with_optional_modulus(inner, values, modulus),\n            UcpExpr::Mul(left, right) => {\n                match (\n                    value_kind_with_optional_modulus(left, values, modulus),\n                    value_kind_with_optional_modulus(right, values, modulus),\n                ) {\n                    (ValueKind::Zero, _) | (_, ValueKind::Zero) => ValueKind::Zero,\n                    (ValueKind::NonZero, ValueKind::NonZero) => ValueKind::NonZero,\n                    _ => ValueKind::Unknown,\n                }\n            }\n            _ => ValueKind::Unknown,\n        }\n    }\n}\n\npub(crate) fn parse_cell_id(name: &str) -> Option<CellId> {\n    let mut parts = name.split('-');\n    let kind = parts.next()?;\n    let column = parts.next()?.parse::<usize>().ok()?;\n    let row = parts.next()?.parse::<i32>().ok()?;\n    if parts.next().is_some() {\n        return None;\n    }\n\n    //Meghívja a megfelelő konstruktort\n    match kind {\n        \"A\" => Some(CellId::advice(column, row)),\n        \"I\" => Some(CellId::instance(column, row)),\n        \"F\" => Some(CellId::fixed(column, row)),\n        _ => None,\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn finite_domain(values: &[i64]) -> UcpValueDomain {\n        UcpValueDomain::finite_set(values.iter().map(|value| BigInt::from(*value))).unwrap()\n    }\n\n    fn coupled_equations(x: &CellId, y: &CellId, sum: i64, difference: i64) -> Vec<UcpExpr> {\n        vec![\n            UcpExpr::add(\n                UcpExpr::add(UcpExpr::var(x.clone()), UcpExpr::var(y.clone())),\n                UcpExpr::known_constant_i64(-sum),\n            ),\n            UcpExpr::add(\n                UcpExpr::add(\n                    UcpExpr::var(x.clone()),\n                    UcpExpr::neg(UcpExpr::var(y.clone())),\n                ),\n                UcpExpr::known_constant_i64(-difference),\n            ),\n        ]\n    }\n\n    // A teszt ellenőrzi, hogy a két egyenletet együtt megoldja x=6,y=4-re, ahol az egyenkénti Assign elakad.\n    #[test]\n    fn solves_coupled_linear_values() {\n        let x = CellId::advice(0, 0);\n        let y = CellId::advice(1, 0);\n        assert_eq!(\n            infer_linear_system_values_with_modulus(\n                &coupled_equations(&x, &y, 10, 2),\n                &UcpValueFacts::new(),\n                &BigInt::from(101),\n            ),\n            vec![(x, BigInt::from(6)), (y, BigInt::from(4))],\n        );\n    }\n\n    // A teszt ellenőrzi, hogy ranghiánynál vagy ellentmondó további sornál nem választ tetszőleges modellt.\n    #[test]\n    fn rejects_singular_and_inconsistent_linear_systems() {\n        let x = CellId::advice(0, 0);\n        let y = CellId::advice(1, 0);\n        let mut equations = coupled_equations(&x, &y, 10, 2);\n        assert!(infer_linear_system_values_with_modulus(\n            &equations[..1],\n            &UcpValueFacts::new(),\n            &BigInt::from(101),\n        )\n        .is_empty());\n        let singular = vec![equations[0].clone(), equations[0].clone()];\n        assert!(infer_linear_system_values_with_modulus(\n            &singular,\n            &UcpValueFacts::new(),\n            &BigInt::from(101),\n        )\n        .is_empty());\n        equations.push(coupled_equations(&x, &y, 11, 2).remove(0));\n        assert!(infer_linear_system_values_with_modulus(\n            &equations,\n            &UcpValueFacts::new(),\n            &BigInt::from(101),\n        )\n        .is_empty());\n    }\n\n    // A teszt ellenőrzi, hogy a p-1 együtthatót -1-ként kezeli az i64-en túli reprezentánsnál is.\n    #[test]\n    fn solves_with_large_field_coefficients() {\n        let modulus = (BigInt::from(1) << 127usize) - BigInt::from(1);\n        let x = CellId::advice(0, 0);\n        let y = CellId::advice(1, 0);\n        let mut equations = coupled_equations(&x, &y, 5, 1);\n        equations[1] = UcpExpr::add(\n            UcpExpr::add(\n                UcpExpr::var(x.clone()),\n                UcpExpr::scale_by(UcpExpr::var(y.clone()), UcpScalar::known(&modulus - 1)),\n            ),\n            UcpExpr::known_constant_i64(-1),\n        );\n        assert_eq!(\n            infer_linear_system_values_with_modulus(&equations, &UcpValueFacts::new(), &modulus,),\n            vec![(x, BigInt::from(3)), (y, BigInt::from(2))]\n        );\n    }\n\n    #[test]\n    fn does_not_learn_values_outside_existing_domains() {\n        let x = CellId::advice(0, 0);\n        let y = CellId::advice(1, 0);\n        let mut values = UcpValueFacts::new();\n        values.mark_domain(x.clone(), finite_domain(&[0, 1]));\n        assert!(infer_linear_system_values_with_modulus(\n            &coupled_equations(&x, &y, 10, 2),\n            &values,\n            &BigInt::from(101),\n        )\n        .is_empty());\n    }\n\n    // A teszt ellenőrzi, hogy nagy komponens korlátja mellett is megoldja a független kis rendszert.\n    #[test]\n    fn limits_large_components_but_solves_small_independent_ones() {\n        let count = MAX_LINEAR_SYSTEM_CELLS + 1;\n        let mut equations: Vec<_> = (0..count)\n            .map(|index| {\n                UcpExpr::add(\n                    UcpExpr::add(\n                        UcpExpr::var(CellId::advice(index, 0)),\n                        UcpExpr::var(CellId::advice((index + 1) % count, 0)),\n                    ),\n                    UcpExpr::known_constant_i64(-2),\n                )\n            })\n            .collect();\n        let x = CellId::advice(count, 0);\n        let y = CellId::advice(count + 1, 0);\n        equations.extend(coupled_equations(&x, &y, 10, 2));\n        assert_eq!(\n            infer_linear_system_values_with_modulus(\n                &equations,\n                &UcpValueFacts::new(),\n                &BigInt::from(101),\n            ),\n            vec![(x, BigInt::from(6)), (y, BigInt::from(4))]\n        );\n    }\n\n    #[test]\n    fn solves_a_full_rank_subsystem_inside_an_underdetermined_component() {\n        let x = CellId::advice(0, 0);\n        let y = CellId::advice(1, 0);\n        let mut equations = coupled_equations(&x, &y, 10, 2);\n        //Az x+y=10 és x-y=2 rögzíti x és y értékét; az x+z+w=0 mellett z és w nem egyértelmű.\n        equations.push(UcpExpr::add(\n            UcpExpr::var(x.clone()),\n            UcpExpr::add(\n                UcpExpr::var(CellId::advice(2, 0)),\n                UcpExpr::var(CellId::advice(3, 0)),\n            ),\n        ));\n        assert_eq!(\n            infer_linear_system_values_with_modulus(\n                &equations,\n                &UcpValueFacts::new(),\n                &BigInt::from(101)\n            ),\n            vec![(x, BigInt::from(6)), (y, BigInt::from(4))]\n        );\n    }\n\n    #[test]\n    fn small_subsystem_survives_the_connected_component_size_limit() {\n        let x = CellId::advice(0, 0);\n        let y = CellId::advice(1, 0);\n        let mut equations = coupled_equations(&x, &y, 10, 2);\n        for index in 2..MAX_LINEAR_SYSTEM_CELLS + 3 {\n            equations.push(UcpExpr::add(\n                UcpExpr::var(x.clone()),\n                UcpExpr::add(\n                    UcpExpr::var(CellId::advice(index, 0)),\n                    UcpExpr::var(CellId::advice(index + 1, 0)),\n                ),\n            ));\n        }\n        assert_eq!(\n            infer_linear_system_values_with_modulus(\n                &equations,\n                &UcpValueFacts::new(),\n                &BigInt::from(101)\n            ),\n            vec![(x, BigInt::from(6)), (y, BigInt::from(4))]\n        );\n    }\n\n    #[test]\n    fn local_subsystem_search_respects_the_equation_budget() {\n        let x = CellId::advice(0, 0);\n        let y = CellId::advice(1, 0);\n        let mut equations: Vec<_> = (2..MAX_LINEAR_SYSTEM_EQUATIONS + 2)\n            .map(|index| {\n                UcpExpr::add(\n                    UcpExpr::var(x.clone()),\n                    UcpExpr::add(\n                        UcpExpr::var(CellId::advice(index, 0)),\n                        UcpExpr::var(CellId::advice(index + 1, 0)),\n                    ),\n                )\n            })\n            .collect();\n        //A hasznos egyenletpár már a helyi keresési kereten kívül van; a teljes komponens túl nagy.\n        equations.extend(coupled_equations(&x, &y, 10, 2));\n        assert!(infer_linear_system_values_with_modulus(\n            &equations,\n            &UcpValueFacts::new(),\n            &BigInt::from(101),\n        )\n        .is_empty());\n    }\n\n    #[test]\n    fn subsystem_values_cover_all_satisfying_assignments_in_small_prime_fields() {\n        let x = CellId::advice(0, 0);\n        let y = CellId::advice(1, 0);\n        let z = CellId::advice(2, 0);\n        let w = CellId::advice(3, 0);\n        for p in [3, 5, 7] {\n            for sum in 0..p {\n                for difference in 0..p {\n                    let mut equations = coupled_equations(&x, &y, sum, difference);\n                    equations.push(UcpExpr::add(\n                        UcpExpr::var(x.clone()),\n                        UcpExpr::add(UcpExpr::var(z.clone()), UcpExpr::var(w.clone())),\n                    ));\n                    let inferred = infer_linear_system_values_with_modulus(\n                        &equations,\n                        &UcpValueFacts::new(),\n                        &BigInt::from(p),\n                    );\n                    assert_eq!(inferred.len(), 2);\n                    for a in 0..p {\n                        for b in 0..p {\n                            for c in 0..p {\n                                for d in 0..p {\n                                    if (a + b) % p != sum\n                                        || (a - b + p) % p != difference\n                                        || (a + c + d) % p != 0\n                                    {\n                                        continue;\n                                    }\n                                    for (cell, value) in &inferred {\n                                        let actual = if cell == &x {\n                                            a\n                                        } else {\n                                            assert_eq!(cell, &y);\n                                            b\n                                        };\n                                        assert_eq!(\n                                            mod_field(value.clone(), &BigInt::from(p)),\n                                            BigInt::from(actual)\n                                        );\n                                    }\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    //A nagy és kis értékek is megmaradnak: az i64 korlátja nem zárhat ki testbeli megoldást.\n    #[test]\n    fn solves_values_beyond_i64_alongside_small_signed_solutions() {\n        let modulus = (BigInt::from(1) << 127usize) - BigInt::from(1);\n        let x = CellId::advice(0, 0);\n        let y = CellId::advice(1, 0);\n        let large = BigInt::from(i64::MAX) + BigInt::from(1);\n        let equations = vec![\n            UcpExpr::add(\n                UcpExpr::add(UcpExpr::var(x.clone()), UcpExpr::var(y.clone())),\n                UcpExpr::known_constant(-&large),\n            ),\n            UcpExpr::add(\n                UcpExpr::add(\n                    UcpExpr::var(x.clone()),\n                    UcpExpr::neg(UcpExpr::var(y.clone())),\n                ),\n                UcpExpr::known_constant(-(&large + BigInt::from(2))),\n            ),\n        ];\n        assert_eq!(\n            infer_linear_system_values_with_modulus(&equations, &UcpValueFacts::new(), &modulus,),\n            vec![(x, large + BigInt::from(1)), (y, BigInt::from(-1))]\n        );\n    }\n\n    #[test]\n    fn value_bit_and_domain_limits_abort_without_retaining_a_truncated_set() {\n        let largest = (BigInt::from(1) << MAX_VALUE_BITS as usize) - BigInt::from(1);\n        let oversized = &largest + BigInt::from(1);\n        assert_eq!(bounded_value(largest.clone()), Some(largest));\n        assert!(bounded_value(oversized.clone()).is_none());\n        assert!(UcpValueDomain::finite_set([BigInt::from(1), oversized.clone()]).is_none());\n        assert!(\n            UcpValueDomain::finite_set((0..=MAX_FINITE_DOMAIN_SIZE).map(BigInt::from)).is_none()\n        );\n        assert!(UcpValueDomain::finite_set(std::iter::repeat_n(\n            BigInt::from(1),\n            MAX_FINITE_DOMAIN_SIZE + 1\n        ))\n        .is_some());\n        let cell = CellId::advice(0, 0);\n        let mut values = UcpValueFacts::new();\n        assert!(!values.mark_known(cell.clone(), oversized));\n        assert!(values.domain(&cell).is_none());\n    }\n\n    #[test]\n    fn large_root_domain_preserves_holes_and_refines_to_an_exact_value() {\n        let x = CellId::advice(0, 0);\n        let root = BigInt::from(1) << 200usize;\n        let modulus = (BigInt::from(1) << 521usize) - BigInt::from(1);\n        //Az (x - 2^200) * (x - (2^200 + 2)) = 0 két gyököt enged meg, nem a középpontjukat.\n        let expression = UcpExpr::mul(\n            UcpExpr::add(UcpExpr::var(x.clone()), UcpExpr::known_constant(-&root)),\n            UcpExpr::add(\n                UcpExpr::var(x.clone()),\n                UcpExpr::known_constant(-(&root + BigInt::from(2))),\n            ),\n        );\n        let mut values = UcpValueFacts::new();\n        let domain = UcpValueDomain::finite_set([root.clone(), &root + 2]).unwrap();\n        assert_eq!(\n            infer_value_domains_from_zero_equation_with_modulus(&expression, &values, &modulus),\n            vec![(x.clone(), domain.clone())]\n        );\n        assert!(values.mark_domain(x.clone(), domain));\n        assert!(values.mark_domain(\n            x.clone(),\n            UcpValueDomain::finite_set([&root + 2, &root + 3]).unwrap()\n        ));\n        assert_eq!(values.known_value(&x), Some(&(&root + 2)));\n    }\n\n    //Azt ellenőrzi, hogy ismert értékekkel egy egyszerű aritmetikai kifejezés kiértékelhető.\n    #[test]\n    fn evaluates_known_arithmetic_expression() {\n        let x = CellId::instance(0, 0);\n        let mut values = UcpValueFacts::new();\n        values.mark_known(x.clone(), BigInt::from(2));\n        let expr = UcpExpr::add(UcpExpr::var(x), UcpExpr::known_constant_i64(-1));\n\n        assert_eq!(evaluate_expr(&expr, &values), Some(BigInt::from(1)));\n        assert_eq!(value_kind(&expr, &values), ValueKind::NonZero);\n    }\n\n    //Azt ellenőrzi, hogy nem nulla szorzótényező mellett a c * y = 0 alakból y = 0 következik.\n    #[test]\n    fn learns_zero_from_nonzero_product_equation() {\n        let x = CellId::instance(0, 0);\n        let y = CellId::advice(1, 0);\n        let mut values = UcpValueFacts::new();\n        values.mark_known(x.clone(), BigInt::from(2));\n        let nonzero = UcpExpr::add(UcpExpr::var(x), UcpExpr::known_constant_i64(-1));\n        let expr = UcpExpr::mul(nonzero, UcpExpr::var(y.clone()));\n\n        assert_eq!(\n            infer_value_assignments_from_zero_equation(&expr, &values),\n            vec![(y, BigInt::from(0))]\n        );\n    }\n\n    //Azt ellenőrzi, hogy x - 5 = 0 alakból konkrétan x = 5 tanulható\n    #[test]\n    fn learns_linear_assignment_value() {\n        let x = CellId::advice(0, 0);\n        let expr = UcpExpr::add(UcpExpr::var(x.clone()), UcpExpr::known_constant_i64(-5));\n\n        assert_eq!(\n            infer_value_assignments_from_zero_equation(&expr, &UcpValueFacts::new()),\n            vec![(x, BigInt::from(5))]\n        );\n    }\n\n    //Azt ellenőrzi, hogy b * (b - 1) = 0 alapján Delta(b) = {0, 1}\n    #[test]\n    fn root_rule_learns_boolean_domain() {\n        let b = CellId::advice(0, 0);\n        let expr = UcpExpr::mul(\n            UcpExpr::var(b.clone()),\n            UcpExpr::add(UcpExpr::var(b.clone()), UcpExpr::known_constant_i64(-1)),\n        );\n\n        let inferences = infer_value_domains_from_zero_equation(&expr, &UcpValueFacts::new());\n\n        assert_eq!(inferences, vec![(b, finite_domain(&[0, 1]))]);\n    }\n\n    //Azt ellenőrzi, hogy x * x = 0 alapján konkrétan x = 0 tanulható\n    #[test]\n    fn root_rule_learns_exact_zero_from_square_zero() {\n        let x = CellId::advice(0, 0);\n        let expr = UcpExpr::mul(UcpExpr::var(x.clone()), UcpExpr::var(x.clone()));\n\n        let inferences = infer_value_domains_from_zero_equation(&expr, &UcpValueFacts::new());\n\n        assert_eq!(\n            inferences,\n            vec![(x, UcpValueDomain::exact(BigInt::from(0)))]\n        );\n    }\n\n    #[test]\n    fn root_rule_handles_opposite_sign_factors() {\n        //A könyvtár a b*(1-b) alakot használja a b*(b-1) helyett.\n        let b = CellId::advice(0, 0);\n        let expr = UcpExpr::mul(\n            UcpExpr::var(b.clone()),\n            UcpExpr::add(\n                UcpExpr::known_constant_i64(1),\n                UcpExpr::neg(UcpExpr::var(b.clone())),\n            ),\n        );\n        assert_eq!(\n            infer_value_domains_from_zero_equation(&expr, &UcpValueFacts::new()),\n            vec![(b, finite_domain(&[0, 1]))]\n        );\n    }\n\n    #[test]\n    fn affine_root_projection_covers_every_small_field_solution() {\n        //Az eltolt első és az ellentétes előjelű második tényező a közös kifejezés felismerését teszteli.\n        let x = CellId::advice(0, 0);\n        let y = CellId::advice(1, 0);\n        let word = UcpExpr::add(\n            UcpExpr::var(x.clone()),\n            UcpExpr::scale_by(UcpExpr::var(y.clone()), UcpScalar::known_i64(-4)),\n        );\n        let expr = UcpExpr::mul(\n            UcpExpr::add(word.clone(), UcpExpr::known_constant_i64(-3)),\n            UcpExpr::mul(\n                UcpExpr::add(UcpExpr::known_constant_i64(7), UcpExpr::neg(word.clone())),\n                UcpExpr::add(word, UcpExpr::known_constant_i64(1)),\n            ),\n        );\n        let mut values = UcpValueFacts::new();\n        values.mark_domain(y.clone(), finite_domain(&[0, 1, 2]));\n        let inferences =\n            infer_value_domains_from_zero_equation_with_modulus(&expr, &values, &BigInt::from(17));\n        let (_, domain) = inferences.iter().find(|(cell, _)| cell == &x).unwrap();\n        assert_eq!(domain, &finite_domain(&[-6, -2, -1, 3, 7]));\n        for a in 0_i64..17 {\n            for b in 0_i64..3 {\n                let d = a - 4 * b;\n                if ((d - 3) * (7 - d) * (d + 1)).rem_euclid(17) == 0 {\n                    let signed = if a > 8 { a - 17 } else { a };\n                    assert!(domain_values(domain).contains(&BigInt::from(signed)));\n                }\n            }\n        }\n    }\n\n    #[test]\n    fn root_rule_rejects_different_affine_parts_and_unknown_scalars() {\n        let x = CellId::advice(0, 0);\n        let y = CellId::advice(1, 0);\n        let affine = |coefficient| {\n            UcpExpr::add(\n                UcpExpr::var(x.clone()),\n                UcpExpr::scale_by(UcpExpr::var(y.clone()), UcpScalar::known_i64(coefficient)),\n            )\n        };\n        let expr = UcpExpr::mul(affine(-4), affine(-2));\n        assert!(infer_root_expression_domain(&expr, &UcpValueFacts::new(), None).is_none());\n        let expr = UcpExpr::scale_by(\n            UcpExpr::mul(\n                UcpExpr::var(x.clone()),\n                UcpExpr::add(UcpExpr::var(x), UcpExpr::known_constant_i64(-1)),\n            ),\n            UcpScalar::Unknown,\n        );\n        assert!(infer_root_expression_domain(&expr, &UcpValueFacts::new(), None).is_none());\n    }\n\n    #[test]\n    fn root_rule_does_not_drop_a_zero_factor() {\n        //A közvetlen enum-létrehozás szándékosan megkerüli a konstruktor nullával való egyszerűsítését.\n        let x = UcpExpr::var(CellId::advice(0, 0));\n        for scalar in [UcpScalar::Zero, UcpScalar::Known(BigInt::from(0))] {\n            let zero = UcpExpr::Scale(Box::new(x.clone()), scalar);\n            let expr = UcpExpr::Mul(\n                Box::new(zero),\n                Box::new(UcpExpr::mul(\n                    x.clone(),\n                    UcpExpr::add(x.clone(), UcpExpr::known_constant_i64(-1)),\n                )),\n            );\n            assert!(\n                infer_value_domains_from_zero_equation(&expr, &UcpValueFacts::new()).is_empty()\n            );\n        }\n    }\n\n    #[test]\n    fn affine_root_projection_respects_the_finite_domain_limit() {\n        let x = UcpExpr::var(CellId::advice(0, 0));\n        let product = (1..=MAX_FINITE_DOMAIN_SIZE).fold(x.clone(), |product, root| {\n            UcpExpr::mul(\n                product,\n                UcpExpr::add(x.clone(), UcpExpr::known_constant_i64(-(root as i64))),\n            )\n        });\n        assert!(infer_root_expression_domain(&product, &UcpValueFacts::new(), None).is_none());\n    }\n\n    //Azt ellenőrzi, hogy két domain metszete szűkítheti a logikai értéktartományt konkrét értékre.\n    #[test]\n    fn intersecting_domain_can_refine_boolean_to_exact_value() {\n        let b = CellId::advice(0, 0);\n        let mut values = UcpValueFacts::new();\n\n        assert!(values.mark_domain(b.clone(), finite_domain(&[0, 1])));\n        assert!(values.mark_known(b.clone(), BigInt::from(1)));\n\n        assert_eq!(values.known_value(&b), Some(&BigInt::from(1)));\n    }\n\n    //Azt ellenőrzi, hogy egy véges domain teljesen beleesik-e egy adott intervallumba.\n    #[test]\n    fn finite_domain_can_be_checked_against_digit_range() {\n        let b = CellId::advice(0, 0);\n        let mut values = UcpValueFacts::new();\n\n        values.mark_domain(b.clone(), finite_domain(&[0, 1]));\n\n        assert!(values.domain_is_subset_of_range(&b, &BigInt::from(0), &BigInt::from(1)));\n        assert!(values.domain_is_subset_of_range(&b, &BigInt::from(0), &BigInt::from(9)));\n        assert!(!values.domain_is_subset_of_range(&b, &BigInt::from(1), &BigInt::from(9)));\n    }\n\n    //QED²-cikk 9. ábrája, Var/Const/Op: a véges kifejezésdomainek kiértékelését teszteli.\n    #[test]\n    fn expression_domain_combines_finite_sets() {\n        let x = CellId::advice(0, 0);\n        let y = CellId::advice(1, 0);\n        let mut values = UcpValueFacts::new();\n        values.mark_domain(x.clone(), finite_domain(&[0, 1]));\n        values.mark_domain(y.clone(), finite_domain(&[2, 3]));\n\n        let sum = UcpExpr::add(UcpExpr::var(x.clone()), UcpExpr::var(y.clone()));\n        let product = UcpExpr::mul(UcpExpr::var(x), UcpExpr::var(y));\n\n        assert_eq!(\n            expression_domain(&sum, &values),\n            Some(finite_domain(&[2, 3, 4]))\n        );\n        assert_eq!(\n            expression_domain(&product, &values),\n            Some(finite_domain(&[0, 2, 3]))\n        );\n    }\n\n    //Azt ellenőrzi, hogy x - (b + 1) = 0 alapján Delta(b)={0,1} esetén Delta(x)={1,2}\n    #[test]\n    fn linear_equation_learns_domain_from_expression_domain() {\n        let b = CellId::advice(0, 0);\n        let x = CellId::advice(1, 0);\n        let mut values = UcpValueFacts::new();\n        values.mark_domain(b.clone(), finite_domain(&[0, 1]));\n\n        let expr = UcpExpr::add(\n            UcpExpr::var(x.clone()),\n            UcpExpr::neg(UcpExpr::add(\n                UcpExpr::var(b),\n                UcpExpr::known_constant_i64(1),\n            )),\n        );\n\n        let inferences = infer_value_domains_from_zero_equation(&expr, &values);\n\n        assert_eq!(inferences, vec![(x, finite_domain(&[1, 2]))]);\n    }\n\n    // A teszt ellenőrzi, hogy c*x-e=0 esetén a testben c inverzével számol.\n    #[test]\n    fn scaled_linear_equation_uses_field_modulus_for_domain_division() {\n        let b = CellId::advice(0, 0);\n        let x = CellId::advice(1, 0);\n        let mut values = UcpValueFacts::new();\n        values.mark_domain(b.clone(), finite_domain(&[0, 2]));\n\n        let expr = UcpExpr::add(\n            UcpExpr::scale_by(UcpExpr::var(x.clone()), UcpScalar::known_i64(2)),\n            UcpExpr::neg(UcpExpr::var(b)),\n        );\n\n        let inferences =\n            infer_value_domains_from_zero_equation_with_modulus(&expr, &values, &BigInt::from(5));\n\n        assert_eq!(inferences, vec![(x, finite_domain(&[0, 1]))]);\n    }\n\n    // A teszt ellenőrzi, hogy az e in Omega tagsági feltételből celladomaint következtet.\n    #[test]\n    fn expression_membership_learns_affine_input_domain() {\n        let x = CellId::advice(0, 0);\n        let expr = UcpExpr::add(UcpExpr::var(x.clone()), UcpExpr::known_constant_i64(1));\n        let table_domain = finite_domain(&[1, 2, 3]);\n\n        let inferences =\n            infer_domains_from_expression_domain(&expr, &table_domain, &UcpValueFacts::new());\n\n        assert_eq!(inferences, vec![(x, finite_domain(&[0, 1, 2]))]);\n    }\n\n    //QED²-cikk 10. ábrája, Base-Conv: a számjegyes alakhoz kapcsolódó domainkövetkeztetést teszteli.\n    // A számjegykorlátokból x lefedő domainjét képezi; a számjegyek egyértelműségét itt nem bizonyítja.\n    #[test]\n    fn base_conv_value_rule_learns_target_range_as_finite_set() {\n        let x = CellId::advice(0, 0);\n        let b0 = CellId::advice(1, 0);\n        let b1 = CellId::advice(2, 0);\n        let b2 = CellId::advice(3, 0);\n        let boolean = finite_domain(&[0, 1]);\n        let mut values = UcpValueFacts::new();\n        values.mark_domain(b0.clone(), boolean.clone());\n        values.mark_domain(b1.clone(), boolean.clone());\n        values.mark_domain(b2.clone(), boolean);\n\n        let expr = UcpExpr::add(\n            UcpExpr::add(\n                UcpExpr::var(b0),\n                UcpExpr::scale_by(UcpExpr::var(b1), UcpScalar::known_i64(2)),\n            ),\n            UcpExpr::add(\n                UcpExpr::scale_by(UcpExpr::var(b2), UcpScalar::known_i64(4)),\n                UcpExpr::neg(UcpExpr::var(x.clone())),\n            ),\n        );\n\n        let inferences = infer_base_conv_value_domains(&expr, &values, None);\n\n        assert_eq!(\n            inferences,\n            vec![(x, finite_domain(&[0, 1, 2, 3, 4, 5, 6, 7]))]\n        );\n    }\n\n    // A teszt ellenőrzi, hogy túl nagy számjegytartományt nem sorol fel csonkított véges halmazként.\n    #[test]\n    fn base_conv_value_rule_respects_finite_domain_limit() {\n        let x = CellId::advice(0, 0);\n        let mut values = UcpValueFacts::new();\n        let boolean = finite_domain(&[0, 1]);\n        let mut expr = UcpExpr::neg(UcpExpr::var(x.clone()));\n\n        for index in 0..9 {\n            let bit = CellId::advice(index + 1, 0);\n            values.mark_domain(bit.clone(), boolean.clone());\n            let coefficient = 1_i64 << index;\n            expr = UcpExpr::add(\n                UcpExpr::scale_by(UcpExpr::var(bit), UcpScalar::known_i64(coefficient)),\n                expr,\n            );\n        }\n\n        assert!(infer_base_conv_value_domains(&expr, &values, None).is_empty());\n    }\n}\n\n#[cfg(test)]\nmod completeness_tests {\n    use super::*;\n    use crate::circuit_analyzer::ucp::{\n        engine::analyze_expressions_with_values_and_modulus, facts::UcpFacts,\n    };\n\n    fn domain(values: &[i64]) -> UcpValueDomain {\n        UcpValueDomain::finite_set(values.iter().copied().map(BigInt::from)).unwrap()\n    }\n\n    fn samples(values: &[i64]) -> BTreeSet<BigInt> {\n        values.iter().copied().map(BigInt::from).collect()\n    }\n\n    #[test]\n    fn uniqueness_and_partial_samples_do_not_certify_a_finite_domain() {\n        let cell = CellId::advice(0, 0);\n        let mut values = UcpValueFacts::new();\n        assert!(!values.domain_is_complete(&cell));\n        values.mark_domain(cell.clone(), domain(&[0, 1, 2]));\n        assert!(!values\n            .mark_complete_from_samples(&cell, &samples(&[0, 1]), &101.into())\n            .unwrap());\n        let result = analyze_expressions_with_values_and_modulus(\n            &[],\n            UcpFacts::from_iter([cell.clone()]),\n            values,\n            &101.into(),\n        );\n        assert!(result.facts.is_unique(&cell));\n        assert!(!result.value_facts.domain_is_complete(&cell));\n        assert_eq!(result.value_facts.domain(&cell), Some(&domain(&[0, 1, 2])));\n    }\n\n    #[test]\n    fn complete_domains_are_stable_but_hypothetical_copies_can_narrow() {\n        let cell = CellId::advice(0, 0);\n        let mut values = UcpValueFacts::new();\n        values.mark_domain(cell.clone(), domain(&[3, 7]));\n        assert!(values\n            .mark_complete_from_samples(&cell, &samples(&[3, 7]), &101.into())\n            .unwrap());\n        assert!(values.domain_is_complete(&cell));\n        assert!(!values.mark_known(cell.clone(), 3.into()));\n        assert_eq!(values.domain(&cell), Some(&domain(&[3, 7])));\n        assert!(!values\n            .mark_complete_from_samples(&cell, &samples(&[3, 7]), &101.into())\n            .unwrap());\n        let mut hypothetical = values.for_hypothetical_reasoning();\n        assert!(!hypothetical.domain_is_complete(&cell));\n        assert!(hypothetical.mark_known(cell.clone(), 3.into()));\n        assert!(hypothetical.domain_is_complete(&cell));\n        assert_eq!(values.domain(&cell), Some(&domain(&[3, 7])));\n        assert_eq!(hypothetical.known_value(&cell), Some(&3.into()));\n    }\n\n    #[test]\n    fn inconsistent_empty_and_oversized_samples_cannot_certify_a_domain() {\n        let cell = CellId::advice(0, 0);\n        let mut values = UcpValueFacts::new();\n        values.mark_domain(cell.clone(), domain(&[0, 1]));\n        assert!(!values\n            .mark_complete_from_samples(&cell, &BTreeSet::new(), &101.into())\n            .unwrap());\n        assert!(values\n            .mark_complete_from_samples(&cell, &samples(&[0, 1, 2]), &101.into())\n            .is_err());\n        let oversized = BTreeSet::from([BigInt::from(1) << (MAX_VALUE_BITS + 1) as usize]);\n        assert!(values\n            .mark_complete_from_samples(&cell, &oversized, &101.into())\n            .is_err());\n        assert!(!values.domain_is_complete(&cell));\n        assert_eq!(values.domain(&cell), Some(&domain(&[0, 1])));\n    }\n\n    #[test]\n    fn singleton_domains_and_field_aliases_have_one_feasible_value() {\n        let cell = CellId::advice(0, 0);\n        let mut values = UcpValueFacts::new();\n        values.mark_known(cell.clone(), 3.into());\n        assert!(values.domain_is_complete(&cell));\n        let mut aliases = UcpValueFacts::new();\n        aliases.mark_domain(cell.clone(), domain(&[-1, 12]));\n        assert!(!aliases.domain_is_complete(&cell));\n        assert!(aliases\n            .mark_complete_from_samples(&cell, &samples(&[-1, 12]), &13.into())\n            .unwrap());\n        assert!(aliases.domain_is_complete(&cell));\n        assert_eq!(aliases.known_value(&cell), Some(&(-1).into()));\n    }\n\n    #[test]\n    fn completion_core_and_diagnostic_wrapper_produce_the_same_state() {\n        let cell = CellId::advice(0, 0);\n        for (candidates, witnessed) in [\n            (vec![0, 1], vec![]),\n            (vec![0, 1], vec![0]),\n            (vec![3, 7], vec![3, 7]),\n            (vec![-1, 0, 100], vec![-1, 0]),\n        ] {\n            let mut core = UcpValueFacts::new();\n            core.mark_domain(cell.clone(), domain(&candidates));\n            let mut wrapped = core.clone();\n            let witnessed = samples(&witnessed);\n            let result = core\n                .try_mark_complete_from_samples(&cell, &witnessed, &101.into())\n                .unwrap();\n            assert_eq!(\n                wrapped\n                    .mark_complete_from_samples(&cell, &witnessed, &101.into())\n                    .unwrap(),\n                result\n            );\n            assert_eq!(wrapped, core);\n        }\n    }\n\n    #[test]\n    fn completion_errors_preserve_state_and_existing_diagnostics() {\n        let cell = CellId::advice(0, 0);\n        let mut original = UcpValueFacts::new();\n        original.mark_domain(cell.clone(), domain(&[0, 1]));\n        for (modulus, witnessed, expected, message) in [\n            (\n                1,\n                vec![0],\n                CompleteDomainError::DomainValue,\n                \"Unsupported complete-domain field value\".to_owned(),\n            ),\n            (\n                101,\n                vec![2],\n                CompleteDomainError::ExcludedFeasibleValue,\n                format!(\n                    \"Recorded domain for {} excludes a proven feasible value\",\n                    cell\n                ),\n            ),\n        ] {\n            let mut core = original.clone();\n            let mut wrapped = original.clone();\n            let witnessed = samples(&witnessed);\n            assert_eq!(\n                core.try_mark_complete_from_samples(&cell, &witnessed, &modulus.into()),\n                Err(expected)\n            );\n            assert_eq!(\n                wrapped\n                    .mark_complete_from_samples(&cell, &witnessed, &modulus.into())\n                    .unwrap_err()\n                    .to_string(),\n                message\n            );\n            assert_eq!(core, original);\n            assert_eq!(wrapped, original);\n        }\n\n        let mut oversized = UcpValueFacts::new();\n        let candidates: BTreeSet<_> = (0..=MAX_FINITE_DOMAIN_SIZE).map(BigInt::from).collect();\n        oversized\n            .domains\n            .insert(cell.clone(), UcpValueDomain::FiniteSet(candidates.clone()));\n        let original = oversized.clone();\n        assert_eq!(\n            oversized.try_mark_complete_from_samples(&cell, &candidates, &1009.into()),\n            Err(CompleteDomainError::RepresentationLimit)\n        );\n        assert_eq!(oversized, original);\n        assert_eq!(\n            oversized\n                .mark_complete_from_samples(&cell, &candidates, &1009.into())\n                .unwrap_err()\n                .to_string(),\n            \"Complete domain exceeds representation limits\"\n        );\n        assert_eq!(oversized, original);\n    }\n\n    #[test]\n    fn complete_domains_remain_operands_for_other_cells_without_exporting_completeness() {\n        let source = CellId::advice(0, 0);\n        let shifted = CellId::advice(1, 0);\n        let zero = CellId::advice(2, 0);\n        let mut values = UcpValueFacts::new();\n        values.mark_domain(source.clone(), domain(&[3, 7]));\n        values\n            .mark_complete_from_samples(&source, &samples(&[3, 7]), &101.into())\n            .unwrap();\n        let equations = [\n            UcpExpr::add(\n                UcpExpr::var(shifted.clone()),\n                UcpExpr::neg(UcpExpr::add(\n                    UcpExpr::var(source.clone()),\n                    UcpExpr::known_constant_i64(1),\n                )),\n            ),\n            UcpExpr::mul(\n                UcpExpr::var(zero.clone()),\n                UcpExpr::add(\n                    UcpExpr::var(source.clone()),\n                    UcpExpr::known_constant_i64(-5),\n                ),\n            ),\n        ];\n        let inferences = infer_value_domains_from_zero_equation_with_modulus(\n            &equations[0],\n            &values,\n            &101.into(),\n        );\n        assert!(inferences.iter().all(|(cell, _)| cell != &source));\n        let result = analyze_expressions_with_values_and_modulus(\n            &equations,\n            UcpFacts::new(),\n            values,\n            &101.into(),\n        );\n        assert_eq!(result.value_facts.domain(&source), Some(&domain(&[3, 7])));\n        assert!(result.value_facts.domain_is_complete(&source));\n        assert!(!result.facts.is_unique(&source));\n        assert_eq!(result.value_facts.domain(&shifted), Some(&domain(&[4, 8])));\n        assert!(!result.value_facts.domain_is_complete(&shifted));\n        assert_eq!(result.value_facts.known_value(&zero), Some(&0.into()));\n        assert!(result.facts.is_unique(&zero));\n        assert!(result.value_facts.domain_is_complete(&zero));\n    }\n}\n"},{"id":28,"name":{"Local":"/rustc/library/std/src/collections/hash/set.rs"},"crate_name":"std","contents":null},{"id":29,"name":{"Local":"/rustc/library/std/src/lib.rs"},"crate_name":"std","contents":null},{"id":30,"name":{"Local":"/rustc/library/std/src/collections/mod.rs"},"crate_name":"std","contents":null},{"id":31,"name":{"Local":"/rustc