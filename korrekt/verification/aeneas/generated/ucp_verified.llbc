onstansból nem képez jelöltet.\n        UcpExpr::Const(_) => AssignAnalysis::none(),\n        // Negálásnál a belső jelöltet tartja meg.\n        UcpExpr::Neg(inner) => analyze_assign_candidate(inner, facts, modulus),\n        //Skálázásnál csak biztosan nem nulla skála mellett lehet továbbmenni\n        UcpExpr::Scale(inner, scalar) => {\n            if scalar.is_non_zero_with_modulus(modulus) {\n                analyze_assign_candidate(inner, facts, modulus)\n            } else if matches!(scalar, UcpScalar::Unknown) {\n                AssignAnalysis::invalid()\n            } else {\n                AssignAnalysis::none()\n            }\n        }\n        // Összeadásnál egyesíti a két oldal jelöltjeit.\n        UcpExpr::Add(left, right) => analyze_assign_candidate(left, facts, modulus)\n            .merge_add(analyze_assign_candidate(right, facts, modulus)),\n        // Szorzásnál csak a biztonságosan visszafordítható esetekből következtet.\n        UcpExpr::Mul(left, right) => analyze_product_assign_candidate(left, right, facts, modulus),\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":70},{"Deduplicated":71},{"Deduplicated":211}],"output":{"Deduplicated":18}},"src":"Normal","body":{"Structured":{"span":{"Value":[788,{"data":{"file_id":5,"beg":{"line":123,"col":0},"end":{"line":157,"col":1}},"generated_from_span":null}]},"bound