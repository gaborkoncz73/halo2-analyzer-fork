Ident":["alloc",0]},{"Ident":["collections",0]},{"Ident":["btree",0]},{"Ident":["set",0]},{"Ident":["BTreeSet",0]}],"span":{"Untagged":{"data":{"file_id":37,"beg":{"line":78,"col":0},"end":{"line":81,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An ordered set based on a B-Tree."},{"DocComment":""},{"DocComment":" See [`BTreeMap`]'s documentation for a detailed discussion of this collection's performance"},{"DocComment":" benefits and drawbacks."},{"DocComment":""},{"DocComment":" It is a logic error for an item to be modified in such a way that the item's ordering relative"},{"DocComment":" to any other item, as determined by the [`Ord`] trait, changes while it is in the set. This is"},{"DocComment":" normally only possible through [`Cell`], [`RefCell`], global state, I/O, or unsafe code."},{"DocComment":" The behavior resulting from such a logic error is not specified, but will be encapsulated to the"},{"DocComment":" `BTreeSet` that observed the logic error and not result in undefined behavior. This could"},{"DocComment":" include panics, incorrect results, aborts, memory leaks, and non-termination."},{"DocComment":""},{"DocComment":" Iterators returned by [`BTreeSet::iter`] and [`BTreeSet::into_iter`] produce their items in order, and take worst-case"},{"DocComment":" logarithmic and amortized constant time per item returned."},{"DocComment":""},{"DocComment":" [`Cell`]: core::cell::Cell"},{"DocComment":" [`RefCell`]: core::cell::RefCell"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::BTreeSet;"},{"DocComment":""},{"DocComment":" // Type inference lets us omit an explicit type signature (which"},{"DocComment":" // would be `BTreeSet<&str>` in this example)."},{"DocComment":" let mut books = BTreeSet::new();"},{"DocComment":""},{"DocComment":" // Add some books."},{"DocComment":" books.insert(\"A Dance With Dragons\");"},{"DocComment":" books.insert(\"To Kill a Mockingbird\");"},{"DocComment":" books.insert(\"The Odyssey\");"},{"DocComment":" books.insert(\"The Great Gatsby\");"},{"DocComment":""},{"DocComment":" // Check for a specific one."},{"DocComment":" if !books.contains(\"The Winds of Winter\") {"},{"DocComment":"     println!(\"We have {} books, but The Winds of Winter ain't one.\","},{"DocComment":"              books.len());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Remove a book."},{"DocComment":" books.remove(\"The Odyssey\");"},{"DocComment":""},{"DocComment":" // Iterate over everything."},{"DocComment":" for book in &books {"},{"DocComment":"     println!(\"{book}\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A `BTreeSet` with a known list of items can be initialized from an array:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::BTreeSet;"},{"DocComment":""},{"DocComment":" let set = BTreeSet::from([1, 2, 3]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"BTreeSet","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"},{"index":1,"name":"A","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":25,"item_meta":{"name":[{"Ident":["ucp_verified",0]},{"Ident":["domains",0]},{"Ident":["CompleteDomainError",0]}],"span":{"Untagged":{"data":{"file_id":36,"beg":{"line":60,"col":0},"end":{"line":65,"col":1}},"generated_from_span":null}},"source_text":"pub(crate) enum CompleteDomainError {\n    DomainValue,\n    SampleValue,\n    ExcludedFeasibleValue,\n    RepresentationLimit,\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from