) {\n            (Self::Exact(left), Self::Exact(right)) if left == right => {\n                Some(Self::Exact(left.clone()))\n            }\n            (Self::Exact(value), Self::FiniteSet(set))\n            | (Self::FiniteSet(set), Self::Exact(value))\n                if set.contains(value) =>\n            {\n                Some(Self::Exact(value.clone()))\n            }\n            (Self::FiniteSet(left), Self::FiniteSet(right)) => {\n                Self::finite_set(left.intersection(right).map(|value| value.clone()))\n            }\n            _ => None,\n        }\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":40},{"Value":[515,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":16},"Shared"]}]}],"output":{"Deduplicated":336}},"src":"Normal","body":{"Structured":{"span":{"Value":[1108,{"data":{"file_id":36,"beg":{"line":129,"col":4},"end":{"line":145,"col":5}},"generated_from_span":null}]},"bound_body_regions":190,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Value":[1109,{"data":{"file_id":36,"beg":{"line":129,"col":41},"end":{"line":129,"col":53}},"generated_from_span":null}]},"ty":{"Deduplicated":336},"drop_flag_for":null},{"index":1,"name":"self","span":{"Value":[1110,{"data":{"file_id":36,"beg":{"line":129,"col":17},"end":{"line":129,"col":22}},"generated_from_span":null}]},"ty":{"Value":[516,{"Ref":[{"Body":1},{"Deduplicated":16},"Shared"]}]},"drop_flag_for":null},{"index":2,"name":"other","s