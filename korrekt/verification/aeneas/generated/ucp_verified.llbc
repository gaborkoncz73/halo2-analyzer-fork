null,"attr_info":{"attributes":[{"DocComment":" Tests less than or equal to (for `self` and `other`) and is used by the"},{"DocComment":" `<=` operator."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!(1.0 <= 1.0, true);"},{"DocComment":" assert_eq!(1.0 <= 2.0, true);"},{"DocComment":" assert_eq!(2.0 <= 1.0, false);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"cmp_partialord_le","has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":837},{"Deduplicated":849}],"output":{"Deduplicated":42}},"default":{"id":67,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}}],"types":[{"Deduplicated":29},{"Deduplicated":36}],"const_generics":[],"trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Deduplicated":90}}]}}},"kind":{"TraitMethod":[6,2]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"gt","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["PartialOrd",0]},{"Ident":["gt",0]}],"span":{"Untagged":{"data":{"file_id":21,"beg":{"line":1538,"col":4},"end":{"line":1538,"col":37}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Tests greater than (for `self` and `other`) and is used by the `>`"},{"DocComment":" operator."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!(1.0 > 1.0, false);"},{"DocComment":" assert_eq!(1.0 > 2.0, false);"},{"DocComment":" assert_eq!(2.0 > 1.0, true);"},{"DocComment":" ```"}],"inline