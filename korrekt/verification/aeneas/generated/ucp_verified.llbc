 reprezentánsra normalizálja az értékeket; -1 és p-1 ugyanazt az elemet jelöli."]]]}}},{"def_id":80,"item_meta":{"name":[{"Ident":["ucp_verified",0]},{"Ident":["domains",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":10},"kind":"InherentImplBlock"}}},{"Ident":["mark_domain",0]}],"span":{"Untagged":{"data":{"file_id":36,"beg":{"line":175,"col":4},"end":{"line":218,"col":5}},"generated_from_span":null}},"source_text":"pub fn mark_domain(&mut self, cell: CellId, domain: UcpValueDomain) -> bool {\n        if self.domain_is_complete(&cell) {\n            return false;\n        }\n        // A bemeneti domain reprezentálhatóságát ellenőrzi.\n        let domain = match domain {\n            // A konkrét érték bitméretét ellenőrzi.\n            UcpValueDomain::Exact(value) => UcpValueDomain::Exact(match bounded_value(value) {\n                Some(value) => value,\n                None => return false,\n            }),\n            //Ellenőrzi, hogy tud-e érvényes domaint létrehozni\n            UcpValueDomain::FiniteSet(values) => {\n                let Some(domain) = UcpValueDomain::finite_set(values) else {\n                    return false;\n                };\n                domain\n            }\n        };\n\n        //Megnézi, hogy a korábbi cellának volt-e már domain-je\n        match self.domains.get(&cell) {\n            Some(existing) => {\n                // Meglévő domainnél a két halmaz metszetét képezi.\n                // Üres metszetet nem tárol; az engine külön vizsgálja az ellentmondást.\n                let Some(intersection) = existing.intersect(&domain) else {\n                    return false;\n                };\n                //Ha meg lehet és megegyezik a kettő\n                if &intersection == existing {\n                    false\n                } else {\n                    //Felülírja a korábbit az új metszetre\n                    self.domains.insert(cell, intersection);\n                    true\n                }\n            }\n            // Meglévő bejegyzés hiányában felveszi az új domaint.\n            None => {\n                self.domains.insert(cell, domain);\n                true\n            }\n        }\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":190},{"Deduplicated":28},{"Deduplicated":16}],"output":{"Deduplicated":37}},"src":"Normal","body":{"Structured":{"span":{"Value":[776,{"data":{"file_id":36,"beg":{"line":175,"col":4},"end":{"line":218,"col":5}},"generated_from_span":null}]},"bound_body_regions":83,"locals":{"arg_count":3,"locals":[{"index":0,"name":null,"span":{"Value":[777,{"data":{"file_id":36,"beg":{"line":175,"col":75},"end":{"line":175,"col":79}},"generated_from_span":null}]},"ty":{"Deduplicated":37},"drop_flag_for":null},{"index":1,"name":"self","span":{"Value":[778,{"data":{"file_id":36,"beg":{"line":175,"col":23},"end":{"line":175,"col":32}},"generated_from_span":null}]},"ty":{"Deduplicated":194},"drop_flag_for":null},{"index":2,"name":"cell","span":{"Value":[779,{"data":{"file_id":36,"beg":{"line":175,"col":34},"end":{"line":175,"col":38}},"generated_from_span":null}]},"ty":{"Deduplicated":28},"drop_flag_for":null},{"index":3,"name":"domain","span":{"Value":[780,{"data":{"file_id":36,"beg":{"line":175,"col":48},"end":{"line":175,"col":54}},"generated_from_span":null}]},"ty":{"Deduplicated":16},"drop_flag_for":null},{"index":4,"name":null,"span":{"Value":[781,{"data":{"file_id":36,"beg":{"