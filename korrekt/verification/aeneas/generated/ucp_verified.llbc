ment":" assert_eq!(set_iter.next(), Some(&2));"},{"DocComment":" assert_eq!(set_iter.next(), Some(&3));"},{"DocComment":" assert_eq!(set_iter.next(), None);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"btreeset_iter","has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"T","variance":"Unknown"},{"index":1,"name":"A","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":3},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":36}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":29}},{"Var":{"Free":0}}]},{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":36}},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[588,{"Ref":[{"Var":{"Free":0}},{"Value":[589,{"Adt":{"id":24,"generics":{"regions":[],"types":[{"Deduplicated":29},{"Deduplicated":36}],"const_generics":[],"trait_refs":[]},"builtin":null}}]},"Shared"]}]}],"output":{"Value":[590,{"Adt":{"id":37,"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":29}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"src":"Normal","body":"Opaque"},{"def_id":97,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["map",0]}],"span":{"Untagged":{"data":{"file_id":49,"beg":{"line":845,"col":4},"end":{"line":848,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Takes a closure and creates an iterator which calls that closure on each"},{"DocComment":" element."},{"DocComment":""},{"DocComment":" `map()` transforms one iterator into another, by means of its argument:"},{"DocComment":" something that implements [`FnMut`]. It produces a new iterator which"},{"DocComment":" calls this closure on each element of the original iterator."},{"DocComment":""},{"DocComment":" If you are good at thinking in types, you can think of `map()` like this:"},{"DocComment":" If you have an iterator that gives you elements of some type `A`, and"},{"DocComment":" you want an iterator of some other type `B`, you can use `map()`,"},{"DocComment":" passing a closure that takes an `A` and returns a `B`."},{"DocComment":""},{"DocComment":" `map()` is conceptually similar to a [`for`] loop. However, as `map()` is"},{"DocComment":" lazy, it is best used when you're already working with other iterators."},{"DocComment":" If you're doing some sort of looping for a side effect, it's considered"},{"DocComment":" more idiomatic to use [`for`] than `map()`."},{"DocComment":""},{"DocComment":" [`for`]: ../../book/ch03-05-control-flow.html#looping-through-a-collection-with-for"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.iter().map(|x| 2 * x);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), Some(6));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you're doing some sort of side effect, prefer [`for`] to `map()`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(unused_must_use)]"},{"DocComment":" // don't do this:"},{"DocComment":" (0..5).map(|x| println!(\"{x}\"));"},{"DocComment":""},{"DocComment":" // it won't even execute, as it is lazy. Rust will warn you about this."},{"DocComment":""},{"DocComment":" // Instead, use a for-loop:"},{"DocComment":" for x in 0..5 {"},{"DocComment":"     println!(\"{x}\");"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"IteratorMap","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"B","variance":"Invariant"},{"index":2,"name":"F","variance":"Invariant"},{"index":3,"name":"Clause0_Item","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":170},"origin":"TraitSelf","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":17,"generics":{"regions":[],"types":[{"Deduplicated":29},{"Deduplicated":126}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[1183,{"data":{"file_id":49,"beg":{"line":848,"col":11},"end":{"line":848,"col":33}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":18,"generics":{"regions":[],"types":[{"Deduplicated":50},{"Value":[591,{"Adt":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":126}],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}]},{"Deduplicated":36}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":29},{"Deduplicated":50}],"output":{"Value":[592,{"Adt":{"id":36,"generics":{"regions":[],"types":[{"Deduplicated":29},{"Deduplicated":50}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"src":{"TraitDefault":{"trait_ref":{"id":17,"generics":{"regions":[],"types":[{"Deduplicated":29},{"Deduplicated":126}],"const_generics":[],"trait_refs":[]}},"item_id":12}},"body":"Opaque"},{"def_id":98,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["collect",0]}],"span":{"Untagged":{"data":{"file_id":49,"beg":{"line":2087,"col":4},"end":{"line":2089,"col":20}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Transforms an iterator into a collection."},{"DocComment":""},{"DocComment":" `collect()` takes ownership of an iterator and produces whichever"},{"DocComment":" collection type you request. The iterator itself carries no knowledge of"},{"DocComment":" the eventual container; the target collection is chosen entirely by the"},{"DocComment":" type you ask `collect()` to return. This makes `collect()` one of the"},{"DocComment":" more powerful methods in the standard library, and it shows up in a wide"},{"DocComment":" variety of contexts."},{"DocComment":""},{"DocComment":" The most basic pattern in which `collect()` is used is to turn one"},{"DocComment":" collection into another. You take a collection, call [`iter`] on it,"},{"DocComment":" do a bunch of transformations, and then `collect()` at the end."},{"DocComment":""},{"DocComment":" `collect()` can also create instances of types that are not typical"},{"DocComment":" collections. For example, a [`String`] can be built from [`char`]s,"},{"DocComment":" and an iterator of [`Result<T, E>`][`Result`] items can be collected"},{"DocComment":" into `Result<Collection<T>, E>`. See the examples below for more."},{"DocComment":""},{"DocComment":" Because `collect()` is so general, it can cause problems with type"},{"DocComment":" inference. As such, `collect()` is one of the few times you'll see"},{"DocComment":" the syntax affectionately known as the 'turbofish': `::<>`. This"},{"DocComment":" helps the inference algorithm understand specifically which collection"},{"DocComment":" you're trying to collect into."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled: Vec<i32> = a.iter()"},{"DocComment":"                          .map(|x| x * 2)"},{"DocComment":"                          .collect();"},{"DocComment":""},{"DocComment":" assert_eq!(vec![2, 4, 6], doubled);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that we needed the `: Vec<i32>` on the left-hand side. This is because"},{"DocComment":" we could collect into, for example, a [`VecDeque<T>`] instead:"},{"DocComment":""},{"DocComment":" [`VecDeque<T>`]: ../../std/collections/struct.VecDeque.html"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::VecDeque;"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled: VecDeque<i32> = a.iter().map(|x| x * 2).collect();"},{"DocComment":""},{"DocComment":" assert_eq!(2, doubled[0]);"},{"DocComment":" assert_eq!(4, doubled[1]);"},{"DocComment":" assert_eq!(6, doubled[2]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Using the 'turbofish' instead of annotating `doubled`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled = a.iter().map(|x| x * 2).collect::<Vec<i32>>();"},{"DocComment":""},{"DocComment":" assert_eq!(vec![2, 4, 6], doubled);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because `collect()` only cares about what you're collecting into, you can"},{"DocComment":" still use a partial type hint, `_`, with the turbofish:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled = a.iter().map(|x| x * 2).collect::<Vec<_>>();"},{"DocComment":""},{"DocComment":" assert_eq!(vec![2, 4, 6], doubled);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Using `collect()` to make a [`String`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let chars = ['g', 'd', 'k', 'k', 'n'];"},{"DocComment":""},{"DocComment":" let hello: String = chars.into_iter()"},{"DocComment":"     .map(|x| x as u8)"},{"DocComment":"     .map(|x| (x + 1) as char)"},{"DocComment":"     .collect();"},{"DocComment":""},{"DocComment":" assert_eq!(\"hello\", hello);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you have a list of [`Result<T, E>`][`Result`]s, you can use `collect()` to"},{"DocComment":" see if any of them failed:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let results = [Ok(1), Err(\"nope\"), Ok(3), Err(\"bad\")];"},{"DocComment":""},{"DocComment":" let result: Result<Vec<_>, &str> = results.into_iter().collect();"},{"DocComment":""},{"DocComment":" // gives us the first error"},{"DocComment":" assert_eq!(Err(\"nope\"), result);"},{"DocComment":""},{"DocComment":" let results = [Ok(1), Ok(3)];"},{"DocComment":""},{"DocComment":" let result: Result<Vec<_>, &str> = results.into_iter().collect();"},{"DocComment":""},{"DocComment":" // gives us the list of answers"},{"DocComment":" assert_eq!(Ok(vec![1, 3]), result);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`iter`]: Iterator::next"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":" [`char`]: type@char"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"iterator_collect_fn","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"B","variance":"Covariant"},{"index":2,"name":"Clause0_Item","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":170},"origin":"TraitSelf","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":17,"generics":{"regions":[],"types":[{"Deduplicated":29},{"Deduplicated":50}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[1184,{"data":{"file_id":49,"beg":{"line":2087,"col":18},"end":