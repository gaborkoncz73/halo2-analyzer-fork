    .or_insert_with(|| value.clone());\n        }\n        let feasible: BTreeSet<_> = samples\n            .iter()\n            .map(|value| {\n                normalize_field_value(value.clone(), modulus)\n                    .ok_or(CompleteDomainError::SampleValue)\n            })\n            .collect::<std::result::Result<_, _>>()?;\n        if !feasible.iter().all(|value| candidates.contains_key(value)) {\n            return Err(CompleteDomainError::ExcludedFeasibleValue);\n        }\n        if feasible.len() != candidates.len() || feasible.is_empty() {\n            return Ok(false);\n        }\n        let canonical = UcpValueDomain::finite_set(candidates.into_values())\n            .ok_or(CompleteDomainError::RepresentationLimit)?;\n        let changed = self.domains.get(cell) != Some(&canonical);\n        self.domains.insert(cell.clone(), canonical);\n        Ok(self.complete_domains.insert(cell.clone()) || changed)\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":233},{"Deduplicated":202},{"Deduplicated":234},{"Deduplicated":235}],"output":{"Deduplicated":236}},"src":"Normal","body":{"Structured":{"span":{"Value":[982,{"data":{"file_id":27,"beg":{"line":274,"col":4},"end":{"line":318,"col":5}},"generated_from_span":null}]},"bound_body_regi