Comment":" use std::ops::SubAssign;"},{"DocComment":""},{"DocComment":" #[derive(Debug, Copy, Clone, PartialEq)]"},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl SubAssign for Point {"},{"DocComment":"     fn sub_assign(&mut self, other: Self) {"},{"DocComment":"         *self = Self {"},{"DocComment":"             x: self.x - other.x,"},{"DocComment":"             y: self.y - other.y,"},{"DocComment":"         };"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut point = Point { x: 3, y: 3 };"},{"DocComment":" point -= Point { x: 2, y: 3 };"},{"DocComment":" assert_eq!(point, Point {x: 1, y: 0});"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"SubAssign","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Rhs","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"sub_assign","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["arith",0]},{"Ident":["SubAssign",0]},{"Ident":["sub_assign",0]}],"span":{"Untagged":{"data":{"file_id":89,"beg":{"line":850,"col":4},"end":{"line":850,"col":39}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the `-=` operation."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut x: u32 = 12;"},{"DocComment":" x -= 1;