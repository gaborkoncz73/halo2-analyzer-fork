];"},{"DocComment":" let mut shared = 0;"},{"DocComment":" let res: Result<Vec<u32>, &'static str> = v.iter().map(|x: &u32| {"},{"DocComment":"     shared += x;"},{"DocComment":"     x.checked_sub(2).ok_or(\"Underflow!\")"},{"DocComment":" }).collect();"},{"DocComment":" assert_eq!(res, Err(\"Underflow!\"));"},{"DocComment":" assert_eq!(shared, 6);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since the third element caused an underflow, no further elements were taken,"},{"DocComment":" so the final value of `shared` is 6 (= `3 + 2 + 1`), not 16."}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"},{"index":1,"name":"E","variance":"Unknown"},{"index":2,"name":"V","variance":"Unknown"},{"index":3,"name":"I","variance":"Contravariant"},{"index":4,"name":"Clause1_IntoIter","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[1270,{"data":{"file_id":23,"beg":{"line":2114,"col":14},"end":{"line":2114,"col":29}},"generated_from_span":null}]},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":20,"generics":{"regions":[],"types":[{"Deduplicated":43},{"Deduplicated":27}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[1271,{"data":{"file_id":23,"beg":{"line":2158,"col":20},"end":{"line":2158,"col":53}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":23,"generics":{"regions":[],"types":[{"Deduplicated":121},{"Deduplicated":174},{"Deduplicated":122}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":121}],"output":{"Value":[618,{"Adt":{"id":13,"generics":{"regions":[],"types"