ed trait or trait hierarchy that replaces or extends"},{"DocComment":" [`TrustedRandomAccess`] and `TrustedRandomAccessNoCoerce`."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":true,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[{"name":"MAY_HAVE_SIDE_EFFECT","attr_info":{"attributes":[{"DocComment":" `true` if getting an iterator element may have side effects."},{"DocComment":" Remember to take inner iterators into account."}],"inline":null,"rename":null,"public":true},"ty":{"Deduplicated":37},"default":null}],"types":[],"methods":[null],"vtable":null},{"def_id":37,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["clamp",0]},{"Ident":["ClampBounds",0]}],"span":{"Untagged":{"data":{"file_id":90,"beg":{"line":7,"col":0},"end":{"line":7,"col":37}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Trait for ranges supported by [`Ord::clamp_to`]."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[1348,{"data":{"file_id":90,"beg":{"line":11,"col":11},"end":{"line":11,"col":27}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":34}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"clamp","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["clamp",0]},{"Ident":["ClampBounds",0]},{"Ident":["clamp",0]}],"span":{"Untagged":{"data":{"file_id":90,"beg":{"line":9,"col":4},"end":{"line":11,"col":28}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The implementation of [`Ord::clamp_to`]."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":27},{"Deduplicated":34}],"output":{"Deduplicated":34}},"default":null},"kind":{"TraitMethod":[37,0]}}],"vtable":null},{"def_id":38,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["DiscriminantKind",0]}],"span":{"Untagged":{"data":{"file_id":21,"beg":{"line":883,"col":0},"end":{"line":883,"col":26}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Compiler-internal trait used to indicate the type of enum discriminants."},{"DocComment":""},{"DocComment":" This trait is automatically implemented for every type and does not add any"},{"DocComment":" guarantees to [`mem::Discriminant`]. It is **undefined behavior** to transmute"},{"DocComment":" between `DiscriminantKind::Discriminant` and `mem::Discriminant`."},{"DocComment":""},{"DocComment":" [`mem::Discriminant`]: crate::mem::Discriminant"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"DiscriminantKind","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[1349,{"data":{"file_id":21,"beg":{"line":887,"col":23},"end":{"line":887,"col":28}},"generated_from_span":null}]},"origin":{"TraitItem":0},"trait_":{"regions":[],"outlives":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Value":[688,{"TraitType":[{"Value":[88,{"kind":"SelfId","trait_decl_ref":{"id":38,"generics":{"regions":[],"types":[{"Deduplicated":27}],"const_generics":[],"trait_refs":[]}}}]},0,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}]}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[1350,{"data":{"file_id":21,"beg":{"line":887,"col":31},"end":{"line":887,"col":35}},"generated_from_span":null}]},"origin":{"TraitItem":0},"trait_":{"regions":[],"outlives":[],"skip_binder":{"id":33,"generics":{"regions":[],"types":[{"Deduplicated":688}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"Value":[1351,{"data":{"file_id":21,"beg":{"line":887,"col":38},"end":{"line":887,"col":43}},"generated_from_span":null}]},"origin":{"TraitItem":0},"trait_":{"regions":[],"outlives":[],"skip_binder":{"id":39,"generics":{"regions":[],"types":[{"Deduplicated":688}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"Value":[1352,{"data":{"file_id":21,"beg":{"line":887,"col":46},"end":{"line":887,"col":48}},"generated_from_span":null}]},"origin":{"TraitItem":0},"trait_":{"regions":[],"outlives":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":688}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":4,"span":{"Value":[1353,{"data":{"file_id":21,"beg":{"line":887,"col":51},"end":{"line":887,"col":60}},"generated_from_span":null}]},"origin":{"TraitItem":0},"trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":688},{"Deduplicated":688}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":5,"span":{"Value":[1354,{"data":{"file_id":21,"beg":{"line":887,"col":63},"end":{"line":887,"col":67}},"generated_from_span":null}]},"origin":{"TraitItem":0},"trait_":{"regions":[],"outlives":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":688}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":6,"span":{"Value":[1355,{"data":{"file_id":21,"beg":{"line":887,"col":70},"end":{"line":887,"col":74}},"generated_from_span":null}]},"origin":{"TraitItem":0},"trait_":{"regions":[],"outlives":[],"skip_binder":{"id":40,"generics":{"regions":[],"types":[{"Deduplicated":688}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":7,"span":{"Value":[1356,{"data":{"file_id":21,"beg":{"line":887,"col":77},"end":{"line":887,"col":81}},"generated_from_span":null}]},"origin":{"TraitItem":0},"trait_":{"regions":[],"outlives":[],"skip_binder":{"id":41,"generics":{"regions":[],"types":[{"Deduplicated":688}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":8,"span":{"Value":[1357,{"data":{"file_id":21,"beg":{"line":887,"col":84},"end":{"line":887,"col":89}},"generated_from_span":null}]},"origin":{"TraitItem":0},"trait_":{"regions":[],"outlives":[],"skip_binder":{"id":42,"generics":{"regions":[],"types":[{"Deduplicated":688}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"Discriminant","attr_info":{"attributes":[{"DocComment":" The type of the discriminant, which must satisfy the trait"},{"DocComment":" bounds required by `mem::Discriminant`."}],"inline":null,"rename":null,"public":false},"default":null,"implied_clauses":[]},"kind":{"TraitType":[38,0]}}],"methods":[],"vtable":null},{"def_id":39,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Debug",0]}],"span":{"Untagged":{"data":{"file_id":93,"beg":{"line":1053,"col":0},"end":{"line":1053,"col":29}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `?` formatting."},{"DocComment":""},{"DocComment":" `Debug` should format the output in a programmer-facing, debugging context."},{"DocComment":""},{"DocComment":" Generally speaking, you should just `derive` a `Debug` implementation."},{"DocComment":""},{"DocComment":" When used with the alternate format specifier `#?`, the output is pretty-printed."},{"DocComment":""},{"DocComment":" For more information on formatters, see [the module-level documentation][module]."},{"DocComment":""},{"DocComment":" [module]: ../../std/fmt/index.html"},{"DocComment":""},{"DocComment":" This trait can be used with `#[derive]` if all fields implement `Debug`. When"},{"DocComment":" `derive`d for structs, it will use the name of the `struct`, then `{`, then a"},{"DocComment":" comma-separated list of each field's name and `Debug` value, then `}`. For"},{"DocComment":" `enum`s, it will use the name of the variant and, if applicable, `(`, then the"},{"DocComment":" `Debug` values of the fields, then `)`."},{"DocComment":""},{"DocComment":" # Stability"},{"DocComment":""},{"DocComment":" Derived `Debug` formats are not stable, and so may change with future Rust"},{"DocComment":" versions. Additionally, `Debug` implementations of types provided by the"},{"DocComment":" standard library (`std`, `core`, `alloc`, etc.) are not stable, and"},{"DocComment":" may also change with future Rust versions."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Deriving an implementation:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     format!(\"The origin is: {origin:?}\"),"},{"DocComment":"     \"The origin is: Point { x: 0, y: 0 }\","},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Manually implementing:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Debug for Point {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         f.debug_struct(\"Point\")"},{"DocComment":"          .field(\"x\", &self.x)"},{"DocComment":"          .field(\"y\", &self.y)"},{"DocComment":"          .finish()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     format!(\"The origin is: {origin:?}\"),"},{"DocComment":"     \"The origin is: Point { x: 0, y: 0 }\","},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There are a number of helper methods on the [`Formatter`] struct to help you with manual"},{"DocComment":" implementations, such as [`debug_struct`]."},{"DocComment":""},{"DocComment":" [`debug_struct`]: Formatter::debug_struct"},{"DocComment":""},{"DocComment":" Types that do not wish to use the standard suite of debug representations"},{"DocComment":" provided by the `Formatter` trait (`debug_struct`, `debug_tuple`,"},{"DocComment":" `debug_list`, `debug_set`, `debug_map`) can do something totally custom by"},{"DocComment":" manually writing an arbitrary representation to the `Formatter`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use std::fmt;"},{"DocComment":" # struct Point {"},{"DocComment":" #     x: i32,"},{"DocComment":" #     y: i32,"},{"DocComment":" # }"},{"DocComment":" #"},{"DocComment":" impl fmt::Debug for Point {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         write!(f, \"Point [{} {}]\", self.x, self.y)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `Debug` implementations using either `derive` or the debug builder API"},{"DocComment":" on [`Formatter`] support pretty-printing using the alternate flag: `{:#?}`."},{"DocComment":""},{"DocComment":" Pretty-printing with `#?`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" let expected = \"The origin is: Point {"},{"DocComment":"     x: 0,"},{"DocComment":"     y: 0,"},{"DocComment":" }\";"},{"DocComment":" assert_eq!(format!(\"The origin is: {origin:#?}\"), expected);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Debug","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"fmt","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Debug",0]},{"Ident":["fmt",0]}],"span":{"Untagged":{"data":{"file_id":93,"beg":{"line":1084,"col":4},"end":{"line":1084,"col":51}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":"Formats the value using the given formatter.\n\n# Errors\n\nThis function should return [`Err`] if, and only if, the provided [`Formatter`] returns [`Err`].\nString formatting is considered an infallible operation; this function only\nreturns a [`Result`] because writing to the underlying stream might fail and it must\nprovide a way to propagate the fact that an error has occurred back up the stack.\n"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Position {"},{"DocComment":"     longitude: f32,"},{"DocComment":"     latitude: f32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Debug for Position {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         f.debug_tuple(\"\")"},{"DocComment":"          .field(&self.longitude)"},{"DocComment":"          .field(&self.latitude)"},{"DocComment":"          .finish()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let position = Position { longitude: 1.987, latitude: 2.983 };"},{"DocComment":" assert_eq!(format!(\"{position:?}\"), \"(1.987, 2.983)\");"},{"DocComment":""},{"DocComment":" assert_eq!(format!(\"{position:#?}\"), \"("},{"DocComment":"     1.987,"},{"DocComment":"     2.983,"},{"DocComment":" )\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":666},{"Value":[689,{"Ref":[{"Var":{"Bound":[0,1]}},{"Value":[690,{"Adt":{"id":88,"generics":{"regions":[{"Var":{"Bound":[0,2]}}],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}]},"Mut"]}]}],"output":{"Value":[691,{"Adt":{"id":13,"generics":{"regions":[],"types":[{"Deduplicated":105},{"Value":[692,{"Adt":{"id":89,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}]}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"default":null},"kind":{"TraitMethod":[39,0]}}],"vtable":{"id":87,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":40,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Send",0]}],"span":{"Untagged":{"data":{"file_id":21,"beg":{"line":92,"col":0},"end":{"line":92,"col":26}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types that can be transferred across thread boundaries."},{"DocComment":""},{"DocComment":" This trait is automatically implemented when the compiler determines it's"},{"DocComment":" appropriate."},{"DocComment":""},{"DocComment":" An example of a non-`Send` type is the reference-counting pointer"},{"DocComment":" [`rc::Rc`][`Rc`]. If two threads attempt to clone [`Rc`]s that point to the same"},{"DocComment":" reference-counted value, they might try to update the reference count at the"},{"DocComment":" same time, which is [undefined behavior][ub] because [`Rc`] doesn't use atomic"},{"DocComment":" operations. Its cousin [`sync::Arc`][arc] does use atomic operations (incurring"},{"DocComment":" some overhead) and thus is `Send`."},{"DocComment":""},{"DocComment":" See [the Nomicon](../../nomicon/send-and-sync.html) and the [`Sync`] trait for more details."},{"DocComment":""},{"DocComment":" [`Rc`]: ../../std/rc/struct.Rc.html"},{"DocComment":" [arc]: ../../std/sync/struct.Arc.html"},{"DocComment":" [ub]: ../../reference/behavior-considered-undefined.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Send","has_errors":false},"src":"Normal","is_unsafe":true,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":90,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":41,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Sync",0]}],"span":{"Untagged":{"data":{"file_id":21,"beg":{"line":657,"col":0},"end":{"line":657,"col":26}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types for which it is safe to share references between threads."},{"DocComment":""},{"DocComment":" This trait is automatically implemented when the compiler determines"},{"DocComment":" it's appropriate."},{"DocComment":""},{"DocComment":" The precise definition is: a type `T` is [`Sync`] if and only if `&T` is"},{"DocComment":" [`Send`]. In other words, if there is no possibility of"},{"DocComment":" [undefined behavior][ub] (including data races) when passing"},{"DocComment":" `&T` references between threads."},{"DocComment":""},{"DocComment":" As one would expect, primitive types like [`u8`] and [`f64`]"},{"DocComment":" are all [`Sync`], and so are simple aggregate types containing them,"},{"DocComment":" like tuples, structs and enums. More examples of basic [`Sync`]"},{"DocComment":" types include \"immutable\" types like `&T`, and those with simple"},{"DocComment":" inherited mutability, such as [`Box<T>`][box], [`Vec<T>`][vec] and"},{"DocComment":" most other collection types. (Generic parameters need to be [`Sync`]"},{"DocComment":" for their container to be [`Sync`].)"},{"DocComment":""},{"DocComment":" A somewhat surprising consequence of the definition is that `&mut T`"},{"DocComment":" is `Sync` (if `T` is `Sync`) even though it seems like that might"},{"DocComment":" provide unsynchronized mutation. The trick is that a mutable"},{"DocComment":" reference behind a shared reference (that is, `& &mut T`)"},{"DocComment":" becomes read-only, as if it were a `& &T`. Hence there is no risk"},{"DocComment":" of a data race."},{"DocComment":""},{"DocComment":" A shorter overview of how [`Sync`] and [`Send`] relate to referencing:"},{"DocComment":" * `&T` is [`Send`] if and only if `T` is [`Sync`]"},{"DocComment":" * `&mut T` is [`Send`] if and only if `T` is [`Send`]"},{"DocComment":" * `&T` and `&mut T` are [`Sync`] if and only if `T` is [`Sync`]"},{"DocComment":""},{"DocComment":" Types that are not `Sync` are those that have \"interior"},{"DocComment":" mutability\" in a non-thread-safe form, such as [`Cell`][cell]"},{"DocComment":" and [`RefCell`][refcell]. These types allow for mutation of"},{"DocComment":" their contents even through an immutable, shared reference. For"},{"DocComment":" example the `set` method on [`Cell<T>`][cell] takes `&self`, so it requires"},{"DocComment":" only a shared reference [`&Cell<T>`][cell]. The method performs no"},{"DocComment":" synchronization, thus [`Cell`][cell] cannot be `Sync`."},{"DocComment":""},{"DocComment":" Another example of a non-`Sync` type is the reference-counting"},{"DocComment":" pointer [`Rc`][rc]. Given any reference [`&Rc<T>`][rc], you can clone"},{"DocComment":" a new [`Rc<T>`][rc], modifying the reference counts in a non-atomic way."},{"DocComment":""},{"DocComment":" For cases when one does need thread-safe interior mutability,"},{"DocComment":" Rust provides [atomic data types], as well as explicit locking via"},{"DocComment":" [`sync::Mutex`][mutex] and [`sync::RwLock`][rwlock]. These types"},{"DocComment":" ensure that any mutation cannot cause data races, hence the types"},{"DocComment":" are `Sync`. Likewise, [`sync::Arc`][arc] provides a thread-safe"},{"DocComment":" analogue of [`Rc`][rc]."},{"DocComment":""},{"DocComment":" Any types with interior mutability must also use the"},{"DocComment":" [`cell::UnsafeCell`][unsafecell] wrapper around the value(s) which"},{"DocComment":" can be mutated through a shared reference. Failing to doing this is"},{"DocComment":" [undefined behavior][ub]. For example, [`transmute`][transmute]-ing"},{"DocComment":" from `&T` to `&mut T` is invalid."},{"DocComment":""},{"DocComment":" See [the Nomicon][nomicon-send-and-sync] for more details about `Sync`."},{"DocComment":""},{"DocComment":" [box]: ../../std/boxed/struct.Box.html"},{"DocComment":" [vec]: ../../std/vec/struct.Vec.html"},{"DocComment":" [cell]: crate::cell::Cell"},{"DocComment":" [refcell]: crate::cell::RefCell"},{"DocComment":" [rc]: ../../std/rc/struct.Rc.html"},{"DocComment":" [arc]: ../../std/sync/struct.Arc.html"},{"DocComment":" [atomic data types]: crate::sync::atomic"},{"DocComment":" [mutex]: ../../std/sync/struct.Mutex.html"},{"DocComment":" [rwlock]: ../../std/sync/struct.RwLock.html"},{"DocComment":" [unsafecell]: crate::cell::UnsafeCell"},{"DocComment":" [ub]: ../../reference/behavior-considered-undefined.html"},{"DocComment":" [transmute]: crate::mem::transmute"},{"DocComment":" [nomicon-send-and-sync]: ../../nomicon/send-and-sync.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Sync","diagnostic_item":"Sync","has_errors":false},"src":"Normal","is_unsafe":true,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":91,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":42,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Unpin",0]}],"span":{"Untagged":{"data":{"file_id":21,"beg":{"line":1014,"col":0},"end":{"line":1014,"col":20}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types that do not require any pinning guarantees."},{"DocComment":""},{"DocComment":" For information on what \"pinning\" is, see the [`pin` module] documentation."},{"DocComment":""},{"DocComment":" Implementing the `Unpin` trait for `T` expresses the fact that `T` is pinning-agnostic:"},{"DocComment":" it shall not expose nor rely on any pinning guarantees. This, in turn, means that a"},{"DocComment":" `Pin`-wrapped pointer to such a type can feature a *fully unrestricted* API."},{"DocComment":" In other words, if `T: Unpin`, a value of type `T` will *not* be bound by the invariants"},{"DocComment":" which pinning otherwise offers, even when \"pinned\" by a [`Pin<Ptr>`] pointing at it."},{"DocComment":" When a value of type `T` is pointed at by a [`Pin<Ptr>`], [`Pin`] will not restrict access"},{"DocComment":" to the pointee value like it normally would, thus allowing the user to do anything that they"},{"DocComment":" normally could with a non-[`Pin`]-wrapped `Ptr` to that value."},{"DocComment":""},{"DocComment":" The idea of this trait is to alleviate the reduced ergonomics of APIs that require the use"},{"DocComment":" of [`Pin`] for soundness for some types, but which also want to be used by other types that"},{"DocComment":" don't care about pinning. The prime example of such an API is [`Future::poll`]. There are many"},{"DocComment":" [`Future`] types that don't care about pinning. These futures can implement `Unpin` and"},{"DocComment":" therefore get around the pinning related restrictions in the API, while still allowing the"},{"DocComment":" subset of [`Future`]s which *do* require pinning to be implemented soundly."},{"DocComment":""},{"DocComment":" For more discussion on the consequences of [`Unpin`] within the wider scope of the pinning"},{"DocComment":" system, see the [section about `Unpin`] in the [`pin` module]."},{"DocComment":""},{"DocComment":" `Unpin` has no consequence at all for non-pinned data. In particular, [`mem::replace`] happily"},{"DocComment":" moves `!Unpin` data, which would be immovable when pinned ([`mem::replace`] works for any"},{"DocComment":" `&mut T`, not just when `T: Unpin`)."},{"DocComment":""},{"DocComment":" *However*, you cannot use [`mem::replace`] on `!Unpin` data which is *pinned* by being wrapped"},{"DocComment":" inside a [`Pin<Ptr>`] pointing at it. This is because you cannot (safely) use a"},{"DocComment":" [`Pin<Ptr>`] to get a `&mut T` to its pointee value, which you would need to call"},{"DocComment":" [`mem::replace`], and *that* is what makes this system work."},{"DocComment":""},{"DocComment":" So this, for example, can only be done on types implementing `Unpin`:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" # #![allow(unused_must_use)]"},{"DocComment":" use std::mem;"},{"DocComment":" use std::pin::Pin;"},{"DocComment":""},{"DocComment":" let mut string = \"this\".to_string();"},{"DocComment":" let mut pinned_string = Pin::new(&mut string);"},{"DocComment":""},{"DocComment":" // We need a mutable reference to call `mem::replace`."},{"DocComment":" // We can obtain such a reference by (implicitly) invoking `Pin::deref_mut`,"},{"DocComment":" // but that is only possible because `String` implements `Unpin`."},{"DocComment":" mem::replace(&mut *pinned_string, \"other\".to_string());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This trait is automatically implemented for almost every type. The compiler is free"},{"DocComment":" to take the conservative stance of marking types as [`Unpin`] so long as all of the types that"},{"DocComment":" compose its fields are also [`Unpin`]. This is because if a type implements [`Unpin`], then it"},{"DocComment":" is unsound for that type's implementation to rely on pinning-related guarantees for soundness,"},{"DocComment":" *even* when viewed through a \"pinning\" pointer! It is the responsibility of the implementor of"},{"DocComment":" a type that relies upon pinning for soundness to ensure that type is *not* marked as [`Unpin`]"},{"DocComment":" by adding [`PhantomPinned`] field. For more details, see the [`pin` module] docs."},{"DocComment":""},{"DocComment"