ine":62,"col":15}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"SampleValue","fields":[],"discriminant":{"Signed":["Isize","1"]}},{"id":2,"span":{"Untagged":{"data":{"file_id":27,"beg":{"line":63,"col":4},"end":{"line":63,"col":25}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"ExcludedFeasibleValue","fields":[],"discriminant":{"Signed":["Isize","2"]}},{"id":3,"span":{"Untagged":{"data":{"file_id":27,"beg":{"line":64,"col":4},"end":{"line":64,"col":23}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"RepresentationLimit","fields":[],"discriminant":{"Signed":["Isize","3"]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":1},"guarantee":{"Deduplicated":70}},"align":{"chosen":{"Deduplicated":1},"guarantee":{"Deduplicated":71}},"discriminator":{"Branch":{"offset":{"guarantee":null,"chosen":0},"int_ty":{"Unsigned":"U8"},"children":[[{"start":{"Unsigned":["U8","0"]},"end":{"Unsigned":["U8","0"]}},{"Known":0}],[{"start":{"Unsigned":["U8","1"]},"end":{"Unsigned":["U8","1"]}},{"Known":1}],[{"start":{"Unsigned":["U8","2"]},"end":{"Unsigned":["U8","2"]}},{"Known":2}],[{"start":{"Unsigned":["U8","3"]},"end":{"Unsigned":["U8","3"]}},{"Known":3}]],"fallback":"Invalid"}},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[[0,{"Unsigned":["U8","0"]}]]},{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[[0,{"Unsigned":["U8","1"]}]]},{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[[0,{"Unsigned":["U8","2"]}]]},{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[[0,{"Unsigned":["U8","3"]}]]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":33,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["collections",0]},{"Ident":["hash",0]},{"Ident":["map",0]},{"Ident":["HashMap",0]}],"span":{"Untagged":{"data":{"file_id":44,"beg":{"line":245,"col":0},"end":{"line":250,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A [hash map] implemented with quadratic probing and SIMD lookup."},{"DocComment":""},{"DocComment":" By default, `HashMap` uses a hashing algorithm selected to provide"},{"DocComment":" resistance against HashDoS attacks. The algorithm is randomly seeded, and a"},{"DocComment":" reasonable best-effort is made to generate this seed from a high quality,"},{"DocComment":" secure source of randomness provided by the host without blocking the"},{"DocComment":" program. Because of this, the randomness of the seed depends on the output"},{"DocComment":" quality of the system's random number generator when the seed is created."},{"DocComment":" In particular, seeds generated when the system's entropy pool is abnormally"},{"DocComment":" low such as during system boot may be of a lower quality."},{"DocComment":""},{"DocComment":" The default hashing algorithm is currently SipHash 1-3, though this is"},{"DocComment":" subject to change at any point in the future. While its performance is very"},{"DocComment":" competitive for medium sized keys, other hashing algorithms will outperform"},{"DocComment":" it for small keys such as integers as well as large keys such as long"},{"DocComment":" strings, though those algorithms will typically *not* protect against"},{"DocComment":" attacks such as HashDoS."},{"DocComment":""},{"DocComment":" The hashing algorithm can be replaced on a per-`HashMap` basis using the"},{"DocComment":" [`default`], [`with_hasher`], and [`with_capacity_and_hasher`] methods."},{"DocComment":" There are many alternative [hashing algorithms available on crates.io]."},{"DocComment":""},{"DocComment":" It is required that the keys implement the [`Eq`] and [`Hash`] traits, although"},{"DocComment":" this can frequently be achieved by using `#[derive(PartialEq, Eq, Hash)]`."},{"DocComment":" If you implement these yourself, it is important that the following"},{"DocComment":" property holds:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" k1 == k2 -> hash(k1) == hash(k2)"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In other words, if two keys are equal, their hashes must be equal."},{"DocComment":" Violating this property is a logic error."},{"DocComment":""},{"DocComment":" It is also a logic error for a key to be modified in such a way that the key's"},{"DocComment":" hash, as determined by the [`Hash`] trait, or its equality, as determined by"},{"DocComment":" the [`Eq`] trait, changes while it is in the map. This is normally only"},{"DocComment":" possible through [`Cell`], [`RefCell`], global state, I/O, or unsafe code."},{"DocComment":""},{"DocComment":" The behavior resulting from either logic error is not specified, but will"},{"DocComment":" be encapsulated to the `HashMap` that observed the logic error and not"},{"DocComment":" result in undefined behavior. This could include panics, incorrect results,"},{"DocComment":" aborts, memory leaks, and non-termination."},{"DocComment":""},{"DocComment":" The hash table implementation is a Rust port of Google's [SwissTable]."},{"DocComment":" The original C++ version of SwissTable can be found [here], and this"},{"DocComment":" [CppCon talk] gives an overview of how the algorithm works."},{"DocComment":""},{"DocComment":" [hash map]: crate::collections#use-a-hashmap-when"},{"DocComment":" [hashing algorithms available on crates.io]: https://crates.io/keywords/hasher"},{"DocComment":" [SwissTable]: https://abseil.io/blog/20180927-swisstables"},{"DocComment":" [here]: https://github.com/abseil/abseil-cpp/blob/master/absl/container/internal/raw_hash_set.h"},{"DocComment":" [CppCon talk]: https://www.youtube.com/watch?v=ncHmEUmJZf4"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" // Type inference lets us omit an explicit type signature (which"},{"DocComment":" // would be `HashMap<String, String>` in this example)."},{"DocComment":" let mut book_reviews = HashMap::new();"},{"DocComment":""},{"DocComment":" // Review some books."},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"Adventures of Huckleberry Finn\".to_string(),"},{"DocComment":"     \"My favorite book.\".to_string(),"},{"DocComment":" );"},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"Grimms' Fairy Tales\".to_string(),"},{"DocComment":"     \"Masterpiece.\".to_string(),"},{"DocComment":" );"},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"Pride and Prejudice\".to_string(),"},{"DocComment":"     \"Very enjoyable.\".to_string(),"},{"DocComment":" );"},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"The Adventures of Sherlock Holmes\".to_string(),"},{"DocComment":"     \"Eye lyked it alot.\".to_string(),"},{"DocComment":" );"},{"DocComment":""},{"DocComment":" // Check for a specific one."},{"DocComment":" // When collections store owned values (String), they can still be"},{"DocComment":" // queried using references (&str)."},{"DocComment":" if !book_reviews.contains_key(\"Les Misérables\") {"},{"DocComment":"     println!(\"We've got {} reviews, but Les Misérables ain't one.\","},{"DocComment":"              book_reviews.len());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // oops, this review has a lot of spelling mistakes, let's delete it."},{"DocComment":" book_reviews.remove(\"The Adventures of Sherlock Holmes\");"},{"DocComment":""},{"DocComment":" // Look up the values associated with some keys."},{"DocComment":" let to_find = [\"Pride and Prejudice\", \"Alice's Adventure in Wonderland\"];"},{"DocComment":" for &book in &to_find {"},{"DocComment":"     match book_reviews.get(book) {"},{"DocComment":"         Some(review) => println!(\"{book}: {review}\"),"},{"DocComment":"         None => println!(\"{book} is unreviewed.\")"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Look up the value for a key (will panic if the key is not found)."},{"DocComment":" println!(\"Review for Jane: {}\", book_reviews[\"Pride and Prejudice\"]);"},{"DocComment":""},{"DocComment":" // Iterate over everything."},{"DocComment":" for (book, review) in &book_reviews {"},{"DocComment":"     println!(\"{book}: \\\"{review}\\\"\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A `HashMap` with a known list of items can be initialized from an array:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" let solar_distance = HashMap::from(["},{"DocComment":"     (\"Mercury\", 0.4),"},{"DocComment":"     (\"Venus\", 0.7),"},{"DocComment":"     (\"Earth\", 1.0),"},{"DocComment":"     (\"Mars\", 1.5),"},{"DocComment":" ]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## `Entry` API"},{"DocComment":""},{"DocComment":" `HashMap` implements an [`Entry` API](#method.entry), which allows"},{"DocComment":" for complex methods of getting, setting, updating and removing keys and"},{"DocComment":" their values:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" // type inference lets us omit an explicit type signature (which"},{"DocComment":" // would be `HashMap<&str, u8>` in this example)."},{"DocComment":" let mut player_stats = HashMap::new();"},{"DocComment":""},{"DocComment":" fn random_stat_buff() -> u8 {"},{"DocComment":"     // could actually return some random value here - let's just return"},{"DocComment":"     // some fixed value for now"},{"DocComment":"     42"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // insert a key only if it doesn't already exist"},{"DocComment":" player_stats.entry(\"health\").or_insert(100);"},{"DocComment":""},{"DocComment":" // insert a key using a function that provides a new value only if it"},{"DocComment":" // doesn't already exist"},{"DocComment":" player_stats.entry(\"defence\").or_insert_with(random_stat_buff);"},{"DocComment":""},{"DocComment":" // update a key, guarding against the key possibly not being set"},{"DocComment":" let stat = player_stats.entry(\"attack\").or_insert(100);"},{"DocComment":" *stat += random_stat_buff();"},{"DocComment":""},{"DocComment":" // modify an entry before an insert with in-place mutation"},{"DocComment":" player_stats.entry(\"mana\").and_modify(|mana| *mana += 200).or_insert(100);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Usage with custom key types"},{"DocComment":""},{"DocComment":" The easiest way to use `HashMap` with a custom key type is to derive [`Eq`] and [`Hash`]."},{"DocComment":" We must also derive [`PartialEq`]."},{"DocComment":""},{"DocComment":" [`RefCell`]: crate::cell::RefCell"},{"DocComment":" [`Cell`]: crate::cell::Cell"},{"DocComment":" [`default`]: Default::default"},{"DocComment":" [`with_hasher`]: Self::with_hasher"},{"DocComment":" [`with_capacity_and_hasher`]: Self::with_capacity_and_hasher"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" #[derive(Hash, Eq, PartialEq, Debug)]"},{"DocComment":" struct Viking {"},{"DocComment":"     name: String,"},{"DocComment":"     country: String,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Viking {"},{"DocComment":"     /// Creates a new Viking."},{"DocComment":"     fn new(name: &str, country: &str) -> Viking {"},{"DocComment":"         Viking { name: name.to_string(), country: country.to_string() }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Use a HashMap to store the vikings' health points."},{"DocComment":" let vikings = HashMap::from(["},{"DocComment":"     (Viking::new(\"Einar\", \"Norway\"), 25),"},{"DocComment":"     (Viking::new(\"Olaf\", \"Denmark\"), 24),"},{"DocComment":"     (Viking::new(\"Harald\", \"Iceland\"), 12),"},{"DocComment":" ]);"},{"DocComment":""},{"DocComment":" // Use derived implementation to print the status of the vikings."},{"DocComment":" for (viking, health) in &vikings {"},{"DocComment":"     println!(\"{viking:?} has {health} hp\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Usage in `const` and `static`"},{"DocComment":""},{"DocComment":" As explained above, `HashMap` is randomly seeded: each `HashMap` instance uses a different seed,"},{"DocComment":" which means that `HashMap::new` normally cannot be used in a `const` or `static` initializer."},{"DocComment":""},{"DocComment":" However, if you need to use a `HashMap` in a `const` or `static` initializer while retaining"},{"DocComment":" random seed generation, you can wrap the `HashMap` in [`LazyLock`]."},{"DocComment":""},{"DocComment":" Alternatively, you can construct a `HashMap` in a `const` or `static` initializer using a different"},{"DocComment":" hasher that does not rely on a random seed. **Be aware that a `HashMap` created this way is not"},{"DocComment":" resistant to HashDoS attacks!**"},{"DocComment":""},{"DocComment":" [`LazyLock`]: crate::sync::LazyLock"},{"DocComment":" ```rust"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":" use std::hash::{BuildHasherDefault, DefaultHasher};"},{"DocComment":" use std::sync::{LazyLock, Mutex};"},{"DocComment":""},{"DocComment":" // HashMaps with a fixed, non-random hasher"},{"DocComment":" const NONRANDOM_EMPTY_MAP: HashMap<String, Vec<i32>, BuildHasherDefault<DefaultHasher>> ="},{"DocComment":"     HashMap::with_hasher(BuildHasherDefault::new());"},{"DocComment":" static NONRANDOM_MAP: Mutex<HashMap<String, Vec<i32>, BuildHasherDefault<DefaultHasher>>> ="},{"DocComment":"     Mutex::new(HashMap::with_hasher(BuildHasherDefault::new()));"},{"DocComment":""},{"DocComment":" // HashMaps using LazyLock to retain random seeding"},{"DocComment":" const RANDOM_EMPTY_MAP: LazyLock<HashMap<String, Vec<i32>>> ="},{"DocComment":"     LazyLock::new(HashMap::new);"},{"DocComment":" static RANDOM_MAP: LazyLock<Mutex<HashMap<String, Vec<i32>>>> ="},{"DocComment":"     LazyLock::new(|| Mutex::new(HashMap::new()));"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"HashMap","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"K","variance":"Covariant"},{"index":1,"name":"V","variance":"Covariant"},{"index":2,"name":"S","variance":"Covariant"},{"index":3,"name":"A","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":34,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Ident":["into_iter",0]},{"Ident":["IntoIter",0]}],"span":{"Untagged":{"data":{"file_id":45,"beg":{"line":47,"col":0},"end":{"line":50,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator that moves out of a vector."},{"DocComment":""},{"DocComment":" This `struct` is created by the `into_iter` method on [`Vec`](super::Vec)"},{"DocComment":" (provided by the [`IntoIterator`] trait)."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = vec![0, 1, 2];"},{"DocComment":" let iter: std::vec::IntoIter<_> = v.into_iter();"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":