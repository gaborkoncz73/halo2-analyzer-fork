or"},{"DocComment":""},{"DocComment":" The last case warrants some attention. It is an optimization that in many cases reduces peak memory"},{"DocComment":" consumption and improves cache locality. But when big, short-lived allocations are created,"},{"DocComment":" only a small fraction of their items get collected, no further use is made of the spare capacity"},{"DocComment":" and the resulting `Vec` is moved into a longer-lived structure, then this can lead to the large"},{"DocComment":" allocations having their lifetimes unnecessarily extended which can result in increased memory"},{"DocComment":" footprint."},{"DocComment":""},{"DocComment":" In cases where this is an issue, the excess capacity can be discarded with [`Vec::shrink_to()`],"},{"DocComment":" [`Vec::shrink_to_fit()`] or by collecting into [`Box<[T]>`][owned slice] instead, which additionally reduces"},{"DocComment":" the size of the long-lived struct."},{"DocComment":""},{"DocComment":" [owned slice]: Box"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" # use std::sync::Mutex;"},{"DocComment":" static LONG_LIVED: Mutex<Vec<Vec<u16>>> = Mutex::new(Vec::new());"},{"DocComment":""},{"DocComment":" for i in 0..10 {"},{"DocComment":"     let big_temporary: Vec<u16> = (0..1024).collect();"},{"DocComment":"     // discard most items"},{"DocComment":"     let mut result: Vec<_> = big_temporary.into_iter().filter(|i| i % 100 == 0).collect();"},{"DocComment":"     // without this a lot of unused capacity might be moved into the global"},{"DocComment":"     result.shrink_to_fit();"},{"DocComment":"     LONG_LIVED.lock().unwrap().push(result);"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":false},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":19,"generics":{"regions":[],"types":[{"Deduplicated":568},{"Deduplicated":29}],"const_generics":[],"t