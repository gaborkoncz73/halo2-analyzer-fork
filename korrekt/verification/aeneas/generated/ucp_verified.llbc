d":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":{"GuaranteedAlignment":{"Deduplicated":78}},"chosen":0}],"inhabited":{"Deduplicated":0},"tagger":[]},{"field_offsets":[{"guarantee":{"GuaranteedAlignment":{"Deduplicated":149}},"chosen":8}],"inhabited":{"Deduplicated":0},"tagger":[[0,{"Unsigned":["U64","18446744073709551615"]}]]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},null,{"def_id":28,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["hash",0]},{"Ident":["random",0]},{"Ident":["DefaultHasher",0]}],"span":{"Untagged":{"data":{"file_id":30,"beg":{"line":94,"col":0},"end":{"line":94,"col":24}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The default [`Hasher`] used by [`RandomState`]."},{"DocComment":""},{"DocComment":" The internal algorithm is not specified, and so it and its hashes should"},{"DocComment":" not be relied upon over releases."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Value":[151,{"Constant":{"Value":[69,[{"Integer":{"Unsigned":["Usize","72"]}},{"Deduplicated":0}]]}}]},"guarantee":null},"align":{"chosen":{"Deduplicated":42},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},null,{"def_id":30,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["collections",0]},{"Ident":["hash",0]},{"Ident":["map",0]},{"Ident":["HashMap",0]}],"span":{"Untagged":{"data":{"file_id":42,"beg":{"line":245,"col":0},"end":{"line":250,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A [hash map] implemented with quadratic probing and SIMD lookup."},{"DocComment":""},{"DocComment":" By default, `HashMap` uses a hashing algorithm selected to provide"},{"DocComment":" resistance against HashDoS attacks. The algorithm is randomly seeded, and a"},{"DocComment":" reasonable best-effort is made to generate this seed from a high quality,"},{"DocComment":" secure source of randomness provided by the host without blocking the"},{"DocComment":" program. Because of this, the randomness of the seed depends on the output"},{"DocComment":" quality of the system's random number generator when the seed is created."},{"DocComment":" In particular, seeds generated when the system's entropy pool is abnormally"},{"DocComment":" low such as during system boot may be of a lower quality."},{"DocComment":""},{"DocComment":" The default hashing algorithm is currently SipHash 1-3, though this is"},{"DocComment":" subject to change at any point in the future. While its performance is very"},{"DocComment":" competitive for medium sized keys, other hashing algorithms will outperform"},{"DocComment":" it for small keys such as integers as well as large keys such as long"},{"DocComment":" strings, though those algorithms will typically *not* protect against"},{"DocComment":" attacks such as HashDoS."},{"DocComment":""},{"DocComment":" The hashing algorithm can be replaced on a per-`HashMap` basis using the"},{"DocComment":" [`default`], [`with_hasher`], and [`with_capacity_and_hasher`] methods."},{"DocComment":" There are many alternative [hashing algorithms available on crates.io]."},{"DocComment":""},{"DocComment":" It is required that the keys implement the [`Eq`] and [`Hash`] traits, although"},{"DocComment":" this can frequently be achieved by using `#[derive(PartialEq, Eq, Hash)]`."},{"DocComment":" If you implement these yourself, it is important that the following"},{"DocComment":" property holds:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" k1 == k2 -> hash(k1) == hash(k2)"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In other words, if two keys are equal, their hashes must be equal."},{"DocComment":" Violating this property is a logic error."},{"DocComment":""},{"DocComment":" It is also a logic error for a key to be modified in such a way that the key's"},{"DocComment":" hash, as determined by the [`Hash`] trait, or its equality, as determined by"},{"DocComment":" the [`Eq`] trait, changes while it is in the map. This is normally only"},{"DocComment":" possible through [`Cell`], [`RefCell`], global state, I/O, or unsafe code."},{"DocComment":""},{"DocComment":" The behavior resulting from either logic error is not specified, but will"},{"DocComment":" be encapsulated to the `HashMap` that observed the logic error and not"},{"DocComment":" result in undefined behavior. This could include panics, incorrect results,"},{"DocComment":" aborts, memory leaks, and non-termination."},{"DocComment":""},{"DocComment":" The hash table implementation is a Rust port of Google's [SwissTable]."},{"DocComment":" The original C++ version of SwissTable can be found [here], and this"},{"DocComment":" [CppCon talk] gives an overview of how the algorithm works."},{"DocComment":""},{"DocComment":" [hash map]: crate::collections#use-a-hashmap-when"},{"DocComment":" [hashing algorithms available on crates.io]: https://crates.io/keywords/hasher"},{"DocComment":" [SwissTable]: https://abseil.io/blog/20180927-swisstables"},{"DocComment":" [here]: https://github.com/abseil/abseil-cpp/blob/master/absl/container/internal/raw_hash_set.h"},{"DocComment":" [CppCon talk]: https://www.youtube.com/watch?v=ncHmEUmJZf4"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" // Type inference lets us omit an explicit type signature (which"},{"DocComment":" // would be `HashMap<String, String>` in this example)."},{"DocComment":" let mut book_reviews = HashMap::new();"},{"DocComment":""},{"DocComment":" // Review some books."},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"Adventures of Huckleberry Finn\".to_string(),"},{"DocComment":"     \"My favorite book.\".to_string(),"},{"DocComment":" );"},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"Grimms' Fairy Tales\".to_string(),"},{"DocComment":"     \"Masterpiece.\".to_string(),"},{"DocComment":" );"},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"Pride and Prejudice\".to_string(),"},{"DocComment":"     \"Very enjoyable.\".to_string(),"},{"DocComment":" );"},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"The Adventures of Sherlock Holmes\".to_string(),"},{"DocComment":"     \"Eye lyked it alot.\".to_string(),"},{"DocComment":" );"},{"DocComment":""},{"DocComment":" // Check for a specific one."},{"DocComment":" // When collections store owned values (String), they can still be"},{"DocComment":" // queried using references (&str)."},{"DocComment":" if !book_reviews.contains_key(\"Les Misérables\") {"},{"DocComment":"     println!(\"We've got {} reviews, but Les Misérables ain't one.\","},{"DocComment":"              book_reviews.len());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // oops, this review has a lot of spelling mistakes, let's delete it."},{"DocComment":" book_reviews.remove(\"The Adventures of Sherlock Holmes\");"},{"DocComment":""},{"DocComment":" // Look up the values associated with some keys."},{"DocComment":" let to_find = [\"Pride and Prejudice\", \"Alice's Adventure in Wonderland\"];"},{"DocComment":" for &book in &to_find {"},{"DocComment":"     match book_reviews.get(book) {"},{"DocComment":"         Some(review) => println!(\"{book}: {review}\"),"},{"DocComment":"         None => println!(\"{book} is unreviewed.\")"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Look up the value for a key (will panic if the key is not found)."},{"DocComment":" println!(\"Review for Jane: {}\", book_reviews[\"Pride and Prejudice\"]);"},{"DocComment":""},{"DocComment":" // Iterate over everything."},{"DocComment":" for (book, review) in &book_reviews {"},{"DocComment":"     println!(\"{book}: \\\"{review}\\\"\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A `HashMap` with a known list of items can be initialized from an array:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" let solar_distance = HashMap::from(["},{"DocComment":"     (\"Mercury\", 0.4),"},{"DocComment":"     (\"Venus\", 0.7),"},{"DocComment":"     (\"Earth\", 1.0),"},{"DocComment":"     (\"Mars\", 1.5),"},{"DocComment":" ]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## `Entry` API"},{"DocComment":""},{"DocComment":" `HashMap` implements an [`Entry` API](#method.entry), which allows"},{"DocComment":" for complex methods of getting, setting, updating and removing keys and"},{"DocComment":" their values:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" // type inference lets us omit an explicit type signature (which"},{"DocComment":" // would be `HashMap<&str, u8>` in this example)."},{"DocComment":" let mut player_stats = HashMap::new();"},{"DocComment":""},{"DocComment":" fn random_stat_buff() -> u8 {"},{"DocComment":"     // could actually return some random value here - let's just return"},{"DocComment":"     // some fixed value for now"},{"DocComment":"     42"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // insert a key only if it doesn't already exist"},{"DocComment":" player_stats.entry(\"health\").or_insert(100);"},{"DocComment":""},{"DocComment":" // insert a key using a function that provides a new value only if it"},{"DocComment":" // doesn't already exist"},{"DocComment":" player_stats.entry(\"defence\").or_insert_with(random_stat_buff);"},{"DocComment":""},{"DocComment":" // update a key, guarding against the key possibly not being set"},{"DocComment":" let stat = player_stats.entry(\"attack\").or_insert(100);"},{"DocComment":" *stat += random_stat_buff();"},{"DocComment":""},{"DocComment":" // modify an entry before an insert with in-place mutation"},{"DocComment":" player_stats.entry(\"mana\").and_modify(|mana| *mana += 200).or_insert(100);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Usage with custom key types"},{"DocComment":""},{"DocComment":" The easiest way to use `HashMap` with a custom key type is to derive [`Eq`] and [`Hash`]."},{"DocComment":" We must also derive [`PartialEq`]."},{"DocComment":""},{"DocComment":" [`RefCell`]: crate::cell::RefCell"},{"DocComment":" [`Cell`]: crate::cell::Cell"},{"DocComment":" [`default`]: Default::default"},{"DocComment":" [`with_hasher`]: Self::with_hasher"},{"DocComment":" [`with_capacity_and_hasher`]: Self::with_capacity_and_hasher"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" #[derive(Hash, Eq, PartialEq, Debug)]"},{"DocComment":" struct Viking {"},{"DocComment":"     name: String,"},{"DocComment":"     country: String,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Viking {"},{"DocComment":"     /// Creates a new Viking."},{"DocComment":"     fn new(name: &str, country: &str) -> Viking {"},{"DocComment":"         Viking { name: name.to_string(), country: country.to_string() }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Use a HashMap to store the vikings' health points."},{"DocComment":" let vikings = HashMap::from(["},{"DocComment":"     (Viking::new(\"Einar\", \"Norway\"), 25),"},{"DocComment":"     (Viking::new(\"Olaf\", \"Denmark\"), 24),"},{"DocComment":"     (Viking::new(\"Harald\", \"Iceland\"), 12),"},{"DocComment":" ]);"},{"DocComment":""},{"DocComment":" // Use derived implementation to print the status of the vikings."},{"DocComment":" for (viking, health) in &vikings {"},{"DocComment":"     println!(\"{viking:?} has {health} hp\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Usage in `const` and `static`"},{"DocComment":""},{"DocComment":" As explained above, `HashMap` is randomly seeded: each `HashMap` instance uses a different seed,"},{"DocComment":" which means that `HashMap::new` normally cannot be used in a `const` or `static` initializer."},{"DocComment":""},{"DocComment":" However, if you need to use a `HashMap` in a `const` or `static` initializer while retaining"},{"DocComment":" random seed generation, you can wrap the `HashMap` in [`LazyLock`]."},{"DocComment":""},{"DocComment":" Alternatively, you can construct a `HashMap` in a `const` or `static` initializer using a different"},{"DocComment":" hasher that does not rely on a random seed. **Be aware that a `HashMap` created this way is not"},{"DocComment":" resistant to HashDoS attacks!**"},{"DocComment":""},{"DocComment":" [`LazyLock`]: crate::sync::LazyLock"},{"DocComment":" ```rust"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":" use std::hash::{BuildHasherDefault, DefaultHasher};"},{"DocComment":" use std::sync::{LazyLock, Mutex};"},{"DocComment":""},{"DocComment":" // HashMaps with a fixed, non-random hasher"},{"DocComment":" const NONRANDOM_EMPTY_MAP: HashMap<String, Vec<i32>, BuildHasherDefault<DefaultHasher>> ="},{"DocComment":"     HashMap::with_hasher(BuildHasherDefault::new());"},{"DocComment":" static NONRANDOM_MAP: Mutex<HashMap<String, Vec<i32>, BuildHasherDefault<DefaultHasher>>> ="},{"DocComment":"     Mutex::new(HashMap::with_hasher(BuildHasherDefault::new()));"},{"DocComment":""},{"DocComment":" // HashMaps using LazyLock to retain random seeding"},{"DocComment":" const RANDOM_EMPTY_MAP: LazyLock<HashMap<String, Vec<i32>>> ="},{"DocComment":"     LazyLock::new(HashMap::new);"},{"DocComment":" static RANDOM_MAP: LazyLock<Mutex<HashMap<String, Vec<i32>>>> ="},{"DocComment":"     LazyLock::new(|| Mutex::new(HashMap::new()));"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"HashMap","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"K","variance":"Covariant"},{"index":1,"name":"V","variance":"Covariant"},{"index":2,"name":"S","variance":"Covariant"},{"index":3,"name":"A","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":31,"item_meta":{"name":[{"Ident":["ucp_verified",0]},{"Ident":["domains",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":10},"kind":"InherentImplBlock"}}},{"Ident":["domain_is_complete",0]},{"Builtin":["Closure",0]}],"span":{"Untagged":{"data":{"file_id":36,"beg":{"line":236,"col":25},"end":{"line":236,"col":95}},"generated_from_span":null}},"source_text":"|domain| domain.is_singleton() || self.complete_domains.contains(cell)","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Unknown","mutability":"Unknown","late_bound":false},{"index":1,"name":null,"variance":"Unknown","mutability":"Unknown","late_bound":false},{"index":2,"name":null,"variance":"Unknown","mutability":"Unknown","late_bound":false}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":{"Closure":{"info":{"kind":"FnOnce","closure_body":{"id":156,"generics":{"regions":[{"Var":{"Free":0}},{"Var":{"Free":1}},{"Var":{"Free":2}}],"types":[],"const_generics":[],"trait_refs":[]}},"fn_once_impl":{"regions":[],"outlives":[],"skip_binder":{"id":29,"generics":{"regions":[{"Var":{"Free":0}},{"Var":{"Free":1}},{"Var":{"Free":2}}],"types":[],"const_generics":[],"trait_refs":[]}}},"fn_mut_impl":null,"fn_impl":null,"signature":{"regions":[],"outlives":[],"skip_binder":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[40,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":16},"Shared"]}]}],"output":{"Deduplicated":37}}}}}},"kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":36,"beg":{"line":236,"col":25},"end":{"line":236,"col":95}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"_0","is_positional":true,"ty":{"Value":[41,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":10},"Shared"]}]}},{"span":{"Untagged":{"data":{"file_id":36,"beg":{"line":236,"col":25},"end":{"line":236,"col":95}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"_1","is_positional":true,"ty":{"Value":[42,{"Ref":[{"Var":{"Free":2}},{"Deduplicated":28},"Shared"]}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":52},"guarantee":{"Value":[152,{"AtLeast":{"Value":[153,{"AlignTo":{"base":{"Value":[154,{"Max":[{"Value":[155,{"Plus":[{"Value":[156,{"Constant":{"Value":[70,[{"OffsetOf":[{"id":31,"generics":{"regions":[{"Var":{"Free":0}},{"Var":{"Free":1}},{"Var":{"Free":2}}],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null},null,0]},{"Deduplicated":0}]]}}]},{"Value":[157,{"Constant":{"Value":[71,[{"SizeOf":{"Deduplicated":41}},{"Deduplicated":0}]]}}]}]}]},{"Value":[158,{"Plus":[{"Value":[159,{"Constant":{"Value":[72,[{"OffsetOf":[{"id":31,"generics":{"regions":[{"Var":{"Free":0}},{"Var":{"Free":1}},{"Var":{"Free":2}}],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null},null,1]},{"Deduplicated":0}]]}}]},{"Value":[160,{"Constant":{"Value":[73,[{"SizeOf":{"Deduplicated":42}},{"Deduplicated":0}]]}}]}]}]}]}]},"target_align":{"Value":[161,{"Max":[{"Value":[162,{"Constant":{"Value":[74,[{"AlignOf":{"Deduplicated":41}},{"Deduplicated":0}]]}}]},{"Value":[163,{"Constant":{"Value":[75,[{"AlignOf":{"Deduplicated":42}},{"Deduplicated":0}]]}}]}]}]}}}]}}]}},"align":{"chosen":{"Deduplicated":42},"guarantee":{"Value":[164,{"AtLeast":{"Deduplicated":161}}]}},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":{"GuaranteedAlignment":{"Deduplicated":162}},"chosen":0},{"guarantee":{"GuaranteedAlignment":{"Deduplicated":163}},"chosen":8}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":null},{"def_id":32,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Ident":["Vec",0]}],"span":{"Untagged":{"data":{"file_id":48,"beg":{"line":439,"col":0},"end":{"line":439,"col":96}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A contiguous growable array type, written as `Vec<T>`, short for 'vector'."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut vec = Vec::new();"},{"DocComment":" vec.push(1);"},{"DocComment":" vec.push(2);"},{"DocComment":""},{"DocComment":" assert_eq!(vec.len(), 2);"},{"DocComment":" assert_eq!(vec[0], 1);"},{"DocComment":""},{"DocComment":" assert_eq!(vec.pop(), Some(2));"},{"DocComment":" assert_eq!(vec.len(), 1);"},{"DocComment":""},{"DocComment":" vec[0] = 7;"},{"DocComment":" assert_eq!(vec[0], 7);"},{"DocComment":""},{"DocComment":" vec.extend([1, 2, 3]);"},{"DocComment":""},{"DocComment":" for x in &vec {"},{"DocComment":"     println!(\"{x}\");"},{"DocComment":" }"},{"DocComment":" assert_eq!(vec, [7, 1, 2, 3]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The [`vec!`] macro is provided for convenient initialization:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut vec1 = vec![1, 2, 3];"},{"DocComment":" vec1.push(4);"},{"DocComment":" let vec2 = Vec::from([1, 2, 3, 4]);"},{"DocComment":" assert_eq!(vec1, vec2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It can also initialize each element of a `Vec<T>` with a given value."},{"DocComment":" This may be more efficient than performing allocation and initialization"},{"DocComment":" in separate steps, especially when initializing a vector of zeros:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let vec = vec![0; 5];"},{"DocComment":" assert_eq!(vec, [0, 0, 0, 0, 0]);"},{"DocComment":""},{"DocComment":" // The following is equivalent, but potentially slower:"},{"DocComment":" let mut vec = Vec::with_capacity(5);"},{"DocComment":" vec.resize(5, 0);"},{"DocComment":" assert_eq!(vec, [0, 0, 0, 0, 0]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" For more information, see"},{"DocComment":" [Capacity and Reallocation](#capacity-and-reallocation)."},{"DocComment":""},{"DocComment":" Use a `Vec<T>` as an efficient stack:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut stack = Vec::new();"},{"DocComment":""},{"DocComment":" stack.push(1);"},{"DocComment":" stack.push(2);"},{"DocComment":" stack.push(3);"},{"DocComment":""},{"DocComment":" while let Some(top) = stack.pop() {"},{"DocComment":"     // Prints 3, 2, 1"},{"DocComment":"     println!(\"{top}\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Indexing"},{"DocComment":""},{"DocComment":" The `Vec` type allows access to values by index, because it implements the"},{"DocComment":" [`Index`] trait. An example will be more explicit:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = vec![0, 2, 4, 6];"},{"DocComment":" println!(\"{}\", v[1]); // it will display '2'"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However be careful: if you try to access an index which isn't in the `Vec`,"},{"DocComment":" your software will panic! You cannot do this:"},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" let v = vec![0, 2, 4, 6];"},{"DocComment":" println!(\"{}\", v[6]); // it will panic!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Use [`get`] and [`get_mut`] if you want to check whether the index is in"},{"DocComment":" the `Vec`."},{"DocComment":""},{"DocComment":" # Slicing"},{"DocComment":""},{"DocComment":" A `Vec` can be mutable. On the other hand, slices are read-only objects."},{"DocComment":" To get a [slice][prim@slice], use [`&`]. Example:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn read_slice(slice: &[usize]) {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let v = vec![0, 1];"},{"DocComment":" read_slice(&v);"},{"DocComment":""},{"DocComment":" // ... and that's all!"},{"DocComment":" // you can also do it like this:"},{"DocComment":" let u: &[usize] = &v;"},{"DocComment":" // or like this:"},{"DocComment":" let u: &[_] = &v;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In Rust, it's more common to pass slices as arguments rather than vectors"},{"DocComment":" when you just want to provide read access. The same goes for [`String`] and"},{"DocComment":" [`&str`]."},{"DocComment":""},{"DocComment":" # Capacity and reallocation"},{"DocComment":""},{"DocComment":" The capacity of a vector is the amount of space allocated for any future"},{"DocComment":" elements that will be added onto the vector. This is not to be confused with"},{"DocComment":" the *length* of a vector, which specifies the number of actual elements"},{"DocComment":" within the vector. If a vector's length exceeds its capacity, its capacity"},{"DocComment":" will automatically be increased, but its elements will have to be"},{"DocComment":" reallocated."},{"DocComment":""},{"DocComment":" For example, a vector with capacity 10 and length 0 would be an empty vector"},{"DocComment":" with space for 10 more elements. Pushing 10 or fewer elements onto the"},{"DocComment":" vector will not change its capacity or cause reallocation to occur. However,"},{"DocComment":" if the vector's length is increased to 11, it will have to reallocate, which"},{"DocComment":" can be slow. For this reason, it is recommended to use [`Vec::with_capacity`]"},{"DocComment":" whenever possible to specify how big the vector is expected to get."},{"DocComment":""},{"DocComment":" # Guarantees"},{"DocComment":""},{"DocComment":" Due to its incredibly fundamental nature, `Vec` makes a lot of guarantees"},{"DocComment":" about its design. This ensures that it's as low-overhead as possible in"},{"DocComment":" the general case, and can be correctly manipulated in primitive ways"},{"DocComment":" by unsafe code. Note that these guarantees refer to an unqualified `Vec<T>`."},{"DocComment":" If additional type parameters are added (e.g., to support custom allocators),"},{"DocComment":" overriding their defaults may change the behavior."},{"DocComment":""},{"DocComment":" Most fundamentally, `Vec` is and always will be a (pointer, capacity, length)"},{"DocComment":" triplet. No more, no less. The order of these fields is completely"},{"DocComment":" unspecified, and you should use the appropriate methods to modify these."},{"DocComment":" The pointer will never be null, so this type is null-pointer-optimized."},{"DocComment":""},{"DocComment":" However, the pointer might not actually point to allocated memory. In particular,"},{"DocComment":" if you construct a `Vec` with capacity 0 via [`Vec::new`], [`vec![]`][`vec!`],"},{"DocComment":" [`Vec::with_capacity(0)`][`Vec::with_capacity`], or by calling [`shrink_to_fit`]"},{"DocComment":" on an empty Vec, it will not allocate memory. Similarly, if you store zero-sized"},{"DocComment":" types inside a `Vec`, it will not allocate space for them. *Note that in this case"},{"DocComment":" the `Vec` might not report a [`capacity`] of 0*. `Vec` will allocate if and only"},{"DocComment":" if <code>[size_of::\\<T>]\\() * [capacity]\\() > 0</code>. In general, `Vec`'s allocation"},{"DocComment":" details are very subtle --- if you intend to allocate memory using a `Vec`"},{"DocComment":" and use it for something else (either to pass to unsafe code, or to build your"},{"DocComment":" own memory-backed collection), be sure to deallocate this memory by using"},{"DocComment":" `from_raw_parts` to recover the `Vec` and then dropping it."},{"DocComment":""},{"DocComment":" If a `Vec` *has* allocated memory, then the memory it points to is on the heap"},{"DocComment":" (as defined by the allocator Rust is configured to use by default), and its"},{"DocComment":" pointer points to [`len`] initialized, contiguous elements in order (what"},{"DocComment":" you would see if you coerced it to a slice), followed by <code>[capacity] - [len]</code>"},{"DocComment":" logically uninitialized, contiguous elements."},{"DocComment":""},{"DocComment":" A vector containing the elements `'a'` and `'b'` with capacity 4 can be"},{"DocComment":" visualized as below. The top part is the `Vec` struct, it contains a"},{"DocComment":" pointer to the head of the allocation in the heap, length and capacity."},{"DocComment":" The bottom part is the allocation on the heap, a contiguous memory block."},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":"             ptr      len  capacity"},{"DocComment":"        +--------+--------+--------+"},{"DocComment":"        | 0x0123 |      2 |      4 |"},{"DocComment":"        +--------+--------+--------+"},{"DocComment":"             |"},{"DocComment":"             v"},{"DocComment":" Heap   +--------+--------+--------+--------+"},{"DocComment":"        |    'a' |    'b' | uninit | uninit |"},{"DocComment":"        +--------+--------+--------+--------+"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" - **uninit** represents memory that is not initialized, see [`MaybeUninit`]."},{"DocComment":" - Note: the ABI is not stable and `Vec` makes no guarantees about its memory"},{"DocComment":"   layout (including the order of fields)."},{"DocComment":""},{"DocComment":" `Vec` will never perform a \"small optimization\" where elements are actually"},{"DocComment":" stored on the stack for two reasons:"},{"DocComment":""},{"DocComment":" * It would make it more difficult for unsafe code to correctly manipulate"},{"DocComment":"   a `Vec`. The contents of a `Vec` wouldn't have a stable address if it were"},{"DocComment":"   only moved, and it would be more difficult to determine if a `Vec` had"},{"DocComment":"   actually allocated memory."},{"DocComment":""},{"DocComment":" * It would penalize the general case, incurring an additional branch"},{"DocComment":"   on every access."},{"DocComment":""},{"DocComment":" `Vec` will never automatically shrink itself, even if completely empty. This"},{"DocComment":" ensures no unnecessary allocations or deallocations occur. Emptying a `Vec`"},{"DocComment":" and then filling it back up to the same [`len`] should incur no calls to"},{"DocComment":" the allocator. If you wish to free up unused memory, use"},{"DocComment":" [`shrink_to_fit`] or [`shrink_to`]."},{"DocComment":""},{"DocComment":" [`push`] and [`insert`] will never (re)allocate if the reported capacity is"},{"DocComment":" sufficient. [`push`] and [`insert`] *will* (re)allocate if"},{"DocComment":" <code>[len] == [capacity]</code>. That is, the reported capacity is completely"},{"DocComment":" accurate, and can be relied on. It can even be used to manually free the memory"},{"DocComment":" allocated by a `Vec` if desired. Bulk insertion methods *may* reallocate, even"},{"DocComment":" when not necessary."},{"DocComment":""},{"DocComment":" `Vec` does not guarantee any particular growth strategy when reallocating"},{"DocComment":" when full, nor when [`reserve`] is called. The current strategy is basic"},{"DocComment":" and it may prove desirable to use a non-constant growth factor. Whatever"},{"DocComment":" strategy is used will of course guarantee *O*(1) amortized [`push`]."},{"DocComment":""},{"DocComment":" It is guaranteed, in order to respect the intentions of the programmer, that"},{"DocComment":" all of `vec![e_1, e_2, ..., e_n]`, `vec![x; n]`, and [`Vec::with_capacity(n)`] produce a `Vec`"},{"DocComment":" that requests an allocation of the exact size needed for precisely `n` elements from the allocator,"},{"DocComment":" and no other size (such as, for example: a size rounded up to the nearest power of 2)."},{"DocComment":" The allocator will return an allocation that is at least as large as requested, but it may be larger."},{"DocComment":""},{"DocComment":" It is guaranteed that the [`Vec::capacity`] method returns a value that is at least the requested capacity"},{"DocComment":" and not more than the allocated capacity."},{"DocComment":""},{"DocComment":" The method [`Vec::shrink_to_fit`] will attempt to discard excess capacity an allocator has given to a `Vec`."},{"DocComment":" If <code>[len] == [capacity]</code>, then a `Vec<T>` can be converted"},{"DocComment":" to and from a [`Box<[T]>`][owned slice] without reallocating or moving the elements."},{"DocComment":" `Vec` exploits this fact as much as reasonable when implementing common conversions"},{"DocComment":" such as [`into_boxed_slice`]."},{"DocComment":""},{"DocComment":" `Vec` will not specifically overwrite any data that is removed from it,"},{"DocComment":" but also won't specifically preserve it. Its uninitialized memory is"},{"DocComment":" scratch space that it may use however it wants. It will generally just do"},{"DocComment":" whatever is most efficient or otherwise easy to implement. Do not rely on"},{"DocComment":" removed data to be erased for security purposes. Even if you drop a `Vec`, its"},{"DocComment":" buffer may simply be reused by another allocation. Even if you zero a `Vec`'s memory"},{"DocComment":" first, that might not actually happen because the optimizer does not consider"},{"DocComment":" this a side-effect that must be preserved. There is one case which we will"},{"DocComment":" not break, however: using `unsafe` code to write to the excess capacity,"},{"DocComment":" and then increasing the length to match, is always valid."},{"DocComment":""},{"DocComment":" Currently, `Vec` does not guarantee the order in which elements are dropped."},{"DocComment":" The order has changed in the past and may change again."},{"DocComment":""},{"DocComment":" [`get`]: slice::get"},{"DocComment":" [`get_mut`]: slice::get_mut"},{"DocComment":" [`String`]: crate::string::String"},{"DocComment":" [`&str`]: type@str"},{"DocComment":" [`shrink_to_fit`]: Vec::shrink_to_fit"},{"DocComment":" [`shrink_to`]: Vec::shrink_to"},{"DocComment":" [capacity]: Vec::capacity"},{"DocComment":" [`capacity`]: Vec::capacity"},{"DocComment":" [`Vec::capacity`]: Vec::capacity"},{"DocComment":" [size_of::\\<T>]: size_of"},{"DocComment":" [len]: Vec::len"},{"DocComment":" [`len`]: Vec::len"},{"DocComment":" [`push`]: Vec::push"},{"DocComment":" [`insert`]: Vec::insert"},{"DocComment":" [`reserve`]: Vec::reserve"},{"DocComment":" [`Vec::with_capacity(n)`]: Vec::with_capacity"},{"DocComment":" [`MaybeUninit`]: core::mem::MaybeUninit"},{"DocComment":" [owned slice]: Box"},{"DocComment":" [`into_boxed_slice`]: Vec::into_boxed_slice"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Vec","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":33,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["collections",0]},{"Ident":["btree",0]},{"Ident":["set",0]},{"Ident":["Iter",0]}],"span":{"Untagged":{"data":{"file_id":37,"beg":{"line":135,"col":0},"end":{"line":135,"col":26}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator over the items of a `BTreeSet`."},{"DocComment":""},{"DocComment":" This `struct` is created by the [`iter`] method on [`BTreeSet`]."},{"DocComment":" See its documentation for more."},{"DocComment":""},{"DocComment":" [`iter`]: BTreeSet::iter"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":"'a","variance":"Covariant","mutability":"Shared","late_bound":false}],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":27}},{"Var":{"Free":0}}]},{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":27}},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":151},"guarantee":null},"align":{"chosen":{"Deduplicated":42},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":null},{"def_id":34,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["collections",0]},{"Ident":["btree",0]},{"Ident":["map",0]},{"Ident":["BTreeMap",0]}],"span":{"Untagged":{"data":{"file_id":49,"beg":{"line":189,"col":0},"end":{"line":193,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An ordered map based on a [B-Tree]."},{"DocComment":""},{"DocComment":" Given a key type with a [total order], an ordered map stores its entries in key order."},{"DocComment":" That means that keys must be of a type that implements the [`Ord`] trait,"},{"DocComment":" such that two keys can always be compared to determine their [`Ordering`]."},{"DocComment":" Examples of keys with a total order are strings with lexicographical order,"},{"DocComment":" and numbers with their natural order."},{"DocComment":""},{"DocComment":" Iterators obtained from functions such as [`BTreeMap::iter`], [`BTreeMap::into_iter`], [`BTreeMap::values`], or"},{"DocComment":" [`BTreeMap::keys`] produce their items in key order, and take worst-case logarithmic and"},{"DocComment":" amortized constant time per item returned."},{"DocComment":""},{"DocComment":" It is a logic error for a key to be modified in such a way that the key's ordering relative to"},{"DocComment":" any other key, as determined by the [`Ord`] trait, changes while it is in the map. This is"},{"DocComment":" normally only possible through [`Cell`], [`RefCell`], global state, I/O, or unsafe code."},{"DocComment":" The behavior resulting from such a logic error is not specified, but will be encapsulated to the"},{"DocComment":" `BTreeMap` that observed the logic error and not result in undefined behavior. This could"},{"DocComment":" include panics, incorrect results, aborts, memory leaks, and non-termination."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::BTreeMap;"},{"DocComment":""},{"DocComment":" // type inference lets us omit an explicit type signature (which"},{"DocComment":" // would be `BTreeMap<&str, &str>` in this example)."},{"DocComment":" let mut movie_reviews = BTreeMap::new();"},{"DocComment":""},{"DocComment":" // review some movies."},{"DocComment":" movie_reviews.insert(\"Office Space\",       \"Deals with real issues in the workplace.\");"},{"DocComment":" movie_reviews.insert(\"Pulp Fiction\",       \"Masterpiece.\");"},{"DocComment":" movie_reviews.insert(\"The Godfather\",      \"Very enjoyable.\");"},{"DocComment":" movie_reviews.insert(\"The Blues Brothers\", \"Eye lyked it a lot.\");"},{"DocComment":""},{"DocComment":" // check for a specific one."},{"DocComment":" if !movie_reviews.contains_key(\"Les Misérables\") {"},{"DocComment":"     println!(\"We've got {} reviews, but Les Misérables ain't one.\","},{"DocComment":"              movie_reviews.len());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // oops, this review has a lot of spelling mistakes, let's delete it."},{"DocComment":" movie_reviews.remove(\"The Blues Brothers\");"},{"DocComment":""},{"DocComment":" // look up the values associated with some keys."},{"DocComment":" let to_find = [\"Up!\", \"Office Space\"];"},{"DocComment":" for movie in &to_find {"},{"DocComment":"     match movie_reviews.get(movie) {"},{"DocComment":"        Some(review) => println!(\"{movie}: {review}\"),"},{"DocComment":"        None => println!(\"{movie} is unreviewed.\")"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Look up the value for a key (will panic if the key is not found)."},{"DocComment":" println!(\"Movie review: {}\", movie_reviews[\"Office Space\"]);"},{"DocComment":""},{"DocComment":" // iterate over everything."},{"DocComment":" for (movie, review) in &movie_reviews {"},{"DocComment":"     println!(\"{movie}: \\\"{review}\\\"\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A `BTreeMap` with a known list of items can be initialized from an array:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::BTreeMap;"},{"DocComment":""},{"DocComment":" let solar_distance = BTreeMap::from(["},{"DocComment":"     (\"Mercury\", 0.4),"},{"DocComment":"     (\"Venus\", 0.7),"},{"DocComment":"     (\"Earth\", 1.0),"},{"DocComment":"     (\"Mars\", 1.5),"},{"DocComment":" ]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## `Entry` API"},{"DocComment":""},{"DocComment":" `BTreeMap` implements an [`Entry API`], which allows for complex"},{"DocComment":" methods of getting, setting, updating and removing keys and their values:"},{"DocComment":""},{"DocComment":" [`Entry API`]: BTreeMap::entry"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::BTreeMap;"},{"DocComment":""},{"DocComment":" // type inference lets us omit an explicit type signature (which"},{"DocComment":" // would be `BTreeMap<&str, u8>` in this example)."},{"DocComment":" let mut player_stats = BTreeMap::new();"},{"DocComment":""},{"DocComment":" fn random_stat_buff() -> u8 {"},{"DocComment":"     // could actually return some random value here - let's just return"},{"DocComment":"     // some fixed value for now"},{"DocComment":"     42"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // insert a key only if it doesn't already exist"},{"DocComment":" player_stats.entry(\"health\").or_insert(100);"},{"DocComment":""},{"DocComment":" // insert a key using a function that provides a new value only if it"},{"DocComment":" // doesn't already exist"},{"DocComment":" player_stats.entry(\"defence\").or_insert_with(random_stat_buff);"},{"DocComment":""},{"DocComment":" // update a key, guarding against the key possibly not being set"},{"DocComment":" let stat = player_stats.entry(\"attack\").or_insert(100);"},{"DocComment":" *stat += random_stat_buff();"},{"DocComment":""},{"DocComment":" // modify an entry before an insert with in-place mutation"},{"DocComment":" player_stats.entry(\"mana\").and_modify(|mana| *mana += 200).or_insert(100);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Background"},{"DocComment":""},{"DocComment":" A B-tree is (like) a [binary search tree], but adapted to the natural granularity that modern"},{"DocComment":" machines like to consume data at. This means that each node contains an entire array of elements,"},{"DocComment":" instead of just a single element."},{"DocComment":""},{"DocComment":" B-Trees represent a fundamental compromise between cache-efficiency and actually minimizing"},{"DocComment":" the amount of work performed in a search. In theory, a binary search tree (BST) is the optimal"},{"DocComment":" choice for a sorted map, as a perfectly balanced BST performs the theoretical minimum number of"},{"DocComment":" comparisons necessary to find an element (log<sub>2</sub>n). However, in practice the way this"},{"DocComment":" is done is *very* inefficient for modern computer architectures. In particular, every element"},{"DocComment":" is stored in its own individually heap-allocated node. This means that every single insertion"},{"DocComment":" triggers a heap-allocation, and every comparison is a potential cache-miss due to the indirection."},{"DocComment":" Since both heap-allocations and cache-misses are notably expensive in practice, we are forced to,"},{"DocComment":" at the very least, reconsider the BST strategy."},{"DocComment":""},{"DocComment":" A B-Tree instead makes each node contain B-1 to 2B-1 elements in a contiguous array. By doing"},{"DocComment":" this, we reduce the number of allocations by a factor of B, and improve cache efficiency in"},{"DocComment":" searches. However, this does mean that searches will have to do *more* comparisons on average."},{"DocComment":" The precise number of comparisons depends on the node search strategy used. For optimal cache"},{"DocComment":" efficiency, one could search the nodes linearly. For optimal comparisons, one could search"},{"DocComment":" the node using binary search. As a compromise, one could also perform a linear search"},{"DocComment":" that initially only checks every i<sup>th</sup> element for some choice of i."},{"DocComment":""},{"DocComment":" Currently, our implementation simply performs naive linear search. This provides excellent"},{"DocComment":" performance on *small* nodes of elements which are cheap to compare. However in the future we"},{"DocComment":" would like to further explore choosing the optimal search strategy based on the choice of B,"},{"DocComment":" and possibly other factors. Using linear search, searching for a random element is expected"},{"DocComment":" to take B * log(n) comparisons, which is generally worse than a BST. In practice,"},{"DocComment":" however, performance is excellent."},{"DocComment":""},{"DocComment":" [B-Tree]: https://en.wikipedia.org/wiki/B-tree"},{"DocComment":" [binary search tree]: https://en.wikipedia.org/wiki/Binary_search_tree"},{"DocComment":" [total order]: https://en.wikipedia.org/wiki/Total_order"},{"DocComment":" [`Cell`]: core::cell::Cell"},{"DocComment":" [`RefCell`]: core::cell::RefCell"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"BTreeMap","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"K","variance":"Covariant"},{"index":1,"name":"V","variance":"Covariant"},{"index":2,"name":"A","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":35,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Ident":["into_iter",0]},{"Ident":["IntoIter",0]}],"span":{"Untagged":{"data":{"file_id":50,"beg":{"line":47,"col":0},"end":{"line":50,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator that moves out of a vector."},{"DocComment":""},{"DocComment":" This `struct` is created by the `into_iter` method on [`Vec`](super::Vec)"},{"DocComment":" (provided by the [`IntoIterator`] trait)."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = vec![0, 1, 2];"},{"DocComment":" let iter: std::vec::IntoIter<_> = v.into_iter();"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"},{"index":1,"name":"A","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":36,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["collections",0]},{"Ident":["btree",0]},{"Ident":["map",0]},{"Ident":["entry",0]},{"Ident":["Entry",0]}],"span":{"Untagged":{"data":{"file_id":51,"beg":{"line":19,"col":0},"end":{"line":24,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A view into a single entry in a map, which may either be vacant or occupied."},{"DocComment":""},{"DocComment":" This `enum` is constructed from the [`entry`] method on [`BTreeMap`]."},{"DocComment":""},{"DocComment":" [`entry`]: BTreeMap::entry"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"BTreeEntry","has_errors":false},"generics":{"regions":[{"index":0,"name":"'a","variance":"Covariant","mutability":"Mutable","late_bound":false}],"types":[{"index":0,"name":"K","variance":"Invariant"},{"index":1,"name":"V","variance":"Invariant"},{"index":2,"name":"A","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":27}},{"Var":{"Free":0}}]},{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":34}},{"Var":{"Free":0}}]},{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":27}},{"Var":{"Free":0}}]},{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":34}},{"Var":{"Free":0}}]},{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Value":[43,{"TypeVar":{"Free":2}}]}},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"src":"Normal","kind":{"Enum":[{"id":0,"span":{"Untagged":{"data":{"file_id":51,"beg":{"line":27,"col":4},"end":{"line":27,"col":10}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" A vacant entry."}],"inline":null,"rename":null,"public":true},"name":"Vacant","fields":[{"span":{"Untagged":{"data":{"file_id":51,"beg":{"line":27,"col":57},"end":{"line":27,"col":81}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"_0","is_positional":true,"ty":{"Value":[44,{"Adt":{"id":49,"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":27},{"Deduplicated":34},{"Deduplicated":43}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}}],"discriminant":{"Signed":["Isize","0"]}},{"id":1,"span":{"Untagged":{"data":{"file_id":51,"beg":{"line":31,"col":4},"end":{"line":31,"col":12}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" An occupied entry."}],"inline":null,"rename":null,"public":true},"name":"Occupied","fields":[{"span":{"Untagged":{"data":{"file_id":51,"beg":{"line":31,"col":59},"end":{"line":31,"col":85}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"_0","is_positional":true,"ty":{"Value":[45,{"Adt":{"id":50,"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":27},{"Deduplicated":34},{"Deduplicated":43}],"con