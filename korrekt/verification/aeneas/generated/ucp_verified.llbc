{"Ident":["vec",0]},{"Impl":{"Trait":43}}],"span":{"Untagged":{"data":{"file_id":48,"beg":{"line":4036,"col":0},"end":{"line":4036,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Collects an iterator into a Vec, commonly called via [`Iterator::collect()`]"},{"DocComment":""},{"DocComment":" # Allocation behavior"},{"DocComment":""},{"DocComment":" In general `Vec` does not guarantee any particular growth or allocation strategy."},{"DocComment":" That also applies to this trait impl."},{"DocComment":""},{"DocComment":" **Note:** This section covers implementation details and is therefore exempt from"},{"DocComment":" stability guarantees."},{"DocComment":""},{"DocComment":" Vec may use any or none of the following strategies,"},{"DocComment":" depending on the supplied iterator:"},{"DocComment":""},{"DocComment":" * preallocate based on [`Iterator::size_hint()`]"},{"DocComment":"   * and panic if the number of items is outside the provided lower/upper bounds"},{"DocComment":" * use an amortized growth strategy similar to `pushing` one item at a time"},{"DocComment":" * perform the iteration in-place on the original allocation backing the iterator"},{"DocComment":""},{"DocComment":" The last case warrants some attention. It is an optimization that in many cases reduces peak memory"},{"DocComment":" consumption and improves cache locality. But when big, short-lived allocations are created,"},{"DocComment":" only a small fraction of their items get collected, no further use is made of the spare capacity"},{"DocComment":" and the resulting `Vec` is moved into a longer-lived structure, then this can lead to the large"},{"DocComment":" allocations having their lifetimes unnecessarily extended which can result in increased memory"},{"DocComment":" footprint."},{"DocComment":""},{"DocComment":" In cases where this is an issue, the excess capacity can be discarded with [`Vec::shrink_to()`],"},{"DocComment":" [`Vec::shrink_to_fit()`] or by collecting into [`Box<[T]>`][owned slice] instead, which additionally reduces"},{"DocComment":" the size of the long-lived struct."},{"DocComment":""},{"DocComment":" [owned slice]: Box"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" # use std::sync::Mutex;"},{"DocComment":" static LONG_LIVED: Mutex<Vec<Vec<u16>>> = Mutex::new(Vec::new());"},{"DocComment":""},{"DocComment":" for i in 0..10 {"},{"DocComment":"     let big_temporary: Vec<u16> = (0..1024).collect();"},{"DocComment":"     // discard most items"},{"DocComment":"     let mut result: Vec<_> = big_temporary.into_iter().filter(|i| i % 100 == 0).collect();"},{"DocComment":"     // without this a lot of unused capacity might be moved into the global"},{"DocComment":"     result.shrink_to_fit();"},{"DocComment":"     LONG_LIVED.lock().unwrap().push(result);"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":false},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":20,"generics":{"regions":[],"types":[{"Deduplicated":488},{"Deduplicated":27}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_trait_refs":[],"consts":[],"types":[],"methods":[{"params":{"regions":[],"types":[{"index":0,"name":"I","variance":"Invariant"},{"index":1,"name":"Clause0_IntoIter","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":1335},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":23,"generics":{"regions":[],"types":[{"Deduplicated":5},{"Deduplicated":27},{"Deduplicated":6}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"id":246,"g