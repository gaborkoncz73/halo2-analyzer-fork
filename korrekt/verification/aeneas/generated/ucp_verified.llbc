":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"add_assign","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["arith",0]},{"Ident":["AddAssign",0]},{"Ident":["add_assign",0]}],"span":{"Untagged":{"data":{"file_id":58,"beg":{"line":779,"col":4},"end":{"line":779,"col":39}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the `+=` operation."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut x: u32 = 12;"},{"DocComment":" x += 1;"},{"DocComment":" assert_eq!(x, 13);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":677},{"Deduplicated":34}],"output":{"Deduplicated":105}},"default":null},"kind":{"TraitMethod":[25,0]}}],"vtable":{"id":46,"generics":{"regions":[],"types":[{"Deduplicated":34}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":26,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["arith",0]},{"Ident":["Div",0]}],"span":{"Untagged":{"data":{"file_id":58,"beg":{"line":460,"col":0},"end":{"line":460,"col":31}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The division operator `/`."},{"DocComment":""},{"DocComment":" Note that `Rhs` is `Self` by default, but this is not mandatory."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ## `Div`idable rational numbers"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::Div;"},{"DocComment":""},{"DocComment":" // By the fundamental theorem of arithmetic, rational numbers in lowest"},{"DocComment":" // terms are unique. So, by keeping `Rational`s in reduced form, we can"},{"DocComment":" // derive `Eq` and `PartialEq`."},{"DocComment":" #[derive(Debug, Eq, PartialEq)]"},{"DocComment":" struct Rational {"},{"DocComment":"     numerator: usize,"},{"DocComment":"     denominator: usize,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Rational {"},{"DocComment":"     fn new(numerator: usize, denominator: usize) -> Self {"},{"DocComment":"         if denominator == 0 {"},{"DocComment":"             panic!(\"Zero is an invalid denominator!\");"},{"DocComment":"         }"},{"DocComment":""},{"DocComment":"         // Reduce to lowest terms by dividing by the greatest common"},{"DocComment":"         // divisor."},{"DocComment":"         let gcd = gcd(numerator, denominator);"},{"DocComment":"         Self {"},{"DocComment":"             numerator: numerator / gcd,"},{"DocComment":"             denominator: denominator / gcd,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Div for Rational {"},{"DocComment":"     // The division of rational numbers is a closed operation."},{"DocComment":"     type Output = Self;"},{"DocComment":""},{"DocComment":"     fn div(self, rhs: Self) -> Self::Output {"},{"DocComment":"         if rhs.numerator == 0 {"},{"DocComment":"             panic!(\"Cannot divide by zero-valued `Rational`!\");"},{"DocComment":"         }"},{"DocComment":""},{"DocComment":"         let numerator = self.numerator * rhs.denominator;"},{"DocComment":"         let denominator = self.denominator * rhs.numerator;"},{"DocComment":"         Self::new(numerator, denominator)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Euclid's two-thousand-year-old algorithm for finding the greatest common"},{"DocComment":" // divisor."},{"DocComment":" fn gcd(x: usize, y: usize) -> usize {"},{"DocComment":"     let mut x = x;"},{"DocComment":"     let mut y = y;"},{"DocComment":"     while y != 0 {"},{"DocComment":"         let t = y;"},{"DocComment":"         y = x % y;"},{"DocComment":"         x = t;"},{"DocComment":"     }"},{"DocComment":"     x"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(Rational::new(1, 2), Rational::new(2, 4));"},{"DocComment":" assert_eq!(Rational::new(1, 2) / Rational::new(3, 4),"},{"DocComment":"            Rational::new(2, 3));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Dividing vectors by scalars as in linear algebra"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::Div;"},{"DocComment":""},{"DocComment":" struct Scalar { value: f32 }"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" struct Vector { value: Vec<f32> }"},{"DocComment":""},{"DocComment":" impl Div<Scalar> for Vector {"},{"DocComment":"     type Output = Self;"},{"DocComment":""},{"DocComment":"     fn div(self, rhs: Scalar) -> Self::Output {"},{"DocComment":"         Self { value: self.value.iter().map(|v| v / rhs.value).collect() }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let scalar = Scalar { value: 2f32 };"},{"DocComment":" let vector = Vector { value: vec![2f32, 4f32, 6f32] };"},{"DocComment":" assert_eq!(vector / scalar, Vector { value: vec![1f32, 2f32, 3f32] });"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Div","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Rhs","variance":"Unknown"},{"index":2,"name":"Self_Output","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"o